@model Doalim_dev.ViewModels.MinhasReservasPageViewModel

@{
    ViewData["Title"] = "Minhas Reservas";
    var filtros = Model.Filtros;

    var totalPendente   = Model.Reservas.Count(r => r.StatusReserva == "Pendente");
    var totalConfirmada = Model.Reservas.Count(r => r.StatusReserva == "Confirmada");
    var totalRetirada   = Model.Reservas.Count(r => r.StatusReserva == "Retirada");
    var totalCancelada  = Model.Reservas.Count(r => r.StatusReserva == "Cancelada");
    var totalRejeitada  = Model.Reservas.Count(r => r.StatusReserva == "Rejeitada");

    // Agrupamento por (IdPedido, IdUsuarioDoador) — mesma lógica do doador
    var grupos = Model.Reservas
        .GroupBy(r => new { r.IdPedido, r.IdUsuarioDoador })
        .ToList();
}

<style>
    .reserva-group-card {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e0e0e0;
        transition: box-shadow .2s, transform .2s;
    }
    .reserva-group-card:hover {
        box-shadow: 0 6px 20px rgba(0,0,0,.10) !important;
        transform: translateY(-2px);
    }
    .reserva-group-card .status-strip {
        height: 4px;
        width: 100%;
    }
    .stat-card {
        border-radius: 10px;
        padding: 12px 16px;
        text-align: center;
        border: 1px solid transparent;
    }
    .stat-card .stat-number { font-size: 1.6rem; font-weight: 700; line-height: 1.1; }
    .stat-card .stat-label  { font-size: .75rem; color: #666; margin-top: 2px; }

    /* Estrelas de avaliação */
    .btn-star {
        cursor: pointer;
        line-height: 1;
        transition: transform .1s;
    }
    .btn-star:hover { transform: scale(1.2); }

    .produto-row {
        border-bottom: 1px solid #f0f0f0;
    }
    .produto-row:last-child {
        border-bottom: none;
    }
    .produto-row.item-cancelado {
        opacity: .65;
        background: #fafafa;
    }
    /* Divisor vertical no rodapé de contato */
    @@media (min-width: 768px) {
        .footer-contato-divider {
            border-left: 1px solid #c3e6cb;
            padding-left: 1rem;
        }
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1 fw-bold">Minhas Reservas</h2>
        <p class="text-muted mb-0">Alimentos reservados por você aparecem aqui.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Carrinho" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-cart me-1"></i> Meu carrinho
        </a>
        <a asp-controller="Produtos" asp-action="Vitrine" class="btn btn-outline-success">
            <i class="bi bi-shop me-1"></i> Ver vitrine
        </a>
    </div>
</div>

@* Totalizadores *@
@if (Model.Reservas.Any())
{
    <div class="row g-2 mb-4">
        <div class="col">
            <div class="stat-card bg-warning bg-opacity-10 border-warning">
                <div class="stat-number text-warning">@totalPendente</div>
                <div class="stat-label">Pendente</div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card bg-success bg-opacity-10 border-success">
                <div class="stat-number text-success">@totalConfirmada</div>
                <div class="stat-label">Confirmada</div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card bg-primary bg-opacity-10 border-primary">
                <div class="stat-number text-primary">@totalRetirada</div>
                <div class="stat-label">Retirada</div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card bg-danger bg-opacity-10 border-danger">
                <div class="stat-number text-danger">@totalRejeitada</div>
                <div class="stat-label">Rejeitada</div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card bg-secondary bg-opacity-10" style="border:1px solid #ccc;">
                <div class="stat-number text-secondary">@totalCancelada</div>
                <div class="stat-label">Cancelada</div>
            </div>
        </div>
    </div>
}

@* Filtros *@
<form method="get" asp-controller="Reservas" asp-action="MinhasReservas"
      class="card p-3 mb-4 shadow-sm" style="border-radius:12px; background:#f9fbf9; border:1px solid #e8f5e9;">
    <div class="row g-2">

        @* Linha 1: Status | Categoria | Nome produto | Nome doador *@
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value=""           selected="@(string.IsNullOrEmpty(filtros.Status))">Todos</option>
                <option value="Pendente"   selected="@(filtros.Status == "Pendente")">Pendente</option>
                <option value="Confirmada" selected="@(filtros.Status == "Confirmada")">Confirmada</option>
                <option value="Retirada"   selected="@(filtros.Status == "Retirada")">Retirada</option>
                <option value="Cancelada"  selected="@(filtros.Status == "Cancelada")">Cancelada</option>
                <option value="Rejeitada"  selected="@(filtros.Status == "Rejeitada")">Rejeitada</option>
            </select>
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Categoria</label>
            <select name="Categoria" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(filtros.Categoria))">Todas</option>
                @foreach (var cat in ViewBag.CategoriasDisponiveis as List<string> ?? new List<string>())
                {
                    <option value="@cat" selected="@(filtros.Categoria == cat)">@cat</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-4">
            <label class="form-label fw-semibold small mb-1">Nome do produto</label>
            <input type="text" name="NomeProduto" value="@filtros.NomeProduto"
                   class="form-control form-control-sm" placeholder="Ex: Arroz, Feijão..." />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Nome do doador</label>
            <input type="text" name="NomeDoador" value="@filtros.NomeDoador"
                   class="form-control form-control-sm" placeholder="Ex: Maria" />
        </div>

        @* Linha 2: Validade de | Validade até | Data reserva de | Data reserva até *@
        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Validade de</label>
            <input type="date" name="ValidadeInicio"
                   value="@filtros.ValidadeInicio?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Validade até</label>
            <input type="date" name="ValidadeFim"
                   value="@filtros.ValidadeFim?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Reservado de</label>
            <input type="date" name="DataReservaInicio"
                   value="@filtros.DataReservaInicio?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Reservado até</label>
            <input type="date" name="DataReservaFim"
                   value="@filtros.DataReservaFim?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-12 d-flex justify-content-end gap-2 pt-1 border-top">
            <a asp-controller="Reservas" asp-action="MinhasReservas"
               class="btn btn-outline-secondary btn-sm px-4">Limpar</a>
            <button type="submit" class="btn btn-success btn-sm px-4">
                <i class="bi bi-search me-1"></i> Filtrar
            </button>
        </div>

    </div>
</form>

@if (filtros.TemFiltroAtivo && !Model.Reservas.Any())
{
    <div class="alert alert-info rounded-3">
        <i class="bi bi-info-circle me-2"></i>Nenhuma reserva encontrada para os filtros aplicados.
    </div>
}
else if (!Model.Reservas.Any())
{
    <div class="alert alert-info rounded-3">
        <i class="bi bi-info-circle me-2"></i>Você ainda não possui reservas.
    </div>
}
else
{
    @if (filtros.TemFiltroAtivo)
    {
        <p class="text-muted small mb-3">
            <i class="bi bi-funnel me-1"></i>
            Exibindo <strong>@Model.Reservas.Count</strong> reserva(s) com filtros ativos.
            <a asp-controller="Reservas" asp-action="MinhasReservas" class="ms-1">Limpar filtros</a>
        </p>
    }

    @* Cards agrupados por (pedido, doador) *@
    <div class="row g-3">
        @foreach (var grupo in grupos)
        {
            var rep   = grupo.First();
            var itens = grupo.ToList();

            // Status misto: detecta quando itens do mesmo pedido têm status diferentes
            // (ex.: um produto cancelado individualmente)
            var todosStatus = itens.Select(i => i.StatusReserva).Distinct().ToList();
            var statusMisto = todosStatus.Count > 1;

            // Status representativo do grupo (mais ativo quando misto)
            var grpStatus = statusMisto
                ? (todosStatus.Contains("Confirmada") ? "Confirmada" :
                   todosStatus.Contains("Pendente")   ? "Pendente"   :
                   todosStatus.Contains("Retirada")   ? "Retirada"   :
                   todosStatus.Contains("Rejeitada")  ? "Rejeitada"  : "Cancelada")
                : rep.StatusReserva;

            var corStrip   = grpStatus == "Pendente"   ? "#ffc107" :
                             grpStatus == "Confirmada" ? "#198754" :
                             grpStatus == "Retirada"   ? "#0d6efd" :
                             grpStatus == "Rejeitada"  ? "#dc3545" : "#6c757d";

            var badgeClass = grpStatus == "Pendente"   ? "bg-warning text-dark" :
                             grpStatus == "Confirmada" ? "bg-success" :
                             grpStatus == "Retirada"   ? "bg-primary" :
                             grpStatus == "Rejeitada"  ? "bg-danger" : "bg-secondary";

            var iconeStatus = grpStatus == "Pendente"   ? "bi-hourglass-split" :
                              grpStatus == "Confirmada" ? "bi-check-circle-fill" :
                              grpStatus == "Retirada"   ? "bi-bag-check-fill" :
                              grpStatus == "Rejeitada"  ? "bi-x-circle-fill" : "bi-dash-circle";

            <div class="col-12 col-md-6">
            <div class="card reserva-group-card shadow-sm h-100">

                <div class="status-strip" style="background:@corStrip;"></div>

                @* Cabeçalho do grupo *@
                <div class="card-header d-flex justify-content-between align-items-center py-2 px-3"
                     style="background:#fafafa;">
                    <div>
                        <a asp-controller="Usuarios" asp-action="PerfilPublico"
                           asp-route-id="@rep.IdUsuarioDoador"
                           class="fw-bold text-dark text-decoration-none">
                            <i class="bi bi-person-circle me-1 text-success"></i>@rep.NomeDoador
                            <i class="bi bi-box-arrow-up-right ms-1" style="font-size:.7rem; opacity:.5;"></i>
                        </a>
                        <div class="text-muted" style="font-size:.77rem;">
                            Pedido #@rep.IdPedido &bull; Reservado em @rep.DataReserva.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-1">
                        <span class="badge @badgeClass d-flex align-items-center gap-1 py-2 px-3">
                            <i class="bi @iconeStatus"></i> @grpStatus
                        </span>
                        @if (statusMisto)
                        {
                            <span class="badge bg-light text-muted border" style="font-size:.7rem;">
                                <i class="bi bi-info-circle me-1"></i>Itens com status variado
                            </span>
                        }
                    </div>
                </div>

                @* Lista de produtos do grupo *@
                <div class="list-group list-group-flush">
                    @foreach (var item in itens)
                    {
                        var isCancelado = item.StatusReserva == "Cancelada";

                        <div class="list-group-item px-3 py-2 produto-row @(statusMisto && isCancelado ? "item-cancelado" : "")">
                            <div class="row g-2 align-items-center">

                                @* Col 1: Foto (fixo) *@
                                <div class="col-auto">
                                    @if (!string.IsNullOrEmpty(item.FotoProduto))
                                    {
                                        <img src="@item.FotoProduto" alt="@item.NomeProduto"
                                             class="rounded"
                                             style="width:48px;height:48px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                             style="width:48px;height:48px;font-size:1.3rem;">&#127857;</div>
                                    }
                                </div>

                                @* Col 2: Nome / marca / categoria + badge de status misto *@
                                <div class="col-md-4">
                                    <div class="fw-semibold d-flex align-items-center gap-2" style="font-size:.9rem; color:#1a2e1a;">
                                        @item.NomeProduto
                                        @if (statusMisto)
                                        {
                                            var iBadge = item.StatusReserva == "Pendente"   ? "bg-warning text-dark" :
                                                         item.StatusReserva == "Confirmada" ? "bg-success" :
                                                         item.StatusReserva == "Retirada"   ? "bg-primary" :
                                                         item.StatusReserva == "Rejeitada"  ? "bg-danger" : "bg-secondary";
                                            <span class="badge @iBadge" style="font-size:.68rem;">@item.StatusReserva</span>
                                        }
                                    </div>
                                    <div class="text-muted small">
                                        @item.MarcaProduto &bull; @item.CategoriaProduto
                                    </div>
                                </div>

                                @* Col 3: Quantidade / Lote / Validade / Reserva# *@
                                <div class="col-md-4">
                                    <div class="d-flex flex-wrap gap-3" style="font-size:.82rem; color:#555;">
                                        <span>
                                            <i class="bi bi-box me-1 text-secondary"></i>
                                            @item.QuantidadeReservada @item.UnidadeMedidaProduto
                                        </span>
                                        <span>Lote @item.NumeroLote</span>
                                        <span>Val. @item.DataValidadeLote.ToString("dd/MM/yyyy")</span>
                                        <span class="text-secondary fw-semibold">Reserva #@item.IdReserva</span>
                                    </div>
                                </div>

                                @* Col 4: Ações — cancelar / avaliar *@
                                <div class="col-md-auto ms-md-auto d-flex flex-column align-items-end gap-2">

                                    @* Botão cancelar por produto (apenas Pendente) *@
                                    @if (item.PodeSerCancelada)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm rounded-pill"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCancelar"
                                                data-reserva-id="@item.IdReserva"
                                                data-produto-nome="@item.NomeProduto"
                                                title="Cancelar este produto">
                                            <i class="bi bi-x-circle me-1"></i>Cancelar
                                        </button>
                                    }

                                    @* Estrelas de avaliação — visível apenas Retiradas não avaliadas *@
                                    @if (item.PodeAvaliar && !item.JaAvaliou)
                                    {
                                        <div id="avaliacao-bloco-@item.IdReserva">
                                            <form method="post" asp-controller="Usuarios" asp-action="AvaliarUsuario"
                                                  class="avaliacao-form d-flex align-items-center gap-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idReserva" value="@item.IdReserva" />
                                                <div class="star-group d-flex gap-1">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <button type="button"
                                                                class="btn-star p-0 border-0 bg-transparent text-secondary"
                                                                data-nota="@i" title="@i estrela(s)">
                                                            <i class="bi bi-star" style="font-size:1.1rem;"></i>
                                                        </button>
                                                    }
                                                </div>
                                                <input type="hidden" name="nota" class="nota-input" value="0" />
                                                <button type="button"
                                                        class="btn btn-warning btn-sm rounded-pill px-2 py-1 submit-btn"
                                                        disabled title="Selecione uma nota"
                                                        data-bs-toggle="modal" data-bs-target="#modalConfirmarAvaliacao">
                                                    <i class="bi bi-check2"></i>
                                                </button>
                                            </form>
                                            <button type="button"
                                                    class="btn btn-link btn-sm text-muted p-0 btn-pular-avaliacao"
                                                    style="font-size:.72rem;"
                                                    data-reserva="@item.IdReserva"
                                                    data-alvo="avaliacao-bloco-@item.IdReserva">
                                                <i class="bi bi-x me-1"></i>Pular avaliação
                                            </button>
                                        </div>
                                    }
                                    else if (item.PodeAvaliar && item.JaAvaliou)
                                    {
                                        <div class="text-center" style="min-width:80px;">
                                            <div class="d-flex gap-1 justify-content-end">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= item.NotaAvaliacao ? "bi-star-fill text-warning" : "bi-star text-secondary")"
                                                       style="font-size:.85rem;"></i>
                                                }
                                            </div>
                                            <div class="text-muted" style="font-size:.68rem;">Avaliado</div>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Motivo de rejeição — por produto, se rejeitada *@
                            @if (grpStatus == "Rejeitada" && !string.IsNullOrEmpty(item.MotivoRejeicao))
                            {
                                <div class="alert alert-danger py-1 px-2 mt-2 mb-0 rounded-3" style="font-size:.82rem;">
                                    <i class="bi bi-x-circle me-1"></i><strong>Motivo:</strong> @item.MotivoRejeicao
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Rodapé — token, retirada, contato (quando Confirmada) *@
                @if (grpStatus == "Confirmada")
                {
                    <div class="card-footer px-3 py-3"
                         style="background:#f0faf0; border-top:1px solid #c3e6cb;">
                        <div class="row g-3 align-items-start">

                            @* Coluna esquerda: token + período de retirada *@
                            <div class="col-md-6">
                                @if (rep.ExibirToken)
                                {
                                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                        <span class="text-muted small fw-semibold">Token:</span>
                                        <span class="fw-bold font-monospace fs-5" id="token-grp-@rep.IdPedido">@rep.TokenConfirmacao</span>
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm py-0"
                                                onclick="copiarToken('@rep.TokenConfirmacao', this)"
                                                title="Copiar token">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                        <span class="text-muted small">— apresente ao doador</span>
                                    </div>
                                }

                                @if (rep.DataRetiradaInicio.HasValue && rep.DataRetiradaFim.HasValue)
                                {
                                    <div class="alert @(rep.RetiradaProxima ? "alert-warning" : "alert-success") py-2 px-3 mb-0 rounded-3"
                                         style="font-size:.85rem;">
                                        <i class="bi bi-calendar-check me-1"></i>
                                        <strong>Retirada:</strong>
                                        @rep.DataRetiradaInicio.Value.ToString("dd/MM/yyyy") até @rep.DataRetiradaFim.Value.ToString("dd/MM/yyyy")
                                        @if (rep.RetiradaProxima)
                                        {
                                            <span class="ms-2 fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Retirada próxima!</span>
                                        }
                                    </div>
                                }
                            </div>

                            @* Coluna direita: telefone + endereço *@
                            @if (!string.IsNullOrEmpty(rep.TelefoneDoador) || !string.IsNullOrEmpty(rep.EnderecoDoador))
                            {
                                <div class="col-md-6 footer-contato-divider">
                                    @if (!string.IsNullOrEmpty(rep.TelefoneDoador))
                                    {
                                        <div class="d-flex align-items-center gap-2 mb-2" style="font-size:.85rem;">
                                            <i class="bi bi-telephone-fill text-success flex-shrink-0"></i>
                                            <span>@rep.TelefoneDoador</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(rep.EnderecoDoador))
                                    {
                                        <div class="d-flex align-items-start gap-2" style="font-size:.85rem;">
                                            <i class="bi bi-geo-alt-fill text-success mt-1 flex-shrink-0"></i>
                                            <span>@rep.EnderecoDoador</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>
            </div>
        }
    </div>
}

@* Modal de cancelamento — único, populado via JS *@
<div class="modal fade" id="modalCancelar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body text-center p-4">
                <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center
                            justify-content-center mb-3" style="width:56px;height:56px;">
                    <i class="bi bi-x-circle-fill text-danger" style="font-size:1.6rem;"></i>
                </div>
                <h6 class="fw-bold mb-1">Cancelar reserva?</h6>
                <p class="text-muted small mb-1">
                    Você está cancelando a reserva de <strong id="txtProdutoCancelar"></strong>.
                </p>
                <p class="text-muted small mb-4">
                    O produto será devolvido à vitrine para outros beneficiários.
                </p>
                <form id="formCancelar" asp-controller="Reservas" asp-action="Cancelar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="inputReservaIdCancelar" name="idReserva" value="0" />
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4"
                                data-bs-dismiss="modal">Voltar</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                            <i class="bi bi-x-circle me-1"></i> Confirmar cancelamento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* Modal de confirmação de avaliação *@
<div class="modal fade" id="modalConfirmarAvaliacao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body text-center p-4">
                <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center
                            justify-content-center mb-3" style="width:56px;height:56px;">
                    <i class="bi bi-star-fill text-warning" style="font-size:1.6rem;"></i>
                </div>
                <h6 class="fw-bold mb-1">Confirmar avaliação?</h6>
                <p class="text-muted small mb-4">
                    Você selecionou <strong id="textoNotaModal"></strong> estrela(s).<br>
                    <span class="text-danger fw-semibold">Esta avaliação não poderá ser alterada.</span>
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4"
                            data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-warning rounded-pill px-4 fw-semibold"
                            id="btnConfirmarAvaliacao">
                        <i class="bi bi-check2-circle me-1"></i> Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Copiar token ──────────────────────────────────────────────────
    function copiarToken(token, btn) {
        navigator.clipboard.writeText(token).then(function () {
            var icon = btn.querySelector('i');
            icon.classList.replace('bi-clipboard', 'bi-clipboard-check');
            setTimeout(function () { icon.classList.replace('bi-clipboard-check', 'bi-clipboard'); }, 2000);
        });
    }

    // ── Modal de cancelamento — popula dados pelo data-* ──────────────
    var modalCancelarEl = document.getElementById('modalCancelar');
    if (modalCancelarEl) {
        modalCancelarEl.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            var reservaId   = btn.getAttribute('data-reserva-id');
            var produtoNome = btn.getAttribute('data-produto-nome');
            document.getElementById('inputReservaIdCancelar').value = reservaId;
            document.getElementById('txtProdutoCancelar').textContent = produtoNome;
        });
    }

    // ── Pular avaliação ───────────────────────────────────────────────
    var SKIP_PREFIX = 'doalim_skip_aval_benef_';

    document.querySelectorAll('.btn-pular-avaliacao').forEach(function (btn) {
        var idReserva = btn.dataset.reserva;
        if (localStorage.getItem(SKIP_PREFIX + idReserva) === '1') {
            var bloco = document.getElementById(btn.dataset.alvo);
            if (bloco) bloco.style.display = 'none';
        }
    });

    document.querySelectorAll('.btn-pular-avaliacao').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var idReserva = btn.dataset.reserva;
            localStorage.setItem(SKIP_PREFIX + idReserva, '1');
            var bloco = document.getElementById(btn.dataset.alvo);
            if (bloco) bloco.style.display = 'none';
        });
    });

    // ── Interatividade das estrelas ───────────────────────────────────
    var formAvaliacaoPendente = null;

    document.querySelectorAll('.star-group').forEach(function (group) {
        var form      = group.closest('form');
        var notaInput = form.querySelector('.nota-input');
        var submitBtn = form.querySelector('.submit-btn');
        var stars     = Array.from(group.querySelectorAll('.btn-star'));

        function pintarEstrelas(ate) {
            stars.forEach(function (s, i) {
                var icon = s.querySelector('i');
                if (i < ate) {
                    icon.className = 'bi bi-star-fill';
                    s.classList.add('text-warning');
                    s.classList.remove('text-secondary');
                } else {
                    icon.className = 'bi bi-star';
                    s.classList.remove('text-warning');
                    s.classList.add('text-secondary');
                }
            });
        }

        stars.forEach(function (star) {
            star.addEventListener('mouseenter', function () { pintarEstrelas(parseInt(star.dataset.nota)); });
            star.addEventListener('mouseleave', function () { pintarEstrelas(parseInt(notaInput.value) || 0); });
            star.addEventListener('click', function () {
                var nota = parseInt(star.dataset.nota);
                notaInput.value = nota;
                submitBtn.disabled = false;
                pintarEstrelas(nota);
            });
        });

        submitBtn.addEventListener('click', function () {
            formAvaliacaoPendente = form;
            document.getElementById('textoNotaModal').textContent = notaInput.value;
        });
    });

    var btnConfirmar = document.getElementById('btnConfirmarAvaliacao');
    if (btnConfirmar) {
        btnConfirmar.addEventListener('click', function () {
            var modal = bootstrap.Modal.getInstance(document.getElementById('modalConfirmarAvaliacao'));
            if (modal) modal.hide();
            if (formAvaliacaoPendente) formAvaliacaoPendente.submit();
        });
    }
</script>
}
