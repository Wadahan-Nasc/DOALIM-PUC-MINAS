<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Doalim_dev</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Doalim_dev.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2"
                       asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Doalim" height="60" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Doacoes" asp-action="Vitrine">Vitrine</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuários</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                           asp-controller="Produtos" asp-action="MinhasReservas"
                                           title="Minhas Reservas">
                                        <i class="bi bi-cart-check" style="font-size: 1.4rem;"></i>
                                    </a>
                                </li>
                            }
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link text-dark">Olá, <strong>@User.Identity.Name</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                       asp-controller="Usuarios" asp-action="MeuPerfil"
                                       title="Meu Perfil">
                                    <i class="bi bi-person-circle" style="font-size: 1.4rem;"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                       asp-controller="Auth" asp-action="Logout"
                                       title="Sair">
                                    <i class="bi bi-box-arrow-right" style="font-size: 1.4rem;"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["Erro"]
                </div>
            }

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["Sucesso"]
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Doalim_dev - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
