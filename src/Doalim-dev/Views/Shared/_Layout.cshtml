@using Microsoft.EntityFrameworkCore
@inject Doalim_dev.Models.AppDbContext _context

@{
    var usuarioIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    byte[]? fotoPerfil = null;

    if (User.Identity?.IsAuthenticated == true && int.TryParse(usuarioIdClaim, out var usuarioIdLayout))
    {
        fotoPerfil = await _context.Usuarios
            .AsNoTracking()
            .Where(u => u.IdUsuario == usuarioIdLayout)
            .Select(u => u.FotoPerfil)
            .FirstOrDefaultAsync();
    }
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Doalim</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Doalim_dev.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Doalim" height="60" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Produtos" asp-action="Vitrine">Vitrine</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuários</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Lookup" asp-action="Index">Domínios</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("DoadorPF") || User.IsInRole("DoadorPJ"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Produtos" asp-action="Index" title="Meus Produtos">
                                        <i class="bi bi-box-seam" style="font-size: 1.4rem;"></i>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Produtos" asp-action="GerenciarReservas" title="Gerenciar Reservas">
                                        <i class="bi bi-clipboard-check" style="font-size: 1.4rem;"></i>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Produtos" asp-action="HistoricoDoacoes" title="Histórico de Doações">
                                        <i class="bi bi-clock-history" style="font-size: 1.4rem;"></i>
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Carrinho" asp-action="Index" title="Meu Carrinho">
                                        <i class="bi bi-cart" style="font-size: 1.4rem;"></i>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Reservas" asp-action="MinhasReservas" title="Minhas Reservas">
                                        <i class="bi bi-list-check" style="font-size: 1.4rem;"></i>
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="PerfilPublico" asp-route-id="@usuarioIdClaim" title="Meu Perfil Público">
                                    <i class="bi bi-person-badge" style="font-size: 1.4rem;"></i>
                                </a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link text-dark">Olá, <strong>@User.Identity.Name</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="MeuPerfil" title="Meu Perfil">
                                    @if (fotoPerfil != null && fotoPerfil.Length > 0)
                                    {
                                        var base64 = Convert.ToBase64String(fotoPerfil);
                                        <img src="data:image/jpeg;base64,@base64"
                                             alt="Foto de perfil"
                                             class="rounded-circle"
                                             style="width: 30px; height: 30px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle" style="font-size: 1.4rem;"></i>
                                    }
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Logout" title="Sair">
                                    <i class="bi bi-box-arrow-right" style="font-size: 1.4rem;"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid app-main-container">
        <main role="main" class="pb-3">
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" id="alert-feedback">
                    <i class="bi bi-x-circle me-2"></i>@TempData["Erro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert" id="alert-feedback">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Doalim - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            var alertas = document.querySelectorAll('#alert-feedback');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    var bsAlert = bootstrap.Alert.getOrCreateInstance(alerta);
                    bsAlert.close();
                }, 3000);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>