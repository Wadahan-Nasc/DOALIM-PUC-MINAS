@using Microsoft.EntityFrameworkCore
@inject Doalim_dev.Models.AppDbContext _context
@{
    var emailLogado = User.Identity?.IsAuthenticated == true
        ? (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name)
        : null;

    var fotoPerfil = emailLogado != null
        ? await _context.Usuarios
            .Where(u => u.Email == emailLogado)
            .Select(u => u.FotoPerfil)
            .FirstOrDefaultAsync()
        : null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Doalim</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Doalim_dev.styles.css" asp-append-version="true" />
    <style>
        .navbar-doalim {
            border-bottom: 2px solid #e8f5e9;
            box-shadow: 0 1px 6px rgba(0,0,0,.06);
        }
        .navbar-doalim .nav-link {
            font-weight: 500;
            font-size: 1.05rem;
            color: #333 !important;
            border-radius: 6px;
            padding: 8px 13px !important;
            transition: background .15s, color .15s;
        }
        .navbar-doalim .nav-link:hover,
        .navbar-doalim .nav-link:focus {
            background: #f1f8f1;
            color: #2E7D32 !important;
        }
        .navbar-doalim .nav-link.active {
            color: #2E7D32 !important;
            background: #e8f5e9;
        }
        .navbar-doalim .dropdown-menu {
            border: none;
            box-shadow: 0 4px 16px rgba(0,0,0,.1);
            border-radius: 10px;
            min-width: 200px;
            padding: 6px;
        }
        .navbar-doalim .dropdown-item {
            border-radius: 6px;
            padding: 11px 18px;
            font-size: 1rem;
        }
        .navbar-doalim .dropdown-item:hover {
            background: #f1f8f1;
        }
        .navbar-doalim .dropdown-divider { margin: 4px 6px; }
        .navbar-user-btn {
            border: 1px solid #dee2e6;
            border-radius: 50px !important;
            padding: 4px 12px 4px 6px !important;
            gap: 8px;
        }
        .navbar-user-btn:hover {
            background: #f1f8f1 !important;
            border-color: #a5d6a7 !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white navbar-doalim mb-3">
            <div class="container-fluid px-3">

                @* Logo (clicavel, sem link "Home" separado) *@
                <a class="navbar-brand p-0 me-3" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Doalim" height="75" />
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir navegacao">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    @* Itens da esquerda *@
                    <ul class="navbar-nav me-auto align-items-lg-center gap-lg-1 py-2 py-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Produtos" asp-action="Vitrine">
                                <i class="bi bi-shop me-1"></i>Vitrine
                            </a>
                        </li>

                        @if (User.IsInRole("DoadorPF") || User.IsInRole("DoadorPJ"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Produtos" asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i>Meus Produtos
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard-data me-1"></i>Relatorios
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Produtos" asp-action="GerenciarReservas">
                                            <i class="bi bi-clipboard-check text-success me-2"></i>Gerenciar Reservas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Produtos" asp-action="HistoricoDoacoes">
                                            <i class="bi bi-clock-history text-primary me-2"></i>Historico de Doacoes
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservas" asp-action="MinhasReservas">
                                    <i class="bi bi-list-check me-1"></i>Minhas Reservas
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Usuarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Lookup" asp-action="Index">
                                    <i class="bi bi-sliders me-1"></i>Dominios
                                </a>
                            </li>
                        }

                    </ul>

                    @* Perfil do usuario (direita) *@
                    <ul class="navbar-nav align-items-lg-center py-2 py-lg-0 gap-lg-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* Carrinho - icone lado direito (apenas beneficiarios) *@
                            @if (User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-2" asp-controller="Carrinho" asp-action="Index" title="Meu Carrinho">
                                        <i class="bi bi-cart" style="font-size:1.35rem;"></i>
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center navbar-user-btn"
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (fotoPerfil != null && fotoPerfil.Length > 0)
                                    {
                                        var base64 = Convert.ToBase64String(fotoPerfil);
                                        <img src="data:image/jpeg;base64,@base64"
                                             alt="Foto de perfil" class="rounded-circle"
                                             style="width:32px; height:32px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle fs-5 text-secondary"></i>
                                    }
                                    <span class="fw-semibold">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuarios" asp-action="MeuPerfil">
                                            <i class="bi bi-gear me-2 text-secondary"></i>Meu Perfil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuarios" asp-action="PerfilPublico"
                                           asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
                                            <i class="bi bi-person-badge me-2 text-secondary"></i>Perfil Publico
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sair
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid app-main-container">
        <main role="main" class="pb-3">
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" id="alert-feedback">
                    <i class="bi bi-x-circle me-2"></i>@TempData["Erro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert" id="alert-feedback">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Doalim - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            var alertas = document.querySelectorAll('#alert-feedback');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    var bsAlert = bootstrap.Alert.getOrCreateInstance(alerta);
                    bsAlert.close();
                }, 3000);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
