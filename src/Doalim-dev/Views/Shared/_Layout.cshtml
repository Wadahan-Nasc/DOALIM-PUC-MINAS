@using Microsoft.EntityFrameworkCore
@inject Doalim_dev.Models.AppDbContext _context
@{
    var emailLogado = User.Identity?.IsAuthenticated == true
        ? (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name)
        : null;

    var fotoPerfil = emailLogado != null
        ? await _context.Usuarios
            .Where(u => u.Email == emailLogado)
            .Select(u => u.FotoPerfil)
            .FirstOrDefaultAsync()
        : null;

    var idLogadoStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var idLogadoNav = int.TryParse(idLogadoStr, out var _tmpId) ? _tmpId : 0;
    var notifNaoLidas = idLogadoNav > 0
        ? await _context.Notificacoes.CountAsync(n => n.IdUsuario == idLogadoNav && !n.Lida)
        : 0;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Doalim</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Doalim_dev.styles.css" asp-append-version="true" />
    <style>
        .navbar-doalim {
            border-bottom: 2px solid #e8f5e9;
            box-shadow: 0 1px 6px rgba(0,0,0,.06);
        }
        .navbar-doalim .nav-link {
            font-weight: 500;
            font-size: 1.05rem;
            color: #333 !important;
            border-radius: 6px;
            padding: 8px 13px !important;
            transition: background .15s, color .15s;
        }
        .navbar-doalim .nav-link:hover,
        .navbar-doalim .nav-link:focus {
            background: #f1f8f1;
            color: #2E7D32 !important;
        }
        .navbar-doalim .nav-link.active {
            color: #2E7D32 !important;
            background: #e8f5e9;
        }
        .navbar-doalim .dropdown-menu {
            border: none;
            box-shadow: 0 4px 16px rgba(0,0,0,.1);
            border-radius: 10px;
            min-width: 200px;
            padding: 6px;
        }
        .navbar-doalim .dropdown-item {
            border-radius: 6px;
            padding: 11px 18px;
            font-size: 1rem;
        }
        .navbar-doalim .dropdown-item:hover {
            background: #f1f8f1;
        }
        .navbar-doalim .dropdown-divider { margin: 4px 6px; }
        /* Notificações */
        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px 14px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            transition: background .15s;
            text-decoration: none;
            color: inherit;
        }
        .notif-item:last-child { border-bottom: none; }
        .notif-item:hover { background: #f8fbf6; }
        .notif-item.nao-lida { background: #f0faf0; }
        .notif-item.nao-lida:hover { background: #e8f5e9; }
        .notif-icone {
            width: 34px; height: 34px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; font-size: 1rem;
        }
        .navbar-user-btn {
            border: 1px solid #dee2e6;
            border-radius: 50px !important;
            padding: 4px 12px 4px 6px !important;
            gap: 8px;
        }
        .navbar-user-btn:hover {
            background: #f1f8f1 !important;
            border-color: #a5d6a7 !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white navbar-doalim mb-3">
            <div class="container-fluid px-3">

                @* Logo (clicavel, sem link "Home" separado) *@
                <a class="navbar-brand p-0 me-3" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Doalim" height="75" />
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir navegacao">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    @* Itens da esquerda *@
                    <ul class="navbar-nav me-auto align-items-lg-center gap-lg-1 py-2 py-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Produtos" asp-action="Vitrine">
                                <i class="bi bi-shop me-1"></i>Vitrine
                            </a>
                        </li>

                        @if (User.IsInRole("DoadorPF") || User.IsInRole("DoadorPJ"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Produtos" asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i>Meus Produtos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Produtos" asp-action="GerenciarReservas">
                                    <i class="bi bi-clipboard-check me-1"></i>Gerenciar Reservas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Produtos" asp-action="HistoricoDoacoes">
                                    <i class="bi bi-clock-history me-1"></i>Histórico de Doações
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservas" asp-action="MinhasReservas">
                                    <i class="bi bi-list-check me-1"></i>Minhas Reservas
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Usuários
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Lookup" asp-action="Index">
                                    <i class="bi bi-sliders me-1"></i>Domínios
                                </a>
                            </li>
                        }

                    </ul>

                    @* Perfil do usuario (direita) *@
                    <ul class="navbar-nav align-items-lg-center py-2 py-lg-0 gap-lg-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* Carrinho - icone lado direito (apenas beneficiarios) *@
                            @if (User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-2" asp-controller="Carrinho" asp-action="Index" title="Meu Carrinho">
                                        <i class="bi bi-cart" style="font-size:1.35rem;"></i>
                                    </a>
                                </li>
                            }

                            @* ── Sino de notificações ── *@
                            @if (!User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link px-2 position-relative" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false"
                                       id="notifBellToggle" title="Notificações"
                                       data-bs-auto-close="outside">
                                        <i class="bi bi-bell" style="font-size:1.35rem;" id="notifBellIcon"></i>
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                              id="notifBadge"
                                              style="font-size:.65rem; min-width:18px; padding:3px 5px; @(notifNaoLidas == 0 ? "display:none;" : "")">
                                            @(notifNaoLidas > 99 ? "99+" : notifNaoLidas.ToString())
                                        </span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end p-0 shadow"
                                         style="width:340px; max-height:440px; overflow-y:auto; border-radius:12px;"
                                         id="notifDropdown">
                                        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                            <span class="fw-semibold small">Notificações</span>
                                            <button type="button" class="btn btn-link btn-sm text-muted p-0"
                                                    id="btnMarcarTodasLidas" style="font-size:.8rem;">
                                                Marcar todas como lidas
                                            </button>
                                        </div>
                                        <div id="notifLista">
                                            <div class="text-center text-muted py-3 small">
                                                <div class="spinner-border spinner-border-sm text-success me-1" role="status"></div>
                                                Carregando...
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center navbar-user-btn"
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (fotoPerfil != null && fotoPerfil.Length > 0)
                                    {
                                        var base64 = Convert.ToBase64String(fotoPerfil);
                                        <img src="data:image/jpeg;base64,@base64"
                                             alt="Foto de perfil" class="rounded-circle"
                                             style="width:32px; height:32px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle fs-5 text-secondary"></i>
                                    }
                                    <span class="fw-semibold">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuarios" asp-action="MeuPerfil">
                                            <i class="bi bi-gear me-2 text-secondary"></i>Meu Perfil
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sair
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid app-main-container">
        <main role="main" class="pb-3">
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" id="alert-feedback">
                    <i class="bi bi-x-circle me-2"></i>@TempData["Erro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert" id="alert-feedback">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Doalim - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            var alertas = document.querySelectorAll('#alert-feedback');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    var bsAlert = bootstrap.Alert.getOrCreateInstance(alerta);
                    bsAlert.close();
                }, 3000);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
    {
        <script>
        (function () {
            var ANTIFORGERY_TOKEN = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] ?? '';

            var iconesPorTipo = {
                0: { icon: 'bi-cart-check-fill', bg: '#e8f5e9', cor: '#198754' },   // ReservaPendente
                1: { icon: 'bi-check-circle-fill', bg: '#e8f5e9', cor: '#198754' },  // ReservaAprovada
                2: { icon: 'bi-x-circle-fill', bg: '#fdecea', cor: '#dc3545' },      // ReservaRejeitada
                3: { icon: 'bi-alarm-fill', bg: '#fff3cd', cor: '#856404' },          // LembreteRetirada
                4: { icon: 'bi-exclamation-triangle-fill', bg: '#fdecea', cor: '#dc3545' } // DoacaoExpirada
            };

            function carregarNotificacoes() {
                fetch('/Notificacoes/MinhasJson')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        atualizarBadge(data.totalNaoLidas);
                        renderizarLista(data.notificacoes);
                    })
                    .catch(function () {
                        document.getElementById('notifLista').innerHTML =
                            '<div class="text-center text-muted py-3 small"><i class="bi bi-wifi-off me-1"></i>Erro ao carregar.</div>';
                    });
            }

            function atualizarBadge(total) {
                var badge = document.getElementById('notifBadge');
                var bell  = document.getElementById('notifBellIcon');
                if (!badge) return;
                if (total > 0) {
                    badge.textContent = total > 99 ? '99+' : total;
                    badge.style.display = '';
                    bell.className = 'bi bi-bell-fill text-success';
                } else {
                    badge.style.display = 'none';
                    bell.className = 'bi bi-bell';
                }
            }

            function escapeHtml(valor) {
                var div = document.createElement('div');
                div.textContent = valor == null ? '' : String(valor);
                return div.innerHTML;
            }

            function urlSegura(url) {
                if (!url) return '#';
                var valor = String(url).trim();
                return valor.startsWith('/') && !valor.startsWith('//') ? valor : '#';
            }

            function renderizarLista(lista) {
                var lista_el = document.getElementById('notifLista');
                if (!lista || lista.length === 0) {
                    lista_el.innerHTML =
                        '<div class="text-center text-muted py-4 small"><i class="bi bi-bell-slash me-1"></i>Nenhuma notificação.</div>';
                    return;
                }

                var html = '';
                lista.forEach(function (n) {
                    var cfg = iconesPorTipo[n.tipo] || { icon: 'bi-bell-fill', bg: '#f0f0f0', cor: '#666' };
                    var href = urlSegura(n.url);
                    var id = parseInt(n.idNotificacao, 10) || 0;
                    html +=
                        '<a class="notif-item ' + (n.lida ? '' : 'nao-lida') + '" ' +
                           'href="' + href + '" ' +
                           'data-id="' + id + '" ' +
                           'onclick="marcarLida(' + id + ', this)">' +
                            '<div class="notif-icone" style="background:' + cfg.bg + ';color:' + cfg.cor + ';">' +
                                '<i class="bi ' + cfg.icon + '"></i>' +
                            '</div>' +
                            '<div style="min-width:0;">' +
                                '<div class="fw-semibold" style="font-size:.83rem;">' + escapeHtml(n.titulo) + '</div>' +
                                '<div class="text-muted" style="font-size:.77rem;line-height:1.4;">' + escapeHtml(n.mensagem) + '</div>' +
                                '<div style="font-size:.72rem;color:#aaa;margin-top:2px;">' + escapeHtml(n.dataCriacao) + '</div>' +
                            '</div>' +
                        '</a>';
                });
                lista_el.innerHTML = html;
            }

            function marcarLida(id, el) {
                if (el.classList.contains('nao-lida')) {
                    el.classList.remove('nao-lida');
                    fetch('/Notificacoes/MarcarLida/' + id, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': ANTIFORGERY_TOKEN }
                    }).then(function () {
                        var badge = document.getElementById('notifBadge');
                        if (badge && badge.style.display !== 'none') {
                            var atual = parseInt(badge.textContent) || 0;
                            if (atual > 1) {
                                badge.textContent = atual - 1;
                            } else {
                                badge.style.display = 'none';
                                document.getElementById('notifBellIcon').className = 'bi bi-bell';
                            }
                        }
                    });
                }
            }
            window.marcarLida = marcarLida;

            // Marcar todas como lidas
            var btnTodas = document.getElementById('btnMarcarTodasLidas');
            if (btnTodas) {
                btnTodas.addEventListener('click', function () {
                    fetch('/Notificacoes/MarcarTodasLidas', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': ANTIFORGERY_TOKEN }
                    }).then(function () {
                        document.querySelectorAll('.notif-item.nao-lida').forEach(function (el) {
                            el.classList.remove('nao-lida');
                        });
                        var badge = document.getElementById('notifBadge');
                        if (badge) badge.style.display = 'none';
                        document.getElementById('notifBellIcon').className = 'bi bi-bell';
                    });
                });
            }

            // Carrega ao abrir o dropdown
            var bellToggle = document.getElementById('notifBellToggle');
            if (bellToggle) {
                bellToggle.addEventListener('show.bs.dropdown', function () {
                    carregarNotificacoes();
                });
            }

            // Polling a cada 60 segundos para atualizar o badge
            setInterval(function () {
                fetch('/Notificacoes/MinhasJson')
                    .then(function (r) { return r.json(); })
                    .then(function (data) { atualizarBadge(data.totalNaoLidas); })
                    .catch(function () {});
            }, 60000);
        })();
        </script>
    }
</body>
</html>
