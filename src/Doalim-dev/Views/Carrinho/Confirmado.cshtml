@model Doalim_dev.ViewModels.PedidoConfirmadoViewModel

@{
    ViewData["Title"] = "Pedido Confirmado";
}

<div class="text-center mb-5">
    <i class="bi bi-check-circle-fill text-success" style="font-size:3.5rem;"></i>
    <h2 class="mt-3">Pedido #@Model.IdPedido realizado com sucesso!</h2>
    <p class="text-muted">
        Realizado em @Model.DataPedido.ToString("dd/MM/yyyy") às @Model.DataPedido.ToString("HH:mm")
    </p>
    <p class="mb-0">
        Suas <strong>@Model.TotalReservas reserva(s)</strong> foram criadas com status
        <span class="badge bg-warning text-dark">Pendente</span>.
        O doador será notificado e aprovará em breve.
    </p>
</div>

<h5 class="mb-3">Itens reservados</h5>
<div class="row g-3 mb-4">
    @foreach (var reserva in Model.Reservas)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm @(!reserva.Sucesso ? "border-danger" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                        <h6 class="card-title mb-0">@reserva.NomeProduto</h6>
                        @if (reserva.Sucesso)
                        {
                            <span class="badge bg-warning text-dark flex-shrink-0">@reserva.StatusReserva</span>
                        }
                        else
                        {
                            <span class="badge bg-danger flex-shrink-0">Falhou</span>
                        }
                    </div>

                    <p class="text-muted small mb-2">@reserva.MarcaProduto &bull; @reserva.CategoriaProduto</p>

                    @if (!reserva.Sucesso && !string.IsNullOrEmpty(reserva.MotivoFalha))
                    {
                        <div class="alert alert-danger py-1 px-2 small mb-2">@reserva.MotivoFalha</div>
                    }

                    <dl class="row small mb-0">
                        <dt class="col-5">Quantidade</dt>
                        <dd class="col-7">@reserva.QuantidadeDesejada</dd>

                        <dt class="col-5">Unid. medida</dt>
                        <dd class="col-7">@reserva.UnidadeProduto</dd>

                        <dt class="col-5">Lote</dt>
                        <dd class="col-7">@reserva.NumeroLote</dd>

                        <dt class="col-5">Validade</dt>
                        <dd class="col-7">@reserva.DataValidadeLote.ToString("dd/MM/yyyy")</dd>

                        @if (!string.IsNullOrEmpty(reserva.NomeDoador))
                        {
                            <dt class="col-5">Doador</dt>
                            <dd class="col-7">@reserva.NomeDoador</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    }
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i>
    Acompanhe o status das suas reservas em <strong>Minhas Reservas</strong>.
    Quando o doador aprovar, você receberá o <strong>token de confirmação</strong>
    e o intervalo de datas para retirada.
</div>

<div class="d-flex gap-2 justify-content-center">
    <a asp-controller="Reservas" asp-action="MinhasReservas" class="btn btn-primary">
        <i class="bi bi-list-check me-1"></i> Ver minhas reservas
    </a>
    <a asp-controller="Produtos" asp-action="Vitrine" class="btn btn-outline-success">
        <i class="bi bi-shop me-1"></i> Continuar na vitrine
    </a>
</div>
