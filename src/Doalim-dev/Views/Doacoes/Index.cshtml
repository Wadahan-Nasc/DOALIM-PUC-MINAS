@model IEnumerable<Doalim_dev.ViewModels.VitrineDoacoesViewModel>

@{
    ViewData["Title"] = "Alimentos Disponíveis";
}

<h2 class="mb-4">🛒 Alimentos Disponíveis para Doação</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum alimento disponível no momento.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var produto in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@produto.Categoria</span>
                        <h5 class="card-title">@produto.Nome</h5>
                        <p class="card-text text-muted">@produto.MarcaProduto</p>
                        <p class="card-text text-muted">@produto.TipoArmazenamento</p>
                        <ul class="list-unstyled">
                            <li>📦 Quantidade: <strong>@produto.QuantidadeDisponivel</strong></li>
                            <li>📅 Validade: <strong>@produto.DataValidade.ToString("dd/MM/yyyy")</strong></li>
                            <li>🙋 Doador: <strong>@produto.NomeDoador</strong></li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Reservar" asp-route-id="@produto.IdProduto"
                           class="btn btn-success w-100">Reservar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}