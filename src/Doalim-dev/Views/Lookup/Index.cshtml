                                @if (v.IdValor <= 16) { <span class="badge bg-light text-secondary border ms-1 small">padrão</span> }
                            </span>
                            <div class="d-flex gap-1">
                                <form asp-action="ToggleAtivo" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.IdValor" />
                                    <button type="submit" class="btn btn-sm @(v.Ativo ? "btn-outline-warning" : "btn-outline-success")" title="@(v.Ativo ? "Desativar" : "Ativar")">
                                        <i class="bi @(v.Ativo ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                </form>
                                @if (v.IdValor > 16)
                                {
                                    <form asp-action="Excluir" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@v.IdValor" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir"
                                                onclick="return confirm('Excluir \"@v.Nome\"?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </li>
                    }
                    @if (!unidadesMedida.Any())
                    {
                        <li class="list-group-item text-muted small fst-italic">Nenhum valor cadastrado.</li>
                    }
                </ul>
            </div>
            <div class="card-footer bg-white">
                <form asp-action="Adicionar" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tipo" value="@((int)TipoLookup.UnidadeMedida)" />
                    <input type="text" name="nome" class="form-control form-control-sm"
                           placeholder="Nova unidade de medida..." maxlength="100" required />
                    <button type="submit" class="btn btn-success btn-sm flex-shrink-0">
                        <i class="bi bi-plus-lg me-1"></i> Adicionar
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
