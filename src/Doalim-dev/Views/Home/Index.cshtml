@{
    ViewData["Title"] = "Home";

    var totalUsuarios = ViewBag.TotalUsuarios ?? 0;
    var alimentosDisponiveis = ViewBag.AlimentosDisponiveis ?? 0;
    var produtosDisponiveis = ViewBag.ProdutosDisponiveis ?? 0;
    var doacoesReservadas = ViewBag.DoacoesReservadas ?? 0;
    var totalDoadores = ViewBag.TotalDoadores ?? 0;
    var isLogged = User.Identity?.IsAuthenticated == true;
    var isDoador = User.IsInRole("DoadorPF") || User.IsInRole("DoadorPJ");
    var isBeneficiario = User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ");
    var isAdmin = User.IsInRole("Admin");
}

<section class="home-shell">
    <div class="home-hero home-hero-marketing">
        <div class="home-hero-copy">
            <span class="admin-eyebrow">Doalim</span>
            <h1>Alimentos bons chegando a quem precisa.</h1>
            <p>
                Veja doações disponíveis, cadastre alimentos e acompanhe reservas em uma plataforma feita para aproximar doadores e beneficiários.
            </p>

            <div class="home-hero-actions">
                <a asp-controller="Produtos" asp-action="Vitrine" class="btn btn-success btn-lg">
                    <i class="bi bi-shop"></i>
                    Ver vitrine
                </a>

                @if (!isLogged)
                {
                    <a asp-controller="Auth" asp-action="Registro" class="btn btn-outline-success btn-lg">
                        <i class="bi bi-person-plus"></i>
                        Criar conta
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-warning btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Entrar
                    </a>
                }
                else if (isDoador)
                {
                    <a asp-controller="Produtos" asp-action="Create" class="btn btn-outline-success btn-lg">
                        <i class="bi bi-plus-circle"></i>
                        Cadastrar alimento
                    </a>
                }
                else if (isBeneficiario)
                {
                    <a asp-controller="Reservas" asp-action="MinhasReservas" class="btn btn-outline-success btn-lg">
                        <i class="bi bi-cart-check"></i>
                        Minhas reservas
                    </a>
                }
                else if (isAdmin)
                {
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-success btn-lg">
                        <i class="bi bi-people"></i>
                        Gerenciar usuários
                    </a>
                }
            </div>
        </div>

        <div class="home-hero-panel home-visual-panel" aria-label="Doalim">
            <div class="home-logo-frame">
                <img src="~/images/logo.png" alt="Doalim - Conectando alimentos." />
            </div>
            <div class="home-impact-list">
                <div>
                    <i class="bi bi-basket2"></i>
                    <span>@alimentosDisponiveis alimento(s) disponíveis para reserva</span>
                </div>
                <div>
                    <i class="bi bi-heart-pulse"></i>
                    <span>@doacoesReservadas doação(ões) já reservada(s)</span>
                </div>
                <div>
                    <i class="bi bi-people"></i>
                    <span>@totalUsuarios pessoa(s) conectada(s)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="home-stats home-impact-stats">
        <div class="home-stat">
            <span>Alimentos para reservar</span>
            <strong>@alimentosDisponiveis</strong>
        </div>
        <div class="home-stat">
            <span>Produtos na vitrine</span>
            <strong>@produtosDisponiveis</strong>
        </div>
        <div class="home-stat">
            <span>Doadores cadastrados</span>
            <strong>@totalDoadores</strong>
        </div>
        <div class="home-stat">
            <span>Reservas realizadas</span>
            <strong>@doacoesReservadas</strong>
        </div>
    </div>

    <div class="home-highlight">
        <div>
            <span class="admin-eyebrow">Vitrine aberta</span>
            <h2>Qualquer pessoa pode olhar os alimentos disponíveis.</h2>
            <p>Para reservar, o usuário precisa criar uma conta, enviar a documentação e aguardar aprovação administrativa.</p>
        </div>
        <a asp-controller="Produtos" asp-action="Vitrine" class="btn btn-success">
            <i class="bi bi-arrow-right-circle"></i>
            Explorar agora
        </a>
    </div>

    <div class="home-actions-grid">
        <a asp-controller="Produtos" asp-action="Vitrine" class="home-card text-decoration-none">
            <span class="home-card-icon"><i class="bi bi-shop"></i></span>
            <span class="home-card-title">Vitrine</span>
            <span class="home-card-text">Alimentos disponíveis para consulta pública e reserva por beneficiários aprovados.</span>
        </a>

        <a asp-controller="@(isDoador ? "Produtos" : "Auth")" asp-action="@(isDoador ? "Create" : "Registro")" class="home-card text-decoration-none">
            <span class="home-card-icon"><i class="bi bi-bag-heart"></i></span>
            <span class="home-card-title">Quero doar</span>
            <span class="home-card-text">Cadastre alimentos e ajude a transformar excedentes em apoio real.</span>
        </a>

        @if (isBeneficiario)
        {
            <a asp-controller="Reservas" asp-action="MinhasReservas" class="home-card text-decoration-none">
                <span class="home-card-icon"><i class="bi bi-cart-check"></i></span>
                <span class="home-card-title">Minhas reservas</span>
                <span class="home-card-text">Acompanhe os alimentos reservados e organize suas retiradas.</span>
            </a>
        }
        else if (isAdmin)
        {
            <a asp-controller="Usuarios" asp-action="Index" class="home-card text-decoration-none">
                <span class="home-card-icon"><i class="bi bi-shield-check"></i></span>
                <span class="home-card-title">Painel administrativo</span>
                <span class="home-card-text">Aprove cadastros, acompanhe usuários e mantenha a plataforma confiável.</span>
            </a>
        }
        else
        {
            <a asp-controller="Auth" asp-action="Registro" class="home-card text-decoration-none">
                <span class="home-card-icon"><i class="bi bi-person-check"></i></span>
                <span class="home-card-title">Quero reservar</span>
                <span class="home-card-text">Crie sua conta, envie a documentação e aguarde a aprovação para reservar.</span>
            </a>
        }
    </div>
</section>
