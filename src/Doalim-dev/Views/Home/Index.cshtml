@{
    ViewData["Title"] = "Home";

    var totalUsuarios = ViewBag.TotalUsuarios ?? 0;
    var alimentosDisponiveis = ViewBag.AlimentosDisponiveis ?? 0;
    var produtosDisponiveis = ViewBag.ProdutosDisponiveis ?? 0;
    var doacoesReservadas = ViewBag.DoacoesReservadas ?? 0;
    var totalDoadores = ViewBag.TotalDoadores ?? 0;
    var isLogged = User.Identity?.IsAuthenticated == true;
    var isDoador = User.IsInRole("DoadorPF") || User.IsInRole("DoadorPJ");
    var isBeneficiario = User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ");
    var isAdmin = User.IsInRole("Admin");
}

<section class="home-page home-page-redesign">
    <section class="home-hero-stage home-hero-stage-v2">
        <div class="home-hero-content">
            <span class="home-kicker">Doalim</span>
            <h1>Alimento bom circulando para quem precisa.</h1>
            <p>
                Uma plataforma para cadastrar doações, validar perfis e reservar alimentos com mais controle, privacidade e confiança.
            </p>
            <div class="home-hero-actions">
                <a asp-controller="Produtos" asp-action="Vitrine" class="btn btn-success btn-lg">
                    <i class="bi bi-shop"></i>
                    Ver vitrine
                </a>
                @if (!isLogged)
                {
                    <a asp-controller="Auth" asp-action="Registro" class="btn btn-light btn-lg home-contrast-btn">
                        <i class="bi bi-person-plus"></i>
                        Criar conta
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Entrar
                    </a>
                }
                else if (isAdmin)
                {
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-light btn-lg home-contrast-btn">
                        <i class="bi bi-shield-check"></i>
                        Painel admin
                    </a>
                }
                else if (isDoador)
                {
                    <a asp-controller="Produtos" asp-action="Create" class="btn btn-light btn-lg home-contrast-btn">
                        <i class="bi bi-plus-circle"></i>
                        Cadastrar alimento
                    </a>
                }
                else if (isBeneficiario)
                {
                    <a asp-controller="Reservas" asp-action="MinhasReservas" class="btn btn-light btn-lg home-contrast-btn">
                        <i class="bi bi-cart-check"></i>
                        Minhas reservas
                    </a>
                }
            </div>

            <div class="home-trust-row" aria-label="Destaques da plataforma">
                <span><i class="bi bi-lock"></i> Dados privados</span>
                <span><i class="bi bi-patch-check"></i> Perfis validados</span>
                <span><i class="bi bi-arrow-left-right"></i> Doador e beneficiário</span>
            </div>
        </div>

        <div class="home-hero-insight home-hero-insight-v2" aria-label="Resumo da plataforma">
            <div class="home-preview-top">
                <img src="~/images/logo.png" alt="Doalim" />
                <div>
                    <span>Plataforma ativa</span>
                    <strong>@alimentosDisponiveis alimento(s)</strong>
                </div>
            </div>
            <div class="home-preview-panel">
                <div class="home-preview-row is-live">
                    <i class="bi bi-basket2"></i>
                    <div>
                        <strong>Vitrine abastecida</strong>
                        <span>@produtosDisponiveis produto(s) disponíveis</span>
                    </div>
                </div>
                <div class="home-preview-row">
                    <i class="bi bi-people"></i>
                    <div>
                        <strong>Rede cadastrada</strong>
                        <span>@totalUsuarios usuário(s) na plataforma</span>
                    </div>
                </div>
                <div class="home-preview-row">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <strong>Fluxo protegido</strong>
                        <span>Comprovação antes de doar ou reservar</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-impact-strip home-impact-strip-v2" aria-label="Indicadores da plataforma">
        <div><span>Alimentos</span><strong>@alimentosDisponiveis</strong><small>na vitrine</small></div>
        <div><span>Produtos</span><strong>@produtosDisponiveis</strong><small>com lotes ativos</small></div>
        <div><span>Doadores</span><strong>@totalDoadores</strong><small>cadastrados</small></div>
        <div><span>Reservas</span><strong>@doacoesReservadas</strong><small>registradas</small></div>
        <div><span>Usuários</span><strong>@totalUsuarios</strong><small>na rede</small></div>
    </section>

    <section class="home-feature-band">
        <div class="home-section-heading">
            <span class="home-kicker">Perfis conectados</span>
            <h2>Um sistema para quem doa, recebe e valida.</h2>
        </div>
        <div class="home-feature-grid">
            <article class="home-feature-card is-donor">
                <i class="bi bi-bag-heart"></i>
                <h3>Doador</h3>
                <p>Cadastra alimentos, lotes, validade, quantidade e acompanha o que está disponível.</p>
            </article>
            <article class="home-feature-card is-beneficiary">
                <i class="bi bi-cart-check"></i>
                <h3>Beneficiário</h3>
                <p>Consulta a vitrine e reserva alimentos após a comprovação ser aprovada.</p>
            </article>
            <article class="home-feature-card is-admin">
                <i class="bi bi-person-lock"></i>
                <h3>Admin</h3>
                <p>Valida comprovações sem alterar dados pessoais nem acessar senha dos usuários.</p>
            </article>
        </div>
    </section>

    <section class="home-flow-band home-flow-band-v2">
        <div class="home-section-heading">
            <span class="home-kicker">Como funciona</span>
            <h2>Doação e reserva com validação.</h2>
        </div>
        <div class="home-flow-grid">
            <article class="home-flow-item">
                <span><i class="bi bi-file-earmark-arrow-up"></i></span>
                <h3>Envie a comprovação</h3>
                <p>O usuário mantém seus dados no próprio perfil e envia o arquivo necessário para análise.</p>
            </article>
            <article class="home-flow-item">
                <span><i class="bi bi-shield-check"></i></span>
                <h3>Admin valida</h3>
                <p>A administração aprova apenas cadastros com arquivo enviado e documentação adequada.</p>
            </article>
            <article class="home-flow-item">
                <span><i class="bi bi-basket2"></i></span>
                <h3>Doe ou reserve</h3>
                <p>Com a conta aprovada, cada perfil pode doar alimentos, reservar itens ou fazer as duas coisas.</p>
            </article>
        </div>
    </section>

    <section class="home-action-band home-action-band-v2">
        <div class="home-action-copy">
            <span class="home-kicker">Vitrine aberta</span>
            <h2>Veja o que já pode virar ajuda.</h2>
            <p>Reservas exigem conta aprovada, mas a vitrine pública mostra os alimentos disponíveis e ajuda a rede a se organizar.</p>
        </div>
        <div class="home-action-grid">
            <a asp-controller="Produtos" asp-action="Vitrine" class="home-action-card">
                <i class="bi bi-shop"></i>
                <strong>Explorar vitrine</strong>
                <span>Consultar alimentos disponíveis</span>
            </a>
            <a asp-controller="@(isDoador ? "Produtos" : "Auth")" asp-action="@(isDoador ? "Create" : "Registro")" class="home-action-card">
                <i class="bi bi-bag-heart"></i>
                <strong>Quero doar</strong>
                <span>Cadastrar alimento e lote</span>
            </a>
            <a asp-controller="@(isBeneficiario ? "Reservas" : "Auth")" asp-action="@(isBeneficiario ? "MinhasReservas" : "Registro")" class="home-action-card">
                <i class="bi bi-cart-check"></i>
                <strong>Quero reservar</strong>
                <span>Acompanhar reservas aprovadas</span>
            </a>
            @if (isAdmin)
            {
                <a asp-controller="Usuarios" asp-action="Index" class="home-action-card home-action-card-admin">
                    <i class="bi bi-person-lock"></i>
                    <strong>Administração</strong>
                    <span>Validar comprovações</span>
                </a>
            }
        </div>
    </section>
</section>