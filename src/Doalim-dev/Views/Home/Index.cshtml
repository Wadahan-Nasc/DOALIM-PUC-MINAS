@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <img src="~/images/logo.png" alt="Doalim — Conectando alimentos."
         class="img-fluid mb-4" style="max-width: 280px;"
         onerror="this.style.display='none'; document.getElementById('logoFallback').style.display='block';" />
    
    <div id="logoFallback" style="display:none;">
        <h1 class="fw-bold" style="color: var(--doalim-verde-escuro);">Doalim</h1>
        <p class="lead text-muted">Conectando alimentos.</p>
    </div>

    @if (!User.Identity.IsAuthenticated)
    {
        <div class="mt-4 d-flex justify-content-center gap-3">
            <a asp-controller="Auth" asp-action="Registro"
               class="btn btn-success btn-lg px-4">Cadastre-se</a>
            <a asp-controller="Auth" asp-action="Login"
               class="btn btn-outline-success btn-lg px-4">Login</a>
        </div>
    }
    else
    {
        <p class="mt-3 text-muted">
            Bem-vindo(a), <strong>@User.Identity.Name</strong>!
        </p>
    }
</div>

@if (User.Identity.IsAuthenticated)
{
<div class="row g-3 justify-content-center pb-4">
    <div class="col-md-4">
        <a asp-controller="Produtos" asp-action="Vitrine" class="home-card text-decoration-none">
            <span class="home-card-icon"><i class="bi bi-shop"></i></span>
            <span class="home-card-title">Vitrine</span>
            <span class="home-card-text">Encontre alimentos disponíveis para doação.</span>
        </a>
    </div>

    @if (User.Identity.IsAuthenticated && (User.IsInRole("BeneficiarioPF") || User.IsInRole("BeneficiarioPJ")))
    {
        <div class="col-md-4">
            <a asp-controller="Reservas" asp-action="MinhasReservas" class="home-card text-decoration-none">
                <span class="home-card-icon"><i class="bi bi-cart-check"></i></span>
                <span class="home-card-title">Minhas reservas</span>
                <span class="home-card-text">Acompanhe os alimentos que você reservou.</span>
            </a>
        </div>
    }

    @if (User.Identity.IsAuthenticated && (User.IsInRole("DoadorPF") || User.IsInRole("DoadorPJ")))
    {
        <div class="col-md-4">
            <a asp-controller="Produtos" asp-action="Create" class="home-card text-decoration-none">
                <span class="home-card-icon"><i class="bi bi-plus-circle"></i></span>
                <span class="home-card-title">Cadastrar produto</span>
                <span class="home-card-text">Adicione alimentos para disponibilizar na vitrine.</span>
            </a>
        </div>
    }

    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
    {
        <div class="col-md-4">
            <a asp-controller="Usuarios" asp-action="Index" class="home-card text-decoration-none">
                <span class="home-card-icon"><i class="bi bi-people"></i></span>
                <span class="home-card-title">Usuários</span>
                <span class="home-card-text">Gerencie os usuários cadastrados no sistema.</span>
            </a>
        </div>
    }
</div>
}
