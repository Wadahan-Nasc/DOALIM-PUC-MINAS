@model Doalim_dev.ViewModels.RegistroViewModel
@using Doalim_dev.Models
@{
    ViewData["Title"] = "Criar Conta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .reg-avatar-wrapper {
        position: relative;
        display: inline-block;
        cursor: pointer;
    }
    .reg-avatar-placeholder {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #dee2e6;
    }
    .reg-avatar-img {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #dee2e6;
        display: block;
    }
    .reg-avatar-edit-btn {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #198754;
        color: #fff;
        border: 2px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        box-shadow: 0 2px 5px rgba(0,0,0,.2);
    }
    .reg-comprovacao-area:hover {
        border-color: #198754 !important;
        background: #f0faf0 !important;
    }
</style>

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-7 col-lg-6">

        <div class="text-center mb-4">
            <h2 class="fw-bold">Criar Conta no Doalim</h2>
            <p class="text-muted">Preencha os dados abaixo para se cadastrar</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="Registro" asp-controller="Auth" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Tipo de Usuário <span class="text-danger">*</span></label>
                <div class="d-flex gap-4 align-items-center flex-wrap">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="perfilRadio"
                               id="radioDoador" value="doador" checked />
                        <label class="form-check-label fw-bold" for="radioDoador">Doador</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="perfilRadio"
                               id="radioBeneficiario" value="beneficiario" />
                        <label class="form-check-label fw-bold" for="radioBeneficiario">Beneficiário</label>
                    </div>
                </div>

                @* Aparece só para Doador *@
                <div class="form-check mt-2" id="campoEmpresa" style="display:none;">
                    <input class="form-check-input" type="checkbox" id="checkEmpresa" />
                    <label class="form-check-label" for="checkEmpresa">
                        Pessoa Jurídica (empresa/comércio)
                    </label>
                </div>

                @* Aparece só para Beneficiário *@
                <div class="form-check mt-2" id="campoOng" style="display:none;">
                    <input class="form-check-input" type="checkbox" id="checkOng" />
                    <label class="form-check-label" for="checkOng">
                        ONG / Instituição
                    </label>
                </div>

                <input type="hidden" id="TipoUsuario" name="TipoUsuario" value="0" />
                <span asp-validation-for="TipoUsuario" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" placeholder="Nome completo" />
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="seu@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefone" class="form-label"></label>
                <input asp-for="Telefone" class="form-control" placeholder="(11) 99999-9999" />
                <span asp-validation-for="Telefone" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Endereço</label>
                <div class="row g-2">
                    <div class="col-md-4">
                        <input asp-for="Cep" class="form-control" placeholder="CEP" id="cep" maxlength="9" />
                        <span asp-validation-for="Cep" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <input asp-for="Logradouro" class="form-control" placeholder="Logradouro" id="logradouro" />
                        <span asp-validation-for="Logradouro" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <input asp-for="Numero" class="form-control" placeholder="Número" />
                        <span asp-validation-for="Numero" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <input asp-for="Complemento" class="form-control" placeholder="Complemento (opcional)" />
                    </div>
                    <div class="col-md-4">
                        <input asp-for="Bairro" class="form-control" placeholder="Bairro" id="bairro" />
                        <span asp-validation-for="Bairro" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <input asp-for="Cidade" class="form-control" placeholder="Cidade" id="cidade" />
                        <span asp-validation-for="Cidade" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <input asp-for="Estado" class="form-control" placeholder="UF" id="estado" maxlength="2" />
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            @* Campo CPF — exibido apenas para PF *@
            <div class="mb-3" id="campoCpf" style="display:none;">
                <label asp-for="Cpf" class="form-label"></label>
                <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" />
                <span asp-validation-for="Cpf" class="text-danger small"></span>
            </div>

            @* Campo CNPJ — exibido apenas para PJ *@
            <div class="mb-3" id="campoCnpj" style="display:none;">
                <label asp-for="Cnpj" class="form-label"></label>
                <input asp-for="Cnpj" class="form-control" placeholder="00.000.000/0001-00" />
                <span asp-validation-for="Cnpj" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Senha" type="password" class="form-control" id="campoSenha"
                           placeholder="Mínimo 8 caracteres" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="alternarSenha('campoSenha', this)" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Senha" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmaSenha" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ConfirmaSenha" type="password" class="form-control" id="campoConfirmaSenha"
                           placeholder="Repita a senha" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="alternarSenha('campoConfirmaSenha', this)" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmaSenha" class="text-danger small"></span>
            </div>

            @* RF-002: Checkbox do Termo — exibido apenas para Doadores *@
            <div class="mb-3 p-3 border rounded bg-light" id="campoTermo" style="display:none;">
                <div class="form-check">
                    <input asp-for="AceitouTermo" class="form-check-input" id="checkTermo" />
                    <label asp-for="AceitouTermo" class="form-check-label">
                        Li e aceito o
                        <a asp-action="Termo" asp-controller="Auth" target="_blank"
                           class="fw-bold text-success text-decoration-none">
                            Termo de Responsabilidade
                        </a>
                        (Lei 14.016/2020)
                    </label>
                </div>
                <span asp-validation-for="AceitouTermo" class="text-danger small d-block mt-1"></span>
                <small class="text-muted d-block mt-1">
                    Obrigatório para doadores. Recomendamos ler antes de aceitar.
                </small>
            </div>

            <!-- Foto de Perfil — avatar clicável -->
            <div class="mb-3">
                <label class="form-label">Foto do Perfil <span class="text-muted small">(opcional)</span></label>
                <div class="d-flex align-items-center gap-4">
                    <div class="reg-avatar-wrapper" onclick="document.getElementById('fotoPerfilInput').click()" title="Clique para escolher uma foto">
                        <div id="fotoPreviewReg" class="reg-avatar-placeholder">
                            <i class="bi bi-person" style="font-size:2.2rem; color:#fff;"></i>
                        </div>
                        <span class="reg-avatar-edit-btn">
                            <i class="bi bi-camera-fill"></i>
                        </span>
                    </div>
                    <div class="text-muted small">
                        Clique no avatar para escolher uma foto.<br>
                        Formatos aceitos: JPG, PNG &bull; Máx. 2 MB
                    </div>
                </div>
                <input asp-for="FotoPerfilUpload" id="fotoPerfilInput" type="file"
                       class="d-none" accept=".png,.jpg,.jpeg" />
            </div>

            <!-- Arquivo de Comprovação -->
            <div class="mb-3">
                <label class="form-label">
                    Arquivo de Comprovação
                    <span class="text-muted small">(opcional — necessário para doar ou reservar)</span>
                </label>
                <div class="reg-comprovacao-area p-3" style="border:2px dashed #a5d6a7; border-radius:10px; background:#f8fbf6; cursor:pointer;"
                     onclick="document.getElementById('comprovacaoInput').click()">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center rounded"
                             style="width:44px;height:44px;background:#e8f5e9;flex-shrink:0;">
                            <i class="bi bi-file-earmark-arrow-up text-success" style="font-size:1.4rem;"></i>
                        </div>
                        <div>
                            <div id="comprovacaoNomeReg" class="fw-semibold small" style="color:#2e7d32;">
                                Clique para anexar um documento
                            </div>
                            <div class="text-muted" style="font-size:.78rem;">
                                Formatos aceitos: PDF, JPG, PNG &bull; Máx. 5 MB
                            </div>
                        </div>
                    </div>
                </div>
                <input asp-for="ArquivoComprovacaoUpload" id="comprovacaoInput" type="file"
                       class="d-none" accept=".pdf,.jpg,.png" />
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-success btn-lg">Criar Conta</button>
            </div>

            <p class="text-center text-muted small">
                Já tem conta?
                <a asp-action="Login" asp-controller="Auth" class="text-decoration-none fw-bold">
                    Faça login
                </a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Elementos do DOM
        const radioDoador   = document.getElementById('radioDoador');
        const radioBenefic  = document.getElementById('radioBeneficiario');
        const checkOng      = document.getElementById('checkOng');
        const checkEmpresa  = document.getElementById('checkEmpresa');
        const campoOng      = document.getElementById('campoOng');
        const campoEmpresa  = document.getElementById('campoEmpresa');
        const hiddenTipo    = document.getElementById('TipoUsuario');
        const campoCpf      = document.getElementById('campoCpf');
        const campoCnpj     = document.getElementById('campoCnpj');
        const campoTermo    = document.getElementById('campoTermo');
        const inputCpf      = document.getElementById('Cpf');
        const inputCnpj     = document.getElementById('Cnpj');
        const inputTelefone = document.getElementById('Telefone');

        // Máscara CPF: 000.000.000-00 
        inputCpf.addEventListener('input', function () {
            let v = this.value.replace(/\D/g, '').slice(0, 11);
            if (v.length > 9)      v = v.replace(/^(\d{3})(\d{3})(\d{3})(\d{0,2})/, '$1.$2.$3-$4');
            else if (v.length > 6) v = v.replace(/^(\d{3})(\d{3})(\d{0,3})/,        '$1.$2.$3');
            else if (v.length > 3) v = v.replace(/^(\d{3})(\d{0,3})/,               '$1.$2');
            this.value = v;
        });

        //  Máscara CNPJ: 00.000.000/0001-00 
        inputCnpj.addEventListener('input', function () {
            let v = this.value.replace(/\D/g, '').slice(0, 14);
            if (v.length > 12)      v = v.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{0,2})/, '$1.$2.$3/$4-$5');
            else if (v.length > 8)  v = v.replace(/^(\d{2})(\d{3})(\d{3})(\d{0,4})/,        '$1.$2.$3/$4');
            else if (v.length > 5)  v = v.replace(/^(\d{2})(\d{3})(\d{0,3})/,               '$1.$2.$3');
            else if (v.length > 2)  v = v.replace(/^(\d{2})(\d{0,3})/,                       '$1.$2');
            this.value = v;
        });

        //  Máscara Telefone: (11) 99999-9999
        inputTelefone.addEventListener('input', function () {
            let v = this.value.replace(/\D/g, '').slice(0, 11);
            if (v.length > 10)     v = v.replace(/^(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3');
            else if (v.length > 6) v = v.replace(/^(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3');
            else if (v.length > 2) v = v.replace(/^(\d{2})(\d{0,5})/,        '($1) $2');
            else if (v.length > 0) v = v.replace(/^(\d{0,2})/,               '($1');
            this.value = v;
        });

        // Validação CPF (dígitos verificadores) 
        function cpfValido(cpf) {
            cpf = cpf.replace(/\D/g, '');
            if (cpf.length !== 11 || /^(\d)\1+$/.test(cpf)) return false;
            let soma = 0, resto;
            for (let i = 1; i <= 9; i++) soma += parseInt(cpf[i-1]) * (11 - i);
            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            if (resto !== parseInt(cpf[9])) return false;
            soma = 0;
            for (let i = 1; i <= 10; i++) soma += parseInt(cpf[i-1]) * (12 - i);
            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            return resto === parseInt(cpf[10]);
        }

        // Validação CNPJ (dígitos verificadores)
        function cnpjValido(cnpj) {
            cnpj = cnpj.replace(/\D/g, '');
            if (cnpj.length !== 14 || /^(\d)\1+$/.test(cnpj)) return false;
            const calc = (c, n) => {
                let s = 0, p = n - 7;
                for (let i = 0; i < n; i++) {
                    s += parseInt(c[i]) * p--;
                    if (p < 2) p = 9;
                }
                const r = s % 11;
                return r < 2 ? 0 : 11 - r;
            };
            return calc(cnpj, 12) === parseInt(cnpj[12]) &&
                   calc(cnpj, 13) === parseInt(cnpj[13]);
        }

                // Busca automática pelo CEP (ViaCEP)
        document.getElementById('cep')?.addEventListener('blur', async function () {
            const cep = this.value.replace(/\D/g, '');
            if (cep.length !== 8) return;
            const res  = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
            const data = await res.json();
            if (data.erro) return;
            document.getElementById('logradouro').value = data.logradouro;
            document.getElementById('bairro').value     = data.bairro;
            document.getElementById('cidade').value     = data.localidade;
            document.getElementById('estado').value     = data.uf;
        });

        // Máscara CEP: 00000-000
        document.getElementById('cep')?.addEventListener('input', function () {
            let v = this.value.replace(/\D/g, '').slice(0, 8);
            if (v.length > 5) v = v.replace(/^(\d{5})(\d{0,3})/, '$1-$2');
            this.value = v;
        });

        // Validação no submit 
        document.querySelector('form').addEventListener('submit', function (e) {
            const ehPF = hiddenTipo.value === '0' || hiddenTipo.value === '2';
            const ehPJ = hiddenTipo.value === '1' || hiddenTipo.value === '3';

            if (ehPF && inputCpf.value) {
                if (!cpfValido(inputCpf.value)) {
                    e.preventDefault();
                    inputCpf.setCustomValidity('CPF inválido.');
                    inputCpf.reportValidity();
                    return;
                }
            }
            if (ehPJ && inputCnpj.value) {
                if (!cnpjValido(inputCnpj.value)) {
                    e.preventDefault();
                    inputCnpj.setCustomValidity('CNPJ inválido.');
                    inputCnpj.reportValidity();
                    return;
                }
            }
            // Limpa validação customizada se passou
            inputCpf.setCustomValidity('');
            inputCnpj.setCustomValidity('');
        });

        // Limpa erro customizado ao digitar
        inputCpf.addEventListener('input',  () => inputCpf.setCustomValidity(''));
        inputCnpj.addEventListener('input', () => inputCnpj.setCustomValidity(''));

        // Lógica de tipo de perfil
        function atualizarCampos() {
            const ehDoador  = radioDoador.checked;
            const ehOng     = checkOng.checked;
            const ehEmpresa = checkEmpresa.checked;

            campoEmpresa.style.display = ehDoador ? 'block' : 'none';
            campoOng.style.display     = !ehDoador ? 'block' : 'none';

            if (ehDoador)  checkOng.checked     = false;
            if (!ehDoador) checkEmpresa.checked = false;

            if      (ehDoador && !ehEmpresa)  hiddenTipo.value = '0';
            else if (ehDoador && ehEmpresa)   hiddenTipo.value = '1';
            else if (!ehDoador && !ehOng)     hiddenTipo.value = '2';
            else                              hiddenTipo.value = '3';

            const ehPF = hiddenTipo.value === '0' || hiddenTipo.value === '2';
            const ehPJ = hiddenTipo.value === '1' || hiddenTipo.value === '3';

            campoCpf.style.display   = ehPF ? 'block' : 'none';
            campoCnpj.style.display  = ehPJ ? 'block' : 'none';
            campoTermo.style.display = ehDoador ? 'block' : 'none';

            if (!ehPF) inputCpf.value  = '';
            if (!ehPJ) inputCnpj.value = '';
            if (!ehDoador) document.getElementById('AceitouTermo').checked = false;
        }

        radioDoador.addEventListener('change',  atualizarCampos);
        radioBenefic.addEventListener('change', atualizarCampos);
        checkOng.addEventListener('change',     atualizarCampos);
        checkEmpresa.addEventListener('change', atualizarCampos);

        atualizarCampos();

        // Pré-visualização da foto de perfil
        document.getElementById('fotoPerfilInput').addEventListener('change', function () {
            if (!this.files || !this.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) {
                var preview = document.getElementById('fotoPreviewReg');
                if (preview.tagName === 'IMG') {
                    preview.src = e.target.result;
                } else {
                    var img = document.createElement('img');
                    img.id = 'fotoPreviewReg';
                    img.src = e.target.result;
                    img.className = 'reg-avatar-img';
                    preview.replaceWith(img);
                }
            };
            reader.readAsDataURL(this.files[0]);
        });

        // Exibe nome do arquivo de comprovação selecionado
        document.getElementById('comprovacaoInput').addEventListener('change', function () {
            var label = document.getElementById('comprovacaoNomeReg');
            if (this.files && this.files[0]) {
                label.innerHTML = '<i class="bi bi-file-earmark-check me-1"></i>' + this.files[0].name;
                label.style.color = '#198754';
            } else {
                label.textContent = 'Clique para anexar um documento';
                label.style.color = '#2e7d32';
            }
        });

        function alternarSenha(id, btn) {
            const input = document.getElementById(id);
            const icon  = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>
}