@model Doalim_dev.Models.Usuario

@{
    ViewData["Title"] = "Meu Perfil";
    var temDoador = ViewBag.TemDoador == true;
    var temBeneficiario = ViewBag.TemBeneficiario == true;
    var precisaComprovacao = UsuarioRegras.PrecisaComprovacao(Model);
    var liberado = UsuarioRegras.TemComprovacaoAprovada(Model);
}

<section class="profile-shell">
    <div class="profile-header-panel">
        <div>
            <span class="admin-eyebrow">Minha conta</span>
            <h1>Meu Perfil</h1>
            <p>Mantenha seus dados atualizados. Doações e reservas só são liberadas após aprovação administrativa quando o perfil exigir comprovação.</p>
        </div>
        <span class="admin-status @(liberado ? "status-success" : "status-warning")">
            @(!precisaComprovacao ? "Comprovação não aplicável" : liberado ? "Comprovação aprovada" : "Comprovação pendente")
        </span>
    </div>

    <div class="profile-grid">
        <aside class="profile-side-panel">
            @if (!string.IsNullOrEmpty(Model.FotoPerfil))
            {
                <img src="@Model.FotoPerfil" alt="Foto de perfil" class="profile-photo-lg" />
            }
            else
            {
                <div class="profile-photo-lg profile-photo-empty"><i class="bi bi-person"></i></div>
            }

            <h2>@Model.Nome</h2>
            <div class="profile-badges">
                @if (Model.TipoUsuario == TipoUsuario.Admin) { <span class="admin-status status-neutral">Administrador</span> }
                @if (temDoador) { <span class="admin-status status-success">Doador</span> }
                @if (temBeneficiario) { <span class="admin-status status-success">Beneficiário</span> }
                @if (!temDoador && !temBeneficiario && Model.TipoUsuario != TipoUsuario.Admin) { <span class="admin-status status-warning">Sem perfil operacional</span> }
            </div>

            <div class="profile-actions-stack">
                @if (!temDoador && Model.TipoUsuario != TipoUsuario.Admin)
                {
                    <form asp-action="TornarDoador" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success w-100"><i class="bi bi-basket2"></i> Ativar perfil de doador</button>
                    </form>
                }
                @if (!temBeneficiario && Model.TipoUsuario != TipoUsuario.Admin)
                {
                    <form asp-action="TornarBeneficiario" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-people"></i> Ativar perfil de beneficiário</button>
                    </form>
                }
            </div>
        </aside>

        <form asp-controller="Usuarios" asp-action="MeuPerfil" method="post" enctype="multipart/form-data" class="profile-form-panel">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="IdUsuario" />
            <input type="hidden" asp-for="SenhaHash" />
            <input type="hidden" asp-for="TipoUsuario" />
            <input type="hidden" asp-for="StatusVerificacao" />
            <input type="hidden" asp-for="Ativo" />
            <input type="hidden" asp-for="DataCadastro" />
            <input type="hidden" asp-for="Arquivocomprovacao" />

            <div class="profile-form-section">
                <h2>Dados principais</h2>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Telefone" class="form-label"></label>
                        <input asp-for="Telefone" class="form-control" />
                        <span asp-validation-for="Telefone" class="text-danger"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Endereco" class="form-label"></label>
                        <input asp-for="Endereco" class="form-control" />
                        <span asp-validation-for="Endereco" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="profile-form-section">
                <h2>Identificação</h2>
                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.Cpf))
                    {
                        <div class="col-md-6">
                            <label asp-for="Cpf" class="form-label"></label>
                            <input asp-for="Cpf" class="form-control bg-secondary-subtle text-muted" readonly />
                            <span asp-validation-for="Cpf" class="text-danger"></span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Cnpj))
                    {
                        <div class="col-md-6">
                            <label asp-for="Cnpj" class="form-label"></label>
                            <input asp-for="Cnpj" class="form-control bg-secondary-subtle text-muted" readonly />
                            <span asp-validation-for="Cnpj" class="text-danger"></span>
                        </div>
                    }
                </div>
            </div>

            <div class="profile-form-section">
                <h2>Arquivos</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Foto de Perfil</label>
                        <input type="file" name="arquivoFotoPerfil" class="form-control" accept=".png,.jpg,.jpeg" />
                        <div class="form-text">PNG, JPG ou JPEG até 2MB.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Arquivo de Comprovação</label>
                        @if (!precisaComprovacao)
                        {
                            <div class="profile-admin-proof-note"><i class="bi bi-shield-lock"></i> Administradores não precisam enviar comprovação.</div>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(Model.Arquivocomprovacao))
                            {
                                <div class="mb-2"><a href="@Model.Arquivocomprovacao" target="_blank" class="admin-doc-link"><i class="bi bi-paperclip"></i> Ver arquivo atual</a></div>
                            }
                            <input type="file" name="arquivoComprovacao" class="form-control" accept=".png,.jpg,.jpeg,.pdf" />
                            <div class="form-text">Novo envio volta para análise do administrador.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="profile-status-callout @(!precisaComprovacao || liberado ? "is-approved" : "is-pending")">
                <i class="bi @(!precisaComprovacao || liberado ? "bi-check-circle" : "bi-hourglass-split")"></i>
                <div>
                    <strong>@(!precisaComprovacao ? "Conta administrativa sem exigência de comprovação." : liberado ? "Você já pode operar nos perfis ativos." : "Doações e reservas ainda estão bloqueadas.")</strong>
                    <span>@(!precisaComprovacao ? "O arquivo de comprovação é exigido apenas para perfis operacionais." : "É necessário ter arquivo de comprovação enviado e aprovado pela administração.")</span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Salvar alterações</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}