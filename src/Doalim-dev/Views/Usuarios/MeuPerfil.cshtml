@model Doalim_dev.Models.Usuario
@using Doalim_dev.Models

@{
    ViewData["Title"] = "Meu Perfil";
    var ehAdmin = Model.TipoUsuario == TipoUsuario.Admin;
    var ehDoador = ViewBag.EhDoador == true;
    var ehBeneficiario = ViewBag.EhBeneficiario == true;
    var temComprovacao = Model.ArquivoComprovacao != null && Model.ArquivoComprovacao.Length > 0;
    var foto = Model.FotoPerfil != null && Model.FotoPerfil.Length > 0
        ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.FotoPerfil)}"
        : string.Empty;
}

<section class="profile-shell">
    <div class="profile-header">
        <div>
            <span class="admin-eyebrow">Conta</span>
            <h1>Meu Perfil</h1>
            <p>Atualize seus dados, envie sua comprovacao e ative os perfis que deseja usar.</p>
        </div>
        <div class="profile-badges">
            <span class="admin-pill">@Model.TipoUsuario</span>
            <span class="admin-status @(ehAdmin ? "status-neutral" : Model.StatusVerificacao == StatusVerificacao.Aprovado ? "status-success" : Model.StatusVerificacao == StatusVerificacao.Rejeitado ? "status-danger" : "status-warning")">
                @(ehAdmin ? "Comprovacao dispensada" : Model.StatusVerificacao)
            </span>
        </div>
    </div>

    <form asp-controller="Usuarios" asp-action="MeuPerfil" method="post" enctype="multipart/form-data" class="profile-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="IdUsuario" />
            <input type="hidden" asp-for="SenhaHash" />
            <input type="hidden" asp-for="TipoUsuario" />
            <input type="hidden" asp-for="StatusVerificacao" />
            <input type="hidden" asp-for="Ativo" />
            <input type="hidden" asp-for="DataCadastro" />

            <div class="admin-form-section">
                <h2>Dados principais</h2>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Telefone" class="form-label"></label>
                        <input asp-for="Telefone" class="form-control" />
                        <span asp-validation-for="Telefone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Nova senha</label>
                        <input type="password" name="NovaSenha" id="campoNovaSenha"
                               class="form-control" autocomplete="new-password" placeholder="Opcional" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Confirmar nova senha</label>
                        <input type="password" name="ConfirmaNovaSenha" id="campoConfirmaNovaSenha"
                               class="form-control" autocomplete="new-password" placeholder="Repita a nova senha" />
                        <div id="avisoSenha" class="text-danger small mt-1" style="display:none;">
                            As senhas não conferem.
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Bio" class="form-label">Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="3" maxlength="300"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="admin-form-section">
                <h2>Documentos privados</h2>
                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.Cpf))
                    {
                        <div class="col-md-6">
                            <label asp-for="Cpf" class="form-label"></label>
                            <input asp-for="Cpf" class="form-control bg-secondary-subtle" readonly />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Cnpj))
                    {
                        <div class="col-md-6">
                            <label asp-for="Cnpj" class="form-label"></label>
                            <input asp-for="Cnpj" class="form-control bg-secondary-subtle" readonly />
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label">Foto de perfil</label>
                        <input type="file" name="arquivoFotoPerfil" class="form-control" accept=".png,.jpg,.jpeg" />
                        <div class="form-text">PNG, JPG ou JPEG ate 2MB.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Arquivo de comprovacao</label>
                        @if (ehAdmin)
                        {
                            <div class="form-control bg-secondary-subtle">Admin nao precisa de comprovacao</div>
                        }
                        else
                        {
                            <input type="file" name="arquivoComprovacao" class="form-control" accept=".png,.jpg,.jpeg,.pdf" />
                            <div class="form-text">PNG, JPG, JPEG ou PDF ate 5MB.</div>
                        }
                    </div>
                    @if (!ehAdmin && temComprovacao)
                    {
                        <div class="col-12">
                            <a href="@Url.Action("VerComprovacao", "Usuarios", new { id = Model.IdUsuario })"
                               target="_blank" rel="noopener" class="admin-doc-link">
                                <i class="bi bi-paperclip"></i>
                                Ver comprovacao enviada
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="admin-form-section">
                <h2>Endereco</h2>
                <div class="alert alert-info py-2 small mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    Todos os campos de endereço são obrigatórios para salvar: CEP, logradouro, número, bairro, cidade e estado.
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <input name="Endereco.Cep" class="form-control" placeholder="CEP" id="cep" value="@Model.Endereco?.Cep" maxlength="9" />
                    </div>
                    <div class="col-md-8">
                        <input name="Endereco.Logradouro" class="form-control" placeholder="Logradouro" id="logradouro" value="@Model.Endereco?.Logradouro" />
                    </div>
                    <div class="col-md-3">
                        <input name="Endereco.Numero" class="form-control" placeholder="Numero" value="@Model.Endereco?.Numero" />
                    </div>
                    <div class="col-md-5">
                        <input name="Endereco.Complemento" class="form-control" placeholder="Complemento" value="@Model.Endereco?.Complemento" />
                    </div>
                    <div class="col-md-4">
                        <input name="Endereco.Bairro" class="form-control" placeholder="Bairro" id="bairro" value="@Model.Endereco?.Bairro" />
                    </div>
                    <div class="col-md-8">
                        <input name="Endereco.Cidade" class="form-control" placeholder="Cidade" id="cidade" value="@Model.Endereco?.Cidade" />
                    </div>
                    <div class="col-md-4">
                        <input name="Endereco.Estado" class="form-control" placeholder="UF" id="estado" value="@Model.Endereco?.Estado" maxlength="2" />
                    </div>
                </div>
            </div>

            @if (!ehAdmin)
            {
                <div class="alert alert-warning d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                    <div>
                        Para doar ou reservar, envie a comprovacao e aguarde aprovacao do admin.
                    </div>
                </div>
            }

            <div class="profile-submit">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check2-circle"></i>
                    Salvar alteracoes
                </button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function alternarSenha(id, btn) {
            const input = document.getElementById(id);
            const icon  = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        // Validação de confirmação de senha em tempo real
        const novaSenhaInput    = document.getElementById('campoNovaSenha');
        const confirmaSenhaInput = document.getElementById('campoConfirmaNovaSenha');
        const avisoSenha        = document.getElementById('avisoSenha');

        function verificarSenhas() {
            if (confirmaSenhaInput.value && novaSenhaInput.value !== confirmaSenhaInput.value) {
                avisoSenha.style.display = 'block';
                confirmaSenhaInput.setCustomValidity('As senhas não conferem.');
            } else {
                avisoSenha.style.display = 'none';
                confirmaSenhaInput.setCustomValidity('');
            }
        }

        novaSenhaInput?.addEventListener('input',    verificarSenhas);
        confirmaSenhaInput?.addEventListener('input', verificarSenhas);

        // Busca automática pelo CEP (ViaCEP)
        document.getElementById('cep')?.addEventListener('blur', async function () {
            const cep = this.value.replace(/\D/g, '');
            if (cep.length !== 8) return;
            const res  = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
            const data = await res.json();
            if (data.erro) return;
            document.getElementById('logradouro').value = data.logradouro;
            document.getElementById('bairro').value     = data.bairro;
            document.getElementById('cidade').value     = data.localidade;
            document.getElementById('estado').value     = data.uf;
        });
    </script>
}
