@model Doalim_dev.Models.Usuario
@using Doalim_dev.Models

@{
    ViewData["Title"] = "Meu Perfil";
    var ehAdmin = Model.TipoUsuario == TipoUsuario.Admin;
    var ehDoador = ViewBag.EhDoador == true;
    var ehBeneficiario = ViewBag.EhBeneficiario == true;
    var temComprovacao = Model.ArquivoComprovacao != null && Model.ArquivoComprovacao.Length > 0;
    var foto = Model.FotoPerfil != null && Model.FotoPerfil.Length > 0
        ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.FotoPerfil)}"
        : string.Empty;
    var inicialNome = !string.IsNullOrWhiteSpace(Model.Nome) ? Model.Nome.Trim()[0].ToString().ToUpper() : "?";
    var statusVerifClass = ehAdmin ? "status-neutral"
                         : Model.StatusVerificacao == StatusVerificacao.Aprovado ? "status-success"
                         : Model.StatusVerificacao == StatusVerificacao.Rejeitado ? "status-danger"
                         : "status-warning";
}

<style>
    .profile-avatar-wrapper {
        position: relative;
        display: inline-block;
        cursor: pointer;
    }
    .profile-avatar-img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #dee2e6;
        display: block;
    }
    .profile-avatar-placeholder {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: #198754;
        color: #fff;
        font-size: 2.4rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #dee2e6;
    }
    .profile-avatar-edit-btn {
        position: absolute;
        bottom: 4px;
        right: 4px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #198754;
        color: #fff;
        border: 2px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        box-shadow: 0 2px 6px rgba(0,0,0,.2);
        transition: background .15s;
    }
    .profile-avatar-edit-btn:hover { background: #146c43; }
    .comprovacao-card-existing {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 14px 16px;
        background: #f8f9fa;
    }
    .comprovacao-upload-area {
        border: 2px dashed #a5d6a7;
        border-radius: 10px;
        background: #f8fbf6;
        cursor: pointer;
        padding: 14px 16px;
        transition: border-color .15s, background .15s;
    }
    .comprovacao-upload-area:hover {
        border-color: #198754;
        background: #f0faf0;
    }
</style>

<section class="profile-shell">
    <div class="profile-header">
        <div>
            <span class="admin-eyebrow">Conta</span>
            <h1>Meu Perfil</h1>
            <p>Atualize seus dados, envie sua comprovação e ative os perfis que deseja usar.</p>
        </div>
        <div class="profile-badges">
            <span class="admin-pill">@Model.TipoUsuario</span>
            <span class="admin-status @statusVerifClass">
                @(ehAdmin ? "Comprovação dispensada" : Model.StatusVerificacao)
            </span>
        </div>
    </div>

    <form asp-controller="Usuarios" asp-action="MeuPerfil" method="post" enctype="multipart/form-data" class="profile-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <input type="hidden" asp-for="IdUsuario" />
        <input type="hidden" asp-for="SenhaHash" />
        <input type="hidden" asp-for="TipoUsuario" />
        <input type="hidden" asp-for="StatusVerificacao" />
        <input type="hidden" asp-for="Ativo" />
        <input type="hidden" asp-for="DataCadastro" />

        @* ── Foto de perfil – estilo rede social ── *@
        <div class="admin-form-section">
            <h2>Foto de perfil</h2>
            <div class="d-flex align-items-start gap-4 flex-wrap justify-content-between">

                @* Lado esquerdo: avatar + nome *@
                <div class="d-flex align-items-center gap-4">
                    <div class="profile-avatar-wrapper" onclick="document.getElementById('arquivoFotoPerfil').click()" title="Clique para alterar a foto">
                        @if (!string.IsNullOrEmpty(foto))
                        {
                            <img id="fotoPreview" src="@foto" alt="Foto de perfil" class="profile-avatar-img" />
                        }
                        else
                        {
                            <div id="fotoPreview" class="profile-avatar-placeholder">@inicialNome</div>
                        }
                        <span class="profile-avatar-edit-btn">
                            <i class="bi bi-camera-fill"></i>
                        </span>
                    </div>
                    <div>
                        <div class="fw-semibold fs-5">@Model.Nome</div>
                        <div class="text-muted small mt-1">Clique na foto para selecionar uma nova imagem.</div>
                        <div class="text-muted small">PNG, JPG ou JPEG até 2 MB.</div>
                    </div>
                </div>

                @* Lado direito: avaliações recebidas *@
                @if (!ehAdmin)
                {
                    var notaMedia       = ViewBag.NotaMedia as double?;
                    var totalAvaliacoes = (int)(ViewBag.TotalAvaliacoes ?? 0);

                    @if (notaMedia.HasValue && totalAvaliacoes > 0)
                    {
                        <div class="row g-2 text-center" style="max-width:260px;">
                            <div class="col">
                                <div class="bg-light rounded-3 p-3">
                                    <div class="text-muted small">Nota média</div>
                                    <div class="fw-bold fs-4">@notaMedia.Value.ToString("0.0")</div>
                                    <div class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(notaMedia.Value))
                                            { <i class="bi bi-star-fill"></i> }
                                            else if (i - notaMedia.Value < 1)
                                            { <i class="bi bi-star-half"></i> }
                                            else
                                            { <i class="bi bi-star"></i> }
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="bg-light rounded-3 p-3">
                                    <div class="text-muted small">Avaliações</div>
                                    <div class="fw-bold fs-4">@totalAvaliacoes</div>
                                    <div class="text-muted small">recebidas</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="border rounded-3 p-3 text-center text-muted small align-self-center" style="max-width:220px;">
                            <i class="bi bi-star me-1"></i>
                            Ainda sem avaliações recebidas.
                        </div>
                    }
                }

            </div>
            <input type="file" id="arquivoFotoPerfil" name="arquivoFotoPerfil" class="d-none" accept=".png,.jpg,.jpeg" />
        </div>

        <div class="admin-form-section">
            <h2>Dados principais</h2>
            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Telefone" class="form-label"></label>
                    <input asp-for="Telefone" class="form-control" />
                    <span asp-validation-for="Telefone" class="text-danger small"></span>
                </div>
                <div class="col-md-7">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Nova senha</label>
                    <input type="password" name="NovaSenha" id="campoNovaSenha"
                           class="form-control" autocomplete="new-password" placeholder="Opcional" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Confirmar nova senha</label>
                    <input type="password" name="ConfirmaNovaSenha" id="campoConfirmaNovaSenha"
                           class="form-control" autocomplete="new-password" placeholder="Repita a nova senha" />
                    <div id="avisoSenha" class="text-danger small mt-1" style="display:none;">
                        As senhas não conferem.
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Bio" class="form-label">Bio</label>
                    <textarea asp-for="Bio" class="form-control" rows="3" maxlength="300"></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="admin-form-section">
            <h2>Documentos privados</h2>
            <div class="row g-3">
                @if (!string.IsNullOrEmpty(Model.Cpf))
                {
                    <div class="col-md-6">
                        <label asp-for="Cpf" class="form-label"></label>
                        <input asp-for="Cpf" class="form-control bg-secondary-subtle" readonly />
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Cnpj))
                {
                    <div class="col-md-6">
                        <label asp-for="Cnpj" class="form-label"></label>
                        <input asp-for="Cnpj" class="form-control bg-secondary-subtle" readonly />
                    </div>
                }

                @* ── Arquivo de comprovação ── *@
                <div class="col-12">
                    <label class="form-label fw-semibold">Arquivo de comprovação</label>
                    @if (ehAdmin)
                    {
                        <div class="form-control bg-secondary-subtle">Administrador não precisa de comprovação</div>
                    }
                    else if (temComprovacao)
                    {
                        <div class="comprovacao-card-existing" id="comprovacaoExistente">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <i class="bi bi-file-earmark-check-fill text-success flex-shrink-0" style="font-size:2rem;"></i>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold text-dark">Comprovação enviada</div>
                                    <div class="mt-1 small">
                                        Status:
                                        <span class="admin-status @statusVerifClass" style="font-size:.78rem; padding:2px 8px;">@Model.StatusVerificacao</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 flex-shrink-0">
                                    <a href="@Url.Action("VerComprovacao", "Usuarios", new { id = Model.IdUsuario })"
                                       target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>Visualizar
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnRemoverComprovacao">
                                        <i class="bi bi-trash me-1"></i>Remover
                                    </button>
                                </div>
                            </div>

                            <div id="avisoRemocao" class="alert alert-warning mt-3 mb-0" style="display:none;">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Atenção:</strong> Ao remover e enviar um novo arquivo, seu cadastro passará por uma nova análise do administrador.
                                Suas informações serão mantidas, mas você precisará aguardar a aprovação novamente para continuar usando o sistema.
                                <div class="d-flex gap-2 mt-2">
                                    <button type="button" class="btn btn-sm btn-danger" id="btnConfirmarRemocao">
                                        <i class="bi bi-trash me-1"></i>Confirmar remoção
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCancelarRemocao">
                                        Cancelar
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div id="novoArquivoArea" class="mt-3" style="display:none;">
                            <input type="hidden" name="removerComprovacao" value="true" />
                            <label class="form-label small fw-semibold mb-2">Novo arquivo de comprovação</label>
                            <div class="comprovacao-upload-area" onclick="document.getElementById('inputNovaComprovacao').click()">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="d-flex align-items-center justify-content-center rounded flex-shrink-0"
                                         style="width:44px;height:44px;background:#e8f5e9;">
                                        <i class="bi bi-file-earmark-arrow-up text-success" style="font-size:1.4rem;"></i>
                                    </div>
                                    <div>
                                        <div id="novaComprovacaoNomeLabel" class="fw-semibold small" style="color:#2e7d32;">
                                            Clique para anexar um documento
                                        </div>
                                        <div class="text-muted" style="font-size:.78rem;">
                                            Formatos aceitos: PDF, JPG, PNG &bull; Máx. 5 MB
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <input type="file" id="inputNovaComprovacao" name="arquivoComprovacao"
                                   class="d-none" accept=".png,.jpg,.jpeg,.pdf" />
                        </div>
                    }
                    else
                    {
                        <div class="comprovacao-upload-area" onclick="document.getElementById('inputComprovacao').click()">
                            <div class="d-flex align-items-center gap-3">
                                <div class="d-flex align-items-center justify-content-center rounded flex-shrink-0"
                                     style="width:44px;height:44px;background:#e8f5e9;">
                                    <i class="bi bi-file-earmark-arrow-up text-success" style="font-size:1.4rem;"></i>
                                </div>
                                <div>
                                    <div id="comprovacaoNomeLabel" class="fw-semibold small" style="color:#2e7d32;">
                                        Clique para anexar um documento
                                    </div>
                                    <div class="text-muted" style="font-size:.78rem;">
                                        Formatos aceitos: PDF, JPG, PNG &bull; Máx. 5 MB
                                    </div>
                                </div>
                            </div>
                        </div>
                        <input type="file" id="inputComprovacao" name="arquivoComprovacao"
                               class="d-none" accept=".png,.jpg,.jpeg,.pdf" />
                    }
                </div>
            </div>
        </div>

        <div class="admin-form-section">
            <h2>Endereço</h2>
            <div class="alert alert-info py-2 small mb-2">
                <i class="bi bi-info-circle me-1"></i>
                Todos os campos de endereço são obrigatórios para salvar: CEP, logradouro, número, bairro, cidade e estado.
            </div>
            <div class="row g-2">
                <div class="col-md-4">
                    <input name="Endereco.Cep" class="form-control" placeholder="CEP" id="cep" value="@Model.Endereco?.Cep" maxlength="9" />
                </div>
                <div class="col-md-8">
                    <input name="Endereco.Logradouro" class="form-control" placeholder="Logradouro" id="logradouro" value="@Model.Endereco?.Logradouro" />
                </div>
                <div class="col-md-3">
                    <input name="Endereco.Numero" class="form-control" placeholder="Número" value="@Model.Endereco?.Numero" />
                </div>
                <div class="col-md-5">
                    <input name="Endereco.Complemento" class="form-control" placeholder="Complemento" value="@Model.Endereco?.Complemento" />
                </div>
                <div class="col-md-4">
                    <input name="Endereco.Bairro" class="form-control" placeholder="Bairro" id="bairro" value="@Model.Endereco?.Bairro" />
                </div>
                <div class="col-md-8">
                    <input name="Endereco.Cidade" class="form-control" placeholder="Cidade" id="cidade" value="@Model.Endereco?.Cidade" />
                </div>
                <div class="col-md-4">
                    <input name="Endereco.Estado" class="form-control" placeholder="UF" id="estado" value="@Model.Endereco?.Estado" maxlength="2" />
                </div>
            </div>
        </div>

        @if (!ehAdmin)
        {
            <div class="alert alert-warning d-flex align-items-start gap-2">
                <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                <div>
                    Para doar ou reservar, envie a comprovação e aguarde a aprovação do administrador.
                </div>
            </div>
        }

        <div class="profile-submit">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check2-circle"></i>
                Salvar alterações
            </button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Pré-visualização da foto de perfil ao selecionar arquivo
        document.getElementById('arquivoFotoPerfil').addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                const preview = document.getElementById('fotoPreview');
                if (preview.tagName === 'IMG') {
                    preview.src = e.target.result;
                } else {
                    const img = document.createElement('img');
                    img.id = 'fotoPreview';
                    img.src = e.target.result;
                    img.className = 'profile-avatar-img';
                    img.alt = 'Foto de perfil';
                    preview.replaceWith(img);
                }
            };
            reader.readAsDataURL(file);
        });

        // Remoção da comprovação com confirmação
        const btnRemover  = document.getElementById('btnRemoverComprovacao');
        const avisoRemocao = document.getElementById('avisoRemocao');
        const btnConfirmar = document.getElementById('btnConfirmarRemocao');
        const btnCancelar  = document.getElementById('btnCancelarRemocao');
        const novoArquivo  = document.getElementById('novoArquivoArea');

        if (btnRemover) {
            btnRemover.addEventListener('click', function () {
                avisoRemocao.style.display = 'block';
                btnRemover.disabled = true;
            });
        }
        if (btnCancelar) {
            btnCancelar.addEventListener('click', function () {
                avisoRemocao.style.display = 'none';
                btnRemover.disabled = false;
            });
        }
        if (btnConfirmar) {
            btnConfirmar.addEventListener('click', function () {
                document.getElementById('comprovacaoExistente').style.display = 'none';
                novoArquivo.style.display = 'block';
            });
        }

        // Exibe nome do arquivo de comprovação ao selecionar
        var inputComprovacao = document.getElementById('inputComprovacao');
        if (inputComprovacao) {
            inputComprovacao.addEventListener('change', function () {
                var label = document.getElementById('comprovacaoNomeLabel');
                if (label && this.files && this.files[0]) {
                    label.innerHTML = '<i class="bi bi-file-earmark-check me-1"></i>' + this.files[0].name;
                    label.style.color = '#198754';
                }
            });
        }
        var inputNovaComprovacao = document.getElementById('inputNovaComprovacao');
        if (inputNovaComprovacao) {
            inputNovaComprovacao.addEventListener('change', function () {
                var label = document.getElementById('novaComprovacaoNomeLabel');
                if (label && this.files && this.files[0]) {
                    label.innerHTML = '<i class="bi bi-file-earmark-check me-1"></i>' + this.files[0].name;
                    label.style.color = '#198754';
                }
            });
        }

        // Validação de confirmação de senha em tempo real
        const novaSenhaInput     = document.getElementById('campoNovaSenha');
        const confirmaSenhaInput = document.getElementById('campoConfirmaNovaSenha');
        const avisoSenha         = document.getElementById('avisoSenha');

        function verificarSenhas() {
            if (confirmaSenhaInput.value && novaSenhaInput.value !== confirmaSenhaInput.value) {
                avisoSenha.style.display = 'block';
                confirmaSenhaInput.setCustomValidity('As senhas não conferem.');
            } else {
                avisoSenha.style.display = 'none';
                confirmaSenhaInput.setCustomValidity('');
            }
        }

        novaSenhaInput?.addEventListener('input',    verificarSenhas);
        confirmaSenhaInput?.addEventListener('input', verificarSenhas);

        // Busca automática pelo CEP (ViaCEP)
        document.getElementById('cep')?.addEventListener('blur', async function () {
            const cep = this.value.replace(/\D/g, '');
            if (cep.length !== 8) return;
            const res  = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
            const data = await res.json();
            if (data.erro) return;
            document.getElementById('logradouro').value = data.logradouro;
            document.getElementById('bairro').value     = data.bairro;
            document.getElementById('cidade').value     = data.localidade;
            document.getElementById('estado').value     = data.uf;
        });
    </script>
}
