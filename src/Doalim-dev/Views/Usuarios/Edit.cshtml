@model Doalim_dev.Models.Usuario

@{
    ViewData["Title"] = "Editar usuário";
}

<section class="admin-dashboard">
    <div class="admin-page-header">
        <div>
            <span class="admin-eyebrow">Edição administrativa</span>
            <h1>Editar usuário</h1>
            <p>Atualize cadastro, perfil de acesso e validação de documentação.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-success">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>
    </div>

    <form asp-action="Edit" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="IdUsuario" />

        <div class="admin-form-main">
            <div class="admin-form-section">
                <h2>Dados principais</h2>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TipoUsuario" class="form-label"></label>
                        <select asp-for="TipoUsuario" class="form-select" asp-items="Html.GetEnumSelectList<TipoUsuario>()"></select>
                        <span asp-validation-for="TipoUsuario" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="SenhaHash" class="form-label">Nova senha</label>
                        <div class="input-group">
                            <input name="SenhaHash" id="SenhaHash" class="form-control" type="password" value=""
                                   placeholder="Deixe em branco para manter" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="alternarSenha('SenhaHash', this)" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <small class="text-muted">Preencha apenas se quiser trocar a senha.</small>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Telefone" class="form-label"></label>
                        <input asp-for="Telefone" class="form-control" />
                        <span asp-validation-for="Telefone" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <h6 class="text-muted mt-2">Endereço</h6>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">CEP</label>
                        <input name="Endereco.Cep" class="form-control" id="cep" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Logradouro</label>
                        <input name="Endereco.Logradouro" class="form-control" id="logradouro" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Número</label>
                        <input name="Endereco.Numero" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Complemento</label>
                        <input name="Endereco.Complemento" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bairro</label>
                        <input name="Endereco.Bairro" class="form-control" id="bairro" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Cidade</label>
                        <input name="Endereco.Cidade" class="form-control" id="cidade" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">UF</label>
                        <input name="Endereco.Estado" class="form-control" id="estado" maxlength="2" />
                    </div>
                </div>
            </div>

            <div class="admin-form-section">
                <h2>Documentação</h2>
                <div class="row g-3">
                    <div class="col-md-6" data-field="cpf">
                        <label asp-for="Cpf" class="form-label"></label>
                        <input asp-for="Cpf" class="form-control" />
                        <span asp-validation-for="Cpf" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6" data-field="cnpj">
                        <label asp-for="Cnpj" class="form-label"></label>
                        <input asp-for="Cnpj" class="form-control" />
                        <span asp-validation-for="Cnpj" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Foto do Perfil</label>
                        <input type="file" name="FotoPerfilUpload" class="form-control" accept="image/*" />
                        <small class="text-muted">Deixe em branco para manter a foto atual.</small>
                    </div>
                    <div class="col-md-6" data-field="documento">
                        <label class="form-label">Arquivo de Comprovação</label>
                        <input type="file" name="ArquivoComprovacaoUpload" class="form-control" accept=".pdf,.jpg,.png" />
                        <small class="text-muted">Deixe em branco para manter o arquivo atual.</small>
                    </div>
                    <div class="col-md-6" data-field="status-doc">
                        <label asp-for="StatusVerificacao" class="form-label"></label>
                        <select asp-for="StatusVerificacao" class="form-select" asp-items="Html.GetEnumSelectList<StatusVerificacao>()"></select>
                        <span asp-validation-for="StatusVerificacao" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label d-block">Situação da conta</label>
                        <div class="form-check form-switch admin-switch">
                            <input asp-for="Ativo" class="form-check-input" />
                            <label asp-for="Ativo" class="form-check-label">Conta ativa</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <aside class="admin-form-side">
            <div class="admin-side-panel">
                <i class="bi bi-person-gear"></i>
                <strong>Perfil de acesso</strong>
                <p>Se mudar o tipo para <b>Admin</b>, o vínculo administrativo é criado automaticamente.</p>
            </div>
            <button type="submit" class="btn btn-success w-100">
                <i class="bi bi-save"></i>
                Salvar alterações
            </button>
        </aside>
    </form>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        const tipoUsuario = document.getElementById('TipoUsuario');
        const camposCpf = document.querySelectorAll('[data-field="cpf"]');
        const camposCnpj = document.querySelectorAll('[data-field="cnpj"]');

        function atualizarCamposAdmin() {
            const valor = tipoUsuario.value;
            const ehPf = valor === '0' || valor === '2';
            const ehPj = valor === '1' || valor === '3';

            camposCpf.forEach(campo => campo.style.display = ehPf ? '' : 'none');
            camposCnpj.forEach(campo => campo.style.display = ehPj ? '' : 'none');
        }

        tipoUsuario.addEventListener('change', atualizarCamposAdmin);
        atualizarCamposAdmin();

        // Busca automática de endereço pelo CEP (ViaCEP)
        document.getElementById('cep')?.addEventListener('blur', async function () {
            const cep = this.value.replace(/\D/g, '');
            if (cep.length !== 8) return;

            const res = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
            const data = await res.json();
            if (data.erro) return;

            document.getElementById('logradouro').value = data.logradouro;
            document.getElementById('bairro').value     = data.bairro;
            document.getElementById('cidade').value     = data.localidade;
            document.getElementById('estado').value     = data.uf;
        });

        function alternarSenha(id, btn) {
            const input = document.getElementById(id);
            const icon  = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>

}
