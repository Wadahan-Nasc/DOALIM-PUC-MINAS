@model IEnumerable<Doalim_dev.Models.Usuario>

@{
    ViewData["Title"] = "Administração de usuários";

    var usuarios = Model.ToList();
    var doadores = ViewBag.Doadores as HashSet<int> ?? new HashSet<int>();
    var beneficiarios = ViewBag.Beneficiarios as HashSet<int> ?? new HashSet<int>();
    var busca = ViewBag.Busca as string;

    var bloqueados = usuarios
        .Where(u => !UsuarioRegras.TemComprovacaoAprovada(u))
        .OrderByDescending(u => !string.IsNullOrWhiteSpace(u.Arquivocomprovacao))
        .ThenBy(u => u.Nome)
        .ToList();

    var aprovados = usuarios
        .Where(UsuarioRegras.TemComprovacaoAprovada)
        .OrderBy(u => u.Nome)
        .ToList();

    var semArquivo = usuarios.Count(u => UsuarioRegras.PrecisaComprovacao(u) && string.IsNullOrWhiteSpace(u.Arquivocomprovacao));
    var pendentes = usuarios.Count(u => UsuarioRegras.PrecisaComprovacao(u) && !string.IsNullOrWhiteSpace(u.Arquivocomprovacao) && u.StatusVerificacao == StatusVerificacao.Pendente);
    var ativos = usuarios.Count(u => u.Ativo);
    var administradores = usuarios.Count(u => u.TipoUsuario == TipoUsuario.Admin);
}

@functions {
    private static string Iniciais(string nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "US";
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return ((partes[0][0].ToString()) + (partes.Length > 1 ? partes[^1][0].ToString() : string.Empty)).ToUpperInvariant();
    }

    private string ArquivoUrl(string arquivo)
    {
        if (string.IsNullOrWhiteSpace(arquivo)) return string.Empty;
        if (arquivo.StartsWith("http", StringComparison.OrdinalIgnoreCase) || arquivo.StartsWith("/")) return arquivo;
        return Url.Content($"~/{arquivo.TrimStart('~', '/')}");
    }

    private static string EmailPrivado(string email)
    {
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@')) return "E-mail cadastrado";
        var partes = email.Split('@');
        var nome = partes[0].Length <= 2 ? partes[0][0] + "*" : partes[0][..2] + "***";
        return $"{nome}@{partes[1]}";
    }

    private static string ClasseStatus(StatusVerificacao status)
    {
        return status switch
        {
            StatusVerificacao.Aprovado => "status-success",
            StatusVerificacao.Rejeitado => "status-danger",
            StatusVerificacao.Pendente => "status-warning",
            _ => "status-neutral"
        };
    }

    private static string TextoDocumento(Usuario usuario)
    {
        if (!UsuarioRegras.PrecisaComprovacao(usuario)) return "Não aplicável";
        if (string.IsNullOrWhiteSpace(usuario.Arquivocomprovacao)) return "Sem arquivo";
        return usuario.StatusVerificacao switch
        {
            StatusVerificacao.Aprovado => "Aprovado",
            StatusVerificacao.Rejeitado => "Rejeitado",
            _ => "Aguardando análise"
        };
    }

    private static string TextoPerfis(int id, HashSet<int> doadores, HashSet<int> beneficiarios, Usuario usuario)
    {
        if (usuario.TipoUsuario == TipoUsuario.Admin) return "Admin";
        var perfis = new List<string>();
        if (doadores.Contains(id)) perfis.Add("Doador");
        if (beneficiarios.Contains(id)) perfis.Add("Beneficiário");
        return perfis.Any() ? string.Join(" + ", perfis) : "Sem perfil";
    }
}

<section class="admin-dashboard admin-dashboard-pro">
    <div class="admin-hero-panel">
        <div>
            <span class="admin-eyebrow">Painel administrativo</span>
            <h1>Usuários</h1>
            <p>Valide documentos e acompanhe quem está liberado para doar ou reservar. Dados pessoais sensíveis ficam protegidos.</p>
        </div>
        <div class="admin-header-actions">
            <a asp-action="Create" asp-route-tipoUsuario="@TipoUsuario.Admin" class="btn btn-success">
                <i class="bi bi-shield-plus"></i>
                Novo administrador
            </a>
        </div>
    </div>

    <div class="admin-metrics admin-metrics-pro">
        <div class="admin-metric"><span>Total</span><strong>@usuarios.Count</strong><small>cadastros</small></div>
        <div class="admin-metric"><span>Ativos</span><strong>@ativos</strong><small>contas habilitadas</small></div>
        <div class="admin-metric metric-alert"><span>Pendentes</span><strong>@pendentes</strong><small>com arquivo enviado</small></div>
        <div class="admin-metric metric-danger"><span>Sem arquivo</span><strong>@semArquivo</strong><small>bloqueados</small></div>
        <div class="admin-metric"><span>Aprovados</span><strong>@aprovados.Count</strong><small>podem operar</small></div>
        <div class="admin-metric"><span>Admins</span><strong>@administradores</strong><small>equipe interna</small></div>
    </div>

    <form asp-action="Index" method="get" class="admin-search admin-search-pro">
        <div>
            <label for="busca" class="form-label">Pesquisar</label>
            <div class="admin-search-box">
                <i class="bi bi-search"></i>
                <input id="busca" name="busca" value="@busca" class="form-control" placeholder="Buscar por nome ou e-mail" />
            </div>
        </div>
        <button type="submit" class="btn btn-success"><i class="bi bi-search"></i> Pesquisar</button>
        @if (!string.IsNullOrWhiteSpace(busca))
        {
            <a asp-action="Index" class="btn btn-outline-success"><i class="bi bi-x-lg"></i> Limpar</a>
        }
    </form>

    <section class="admin-user-group admin-focus-section">
        <div class="admin-group-header">
            <div>
                <h2>Bloqueados ou aguardando validação</h2>
                <p>Sem arquivo ou sem aprovação, o usuário não pode doar nem reservar.</p>
            </div>
            <span class="admin-status status-warning">@bloqueados.Count cadastro(s)</span>
        </div>
        @await Html.PartialAsync("_UsuariosAdminTable", bloqueados, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
        {
            ["Doadores"] = doadores,
            ["Beneficiarios"] = beneficiarios,
            ["MostrarAcoes"] = true
        })
    </section>

    <section class="admin-user-group">
        <div class="admin-group-header">
            <div>
                <h2>Aprovados</h2>
                <p>Cadastros liberados para operar ou administradores internos.</p>
            </div>
            <span class="admin-status status-success">@aprovados.Count cadastro(s)</span>
        </div>
        @await Html.PartialAsync("_UsuariosAdminTable", aprovados, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
        {
            ["Doadores"] = doadores,
            ["Beneficiarios"] = beneficiarios,
            ["MostrarAcoes"] = false
        })
    </section>
</section>