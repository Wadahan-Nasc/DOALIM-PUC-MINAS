@model IEnumerable<Doalim_dev.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";

    var paginaAtual    = ViewBag.PaginaAtual  as int? ?? 1;
    var totalPaginas   = ViewBag.TotalPaginas as int? ?? 1;

    var usuarios = Model.ToList();
    var comuns   = usuarios.Where(u => u.TipoUsuario != TipoUsuario.Admin).ToList();
    var pendentes  = comuns.Count(u => u.StatusVerificacao == StatusVerificacao.Pendente
                                    && u.ArquivoComprovacao != null && u.ArquivoComprovacao.Length > 0);
    var semArquivo = comuns.Count(u => u.ArquivoComprovacao == null || u.ArquivoComprovacao.Length == 0);
    var aprovados  = comuns.Count(u => u.StatusVerificacao == StatusVerificacao.Aprovado);
}

@functions {
    private static string ClasseStatus(Usuario usuario)
    {
        if (usuario.TipoUsuario == TipoUsuario.Admin) return "status-neutral";
        return usuario.StatusVerificacao switch
        {
            StatusVerificacao.Aprovado  => "status-success",
            StatusVerificacao.Rejeitado => "status-danger",
            StatusVerificacao.Pendente  => "status-warning",
            _ => "status-neutral"
        };
    }

    private static string TextoStatus(Usuario usuario)
    {
        if (usuario.TipoUsuario == TipoUsuario.Admin) return "Não aplicável";
        if (usuario.ArquivoComprovacao == null || usuario.ArquivoComprovacao.Length == 0)
            return "Sem comprovação";
        return usuario.StatusVerificacao.ToString();
    }
}

<section class="admin-dashboard">
    <div class="admin-page-header">
        <div>
            <span class="admin-eyebrow">Administração</span>
            <h1>Usuários</h1>
            <p>Analise comprovações sem expor CPF, CNPJ, telefone, endereço ou senha. Use "Ver detalhes" para aprovar ou rejeitar.</p>
        </div>
        <div class="admin-header-actions">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-person-plus"></i>
                Novo usuário
            </a>
            <a asp-action="Create" asp-route-tipoUsuario="@TipoUsuario.Admin" class="btn btn-outline-success">
                <i class="bi bi-shield-plus"></i>
                Novo admin
            </a>
        </div>
    </div>

    <div class="admin-metrics">
        <div class="admin-metric">
            <span>Total</span>
            <strong>@usuarios.Count</strong>
        </div>
        <div class="admin-metric metric-alert">
            <span>Para analisar</span>
            <strong>@pendentes</strong>
        </div>
        <div class="admin-metric">
            <span>Sem arquivo</span>
            <strong>@semArquivo</strong>
        </div>
        <div class="admin-metric">
            <span>Aprovados</span>
            <strong>@aprovados</strong>
        </div>
    </div>

    <form method="get" style="display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,0.9fr) minmax(0,0.9fr) auto auto; gap:10px; align-items:end; margin-bottom:18px; padding:14px; border:1px solid #dce8d6; border-radius:8px; background:#f8fbf6;">
        <div>
            <label class="form-label" for="busca">Buscar</label>
            <div class="admin-search-box">
                <i class="bi bi-search"></i>
                <input id="busca" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Nome ou e-mail" />
            </div>
        </div>
        <div>
            <label class="form-label" for="tipo">Perfil</label>
            <select id="tipo" name="tipo" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Tipo as string))">Todos os perfis</option>
                <option value="DoadorPF"       selected="@(ViewBag.Tipo == "DoadorPF")">Doador PF</option>
                <option value="DoadorPJ"       selected="@(ViewBag.Tipo == "DoadorPJ")">Doador PJ</option>
                <option value="BeneficiarioPF" selected="@(ViewBag.Tipo == "BeneficiarioPF")">Beneficiário PF</option>
                <option value="BeneficiarioPJ" selected="@(ViewBag.Tipo == "BeneficiarioPJ")">Beneficiário PJ</option>
                <option value="Admin"          selected="@(ViewBag.Tipo == "Admin")">Administrador</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="status">Status</label>
            <select id="status" name="status" class="form-select">
                <option value=""          selected="@(string.IsNullOrEmpty(ViewBag.Status as string))">Todos os status</option>
                <option value="Pendente"  selected="@(ViewBag.Status == "Pendente")">Pendente</option>
                <option value="Aprovado"  selected="@(ViewBag.Status == "Aprovado")">Aprovado</option>
                <option value="Rejeitado" selected="@(ViewBag.Status == "Rejeitado")">Rejeitado</option>
                <option value="SemArquivo" selected="@(ViewBag.Status == "SemArquivo")">Sem arquivo</option>
            </select>
        </div>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-funnel"></i>
            Filtrar
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i>
            Limpar
        </a>
    </form>

    <div class="admin-table-wrap">
        <table class="table admin-users-table align-middle">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Perfil</th>
                    <th>Status</th>
                    <th>Comprovação</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in usuarios)
                {
                    var foto = item.FotoPerfil != null && item.FotoPerfil.Length > 0
                        ? $"data:image/jpeg;base64,{Convert.ToBase64String(item.FotoPerfil)}"
                        : string.Empty;
                    var mimeDoc   = UsuarioViewHelper.MimeDocumento(item.ArquivoComprovacao);
                    var documento = item.ArquivoComprovacao != null && item.ArquivoComprovacao.Length > 0
                        ? $"data:{mimeDoc};base64,{Convert.ToBase64String(item.ArquivoComprovacao)}"
                        : string.Empty;
                    var podeAprovar = item.TipoUsuario != TipoUsuario.Admin && !string.IsNullOrWhiteSpace(documento);

                    <tr>
                        <td>
                            <div class="admin-user-cell">
                                @if (!string.IsNullOrWhiteSpace(foto))
                                {
                                    <img src="@foto" alt="" class="admin-avatar" />
                                }
                                else
                                {
                                    <span class="admin-avatar">@UsuarioViewHelper.Iniciais(item.Nome)</span>
                                }
                                <div>
                                    <strong>@item.Nome</strong>
                                    <small>@UsuarioViewHelper.MascaraEmail(item.Email)</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="admin-pill">@item.TipoUsuario</span></td>
                        <td><span class="admin-status @ClasseStatus(item)">@TextoStatus(item)</span></td>
                        <td>
                            @if (item.TipoUsuario == TipoUsuario.Admin)
                            {
                                <span class="admin-status status-neutral">Dispensado</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(documento))
                            {
                                <a href="@documento" target="_blank" rel="noopener" class="admin-doc-link">
                                    <i class="bi bi-paperclip"></i>
                                    Abrir arquivo
                                </a>
                            }
                            else
                            {
                                <span class="admin-status status-warning">Sem arquivo enviado</span>
                            }
                        </td>
                        <td>
                            <div class="admin-row-actions">
                                <a asp-action="Details" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-eye"></i>
                                    Ver detalhes
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav class="d-flex justify-content-center mt-3" aria-label="Paginação de usuários">
            <ul class="pagination">
                <li class="page-item @(paginaAtual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-busca="@ViewBag.Busca"
                       asp-route-status="@ViewBag.Status"
                       asp-route-tipo="@ViewBag.Tipo"
                       asp-route-pagina="@(paginaAtual - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= totalPaginas; p++)
                {
                    <li class="page-item @(p == paginaAtual ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-busca="@ViewBag.Busca"
                           asp-route-status="@ViewBag.Status"
                           asp-route-tipo="@ViewBag.Tipo"
                           asp-route-pagina="@p">@p</a>
                    </li>
                }
                <li class="page-item @(paginaAtual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-busca="@ViewBag.Busca"
                       asp-route-status="@ViewBag.Status"
                       asp-route-tipo="@ViewBag.Tipo"
                       asp-route-pagina="@(paginaAtual + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</section>
