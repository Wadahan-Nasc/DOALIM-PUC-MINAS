@model Doalim_dev.Models.Usuario

@{
    ViewData["Title"] = "Detalhes do usuário";
    var foto      = Model.FotoPerfil != null && Model.FotoPerfil.Length > 0
        ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.FotoPerfil)}"
        : string.Empty;
    var mimeDoc   = UsuarioViewHelper.MimeDocumento(Model.ArquivoComprovacao);
    var documento = Model.ArquivoComprovacao != null && Model.ArquivoComprovacao.Length > 0
        ? $"data:{mimeDoc};base64,{Convert.ToBase64String(Model.ArquivoComprovacao)}"
        : string.Empty;
    var ehAdmin = Model.TipoUsuario == TipoUsuario.Admin;
}

@functions {
    private static string ClasseStatus(StatusVerificacao status) => status switch
    {
        StatusVerificacao.Aprovado  => "status-success",
        StatusVerificacao.Rejeitado => "status-danger",
        StatusVerificacao.Pendente  => "status-warning",
        _ => "status-neutral"
    };
}

<section class="admin-dashboard">
    <div class="admin-page-header">
        <div>
            <span class="admin-eyebrow">Análise de cadastro</span>
            <h1>@Model.Nome</h1>
            <p>Dados sensíveis permanecem privados. O administrador avalia apenas status e comprovação.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-success">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>
    </div>

    <div class="admin-profile">
        <div class="admin-profile-card">
            @if (!string.IsNullOrWhiteSpace(foto))
            {
                <img class="admin-profile-photo" src="@foto" alt="" />
            }
            else
            {
                <span class="admin-profile-photo admin-profile-initials">@UsuarioViewHelper.Iniciais(Model.Nome)</span>
            }
            <h2>@Model.Nome</h2>
            <span class="admin-pill">@Model.TipoUsuario</span>
            <span class="admin-status @(Model.Ativo ? "status-success" : "status-danger")">
                @(Model.Ativo ? "Ativo" : "Suspenso")
            </span>
        </div>

        <div class="admin-details-grid">
            <div class="admin-detail-section">
                <h2>Resumo público</h2>
                <dl>
                    <dt>E-mail</dt>
                    <dd>@UsuarioViewHelper.MascaraEmail(Model.Email)</dd>
                    <dt>Membro desde</dt>
                    <dd>@Model.DataCadastro.ToString("dd/MM/yyyy")</dd>
                    <dt>Bio</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Bio) ? "Não informada" : Model.Bio)</dd>
                </dl>
            </div>

            <div class="admin-detail-section">
                <h2>Comprovação</h2>
                <dl>
                    <dt>Status</dt>
                    <dd>
                        <span class="admin-status @(ehAdmin ? "status-neutral" : ClasseStatus(Model.StatusVerificacao))">
                            @(ehAdmin ? "Não aplicável" : Model.StatusVerificacao)
                        </span>
                    </dd>
                    <dt>Arquivo</dt>
                    <dd>
                        @if (ehAdmin)
                        {
                            <span class="admin-status status-neutral">Admin dispensado</span>
                        }
                        else if (Model.ArquivoComprovacao != null && Model.ArquivoComprovacao.Length > 0)
                        {
                            <a href="@Url.Action("VerComprovacao", "Usuarios", new { id = Model.IdUsuario })"
                               target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-paperclip"></i>
                                Abrir comprovação
                            </a>
                        }
                        else
                        {
                            <span class="admin-status status-warning">Aguardando envio</span>
                        }
                    </dd>
                </dl>

                @if (!ehAdmin && Model.ArquivoComprovacao != null && Model.ArquivoComprovacao.Length > 0)
                {
                    <div class="admin-detail-actions">
                        @if (Model.StatusVerificacao != StatusVerificacao.Aprovado)
                        {
                            <form asp-action="AtualizarStatusVerificacao" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.IdUsuario" />
                                <input type="hidden" name="status" value="@StatusVerificacao.Aprovado" />
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check2"></i>
                                    Aprovar
                                </button>
                            </form>
                        }
                        @if (Model.StatusVerificacao != StatusVerificacao.Rejeitado)
                        {
                            <form asp-action="AtualizarStatusVerificacao" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.IdUsuario" />
                                <input type="hidden" name="status" value="@StatusVerificacao.Rejeitado" />
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-x-lg"></i>
                                    Rejeitar
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
