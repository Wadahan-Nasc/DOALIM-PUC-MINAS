@model Doalim_dev.Models.Usuario

@{
    ViewData["Title"] = "Remover usuário";
}

<section class="admin-dashboard">
    <div class="admin-page-header">
        <div>
            <span class="admin-eyebrow">Remoção de cadastro</span>
            <h1>Remover usuário</h1>
            <p>Confira os dados antes de apagar este cadastro do sistema.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-success">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>
    </div>

    <div class="admin-profile">
        <div class="admin-profile-card">
            <span class="admin-profile-photo admin-profile-initials">@UsuarioViewHelper.Iniciais(Model.Nome)</span>
            <h2>@Model.Nome</h2>
            <span class="admin-pill">@Model.TipoUsuario</span>
            <span class="admin-status status-danger">Ação permanente</span>
        </div>

        <div class="admin-detail-section">
            <h2>Dados que serão removidos</h2>
            <dl>
                <dt>E-mail</dt>
                <dd>@Model.Email</dd>
                <dt>Telefone</dt>
                <dd>@Model.Telefone</dd>
                <dt>Documento</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Cpf) ? Model.Cnpj : Model.Cpf)</dd>
                <dt>Status</dt>
                <dd>@(Model.Ativo ? "Ativo" : "Suspenso")</dd>
            </dl>

            <form asp-action="Delete" class="admin-detail-actions">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdUsuario" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i>
                    Apagar usuário
                </button>
                <a asp-action="Index" class="btn btn-outline-success">Cancelar</a>
            </form>
        </div>
    </div>
</section>

