@model Doalim_dev.ViewModels.VitrineCompletaViewModel

@{
    ViewData["Title"] = "Vitrine";
    var usuarioLogado = ViewBag.UsuarioLogado == true;
    var usuarioBeneficiario = ViewBag.UsuarioBeneficiario == true;
    var usuarioAprovado = ViewBag.UsuarioAprovado == true;
    var podeReservar = ViewBag.PodeReservar == true;
    var ehBeneficiarioPF = ViewBag.EhBeneficiarioPF == true;
    var categorias = ViewBag.CategoriasVitrine as List<string> ?? new List<string>();
    var cidadeBeneficiario = ViewBag.CidadeBeneficiario as string;
}

<section class="vitrine-page-clean">
    <header class="vitrine-clean-header">
        <div>
            <span class="admin-eyebrow">Vitrine Doalim</span>
            <h1>Alimentos disponíveis</h1>
            <p>Consulte os itens ativos, filtre por necessidade e reserve quando sua conta estiver aprovada.</p>
        </div>
    </header>

    @if (usuarioLogado && !usuarioAprovado && usuarioBeneficiario)
    {
        <div class="vitrine-notice">
            <i class="bi bi-shield-exclamation"></i>
            <span>Para reservar, envie o arquivo de comprovação no seu perfil e aguarde a aprovação do administrador.</span>
            <a asp-controller="Usuarios" asp-action="MeuPerfil" class="btn btn-sm btn-outline-warning">Meu Perfil</a>
        </div>
    }

    <form method="get" asp-controller="Produtos" asp-action="Vitrine" class="vitrine-filter" id="formFiltroVitrine">
        <div class="vitrine-filter-title">
            <i class="bi bi-sliders"></i>
            <div>
                <strong>Filtrar vitrine</strong>
                <span>Busque por nome, categoria, quantidade, validade e localidade.</span>
            </div>
        </div>

        <div class="vitrine-filter-grid">
            <div>
                <label class="form-label">Buscar por nome</label>
                <input type="text" name="NomeBusca" value="@Model.Filtros.NomeBusca" class="form-control" placeholder="Arroz, feijão, macarrão..." />
            </div>
            <div>
                <label class="form-label">Categoria</label>
                <select name="Categoria" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Filtros.Categoria))">Todas</option>
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat" selected="@(Model.Filtros.Categoria == cat)">@cat</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Quantidade mínima</label>
                <input type="number" name="QuantidadeMinima" value="@Model.Filtros.QuantidadeMinima" class="form-control" min="0" placeholder="Ex: 10" />
            </div>
            <div>
                <label class="form-label">Validade</label>
                <select name="OrdemValidade" class="form-select">
                    <option value="asc" selected="@(Model.Filtros.OrdemValidade == "asc")">Mais próxima</option>
                    <option value="desc" selected="@(Model.Filtros.OrdemValidade == "desc")">Mais distante</option>
                </select>
            </div>
            <div class="vitrine-filter-actions">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-funnel"></i>
                    Filtrar
                </button>
                <a asp-controller="Produtos" asp-action="Vitrine" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i>
                    Limpar
                </a>
            </div>
        </div>

        @* Filtros de localidade — exibidos apenas para beneficiários logados *@
        @if (usuarioBeneficiario)
        {
            <div class="mt-3 pt-3 border-top" style="border-color:#dce8d6 !important;">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div class="form-check form-switch mb-0">
                        @* Hidden field garante que o valor "false" seja enviado quando o toggle estiver desativado *@
                        <input type="hidden" name="FiltrarPorCidade" value="false" />
                        <input class="form-check-input" type="checkbox" id="toggleCidade"
                               name="FiltrarPorCidade" value="true"
                               @(Model.Filtros.FiltrarPorCidade ? "checked" : "")
                               onchange="atualizarFiltroCidade(this.checked)" />
                        <label class="form-check-label fw-semibold" for="toggleCidade">
                            <i class="bi bi-geo-alt-fill text-success me-1"></i>
                            Visualizar apenas da minha cidade
                        </label>
                    </div>

                    @* Campos de cidade/bairro manual — aparecem quando o toggle está DESATIVADO *@
                    <div id="campoCidadeManual" class="d-flex gap-2 flex-wrap @(Model.Filtros.FiltrarPorCidade ? "d-none" : "")">
                        <div>
                            <input type="text" name="Cidade" value="@Model.Filtros.Cidade"
                                   class="form-control form-control-sm" style="width:180px;"
                                   placeholder="Cidade do doador" />
                        </div>
                        <div>
                            <input type="text" name="Bairro" value="@Model.Filtros.Bairro"
                                   class="form-control form-control-sm" style="width:160px;"
                                   placeholder="Bairro (opcional)" />
                        </div>
                    </div>

                    @* Campo de bairro quando filtro por cidade própria está ativo *@
                    <div id="campoBairroProximo" class="@(!Model.Filtros.FiltrarPorCidade ? "d-none" : "")">
                        <input type="text" name="Bairro" value="@Model.Filtros.Bairro"
                               class="form-control form-control-sm" style="width:180px;"
                               placeholder="Filtrar por bairro (opcional)" />
                    </div>
                </div>

                @if (string.IsNullOrWhiteSpace(cidadeBeneficiario) && Model.Filtros.FiltrarPorCidade)
                {
                    <p class="text-muted small mt-2 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Complete seu endereço em
                        <a asp-controller="Usuarios" asp-action="MeuPerfil" class="text-success fw-semibold">Meu Perfil</a>
                        para ativar o filtro por cidade.
                    </p>
                }
            </div>
        }

    </form>

    @if (!Model.Produtos.Any())
    {
        <div class="admin-empty-state">
            <i class="bi bi-search"></i>
            Nenhum alimento encontrado para os filtros aplicados.
        </div>
    }
    else
    {
        <div class="vitrine-grid">
            @foreach (var alimento in Model.Produtos)
            {
                var limiteDoUsuario = ehBeneficiarioPF
                    ? (alimento.LimitePF > 0 ? Math.Min(alimento.QuantidadeDisponivel, alimento.LimitePF) : alimento.QuantidadeDisponivel)
                    : (alimento.LimitePJ > 0 ? Math.Min(alimento.QuantidadeDisponivel, alimento.LimitePJ) : alimento.QuantidadeDisponivel);

                <article class="vitrine-card">
                    <div class="vitrine-card-media">
                        @if (!string.IsNullOrEmpty(alimento.FotoProduto))
                        {
                            <img src="@alimento.FotoProduto" alt="@alimento.Nome" />
                        }
                        else
                        {
                            <div class="vitrine-card-placeholder">
                                <i class="bi bi-basket"></i>
                            </div>
                        }
                    </div>

                    <div class="vitrine-card-body">
                        <div class="vitrine-card-top">
                            <span class="admin-pill">@alimento.Categoria</span>
                            <span class="vitrine-date">@alimento.DataValidade.ToString("dd/MM/yyyy")</span>
                        </div>
                        <h2>@alimento.Nome</h2>
                        <p>@alimento.MarcaProduto @(string.IsNullOrWhiteSpace(alimento.TipoArmazenamento) ? "" : $"• {alimento.TipoArmazenamento}")</p>

                        <div class="vitrine-card-facts">
                            <div>
                                <a href="#" onclick="abrirPerfilModal(@alimento.IdDoador); return false;"
                                   class="text-decoration-none text-dark fw-bold" title="Ver perfil do doador">
                                    @alimento.NomeDoador
                                    <i class="bi bi-person-circle ms-1 text-success" style="font-size:.85rem;"></i>
                                </a>
                                <span>doador</span>
                            </div>
                        </div>

                        @if (podeReservar && (ehBeneficiarioPF ? alimento.LimitePF : alimento.LimitePJ) > 0)
                        {
                            <small class="vitrine-limit">Limite @(ehBeneficiarioPF ? "PF" : "PJ"): @(ehBeneficiarioPF ? alimento.LimitePF : alimento.LimitePJ) unidade(s)</small>
                        }

                        <div class="vitrine-card-action">
                            @if (podeReservar)
                            {
                                <form asp-controller="Carrinho" asp-action="Adicionar" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idProduto" value="@alimento.IdProduto" />
                                    <input type="number"
                                           name="quantidade"
                                           value="1"
                                           min="1"
                                           max="@limiteDoUsuario"
                                           data-max="@limiteDoUsuario"
                                           data-tipo="@(ehBeneficiarioPF ? "PF" : "PJ")"
                                           class="form-control qtd-input" />
                                    <button type="submit" class="btn btn-success btn-adicionar">
                                        <i class="bi bi-cart-plus"></i>
                                        Adicionar
                                    </button>
                                    <small class="text-danger aviso-limite"></small>
                                </form>
                            }
                            else if (!usuarioLogado)
                            {
                                <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Url.Action("Vitrine", "Produtos")" class="btn btn-outline-success w-100">
                                    Entrar para reservar
                                </a>
                            }
                            else if (!usuarioAprovado)
                            {
                                <button type="button" class="btn btn-outline-warning w-100" disabled>Aguardando aprovação</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary w-100" disabled>Ative o perfil beneficiario</button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@* ── Modal de perfil público ─────────────────────────────────────────── *@
<div class="modal fade" id="modalPerfilPublico" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="modalPerfilNomeTitle">Perfil</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2" id="modalPerfilConteudo">
                <div class="text-center py-4">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function atualizarFiltroCidade(ativo) {
            var manual = document.getElementById('campoCidadeManual');
            var proximo = document.getElementById('campoBairroProximo');
            if (!manual || !proximo) return;
            if (ativo) {
                manual.classList.add('d-none');
                proximo.classList.remove('d-none');
                // Limpa campos manuais ao ativar o filtro automático
                manual.querySelectorAll('input').forEach(function(i){ i.value = ''; });
            } else {
                manual.classList.remove('d-none');
                proximo.classList.add('d-none');
                // Limpa bairro do modo automático
                proximo.querySelectorAll('input').forEach(function(i){ i.value = ''; });
            }
        }

        // ── Modal de perfil público ───────────────────────────────────────────
        function abrirPerfilModal(id) {
            var modalEl  = document.getElementById('modalPerfilPublico');
            var modal    = bootstrap.Modal.getOrCreateInstance(modalEl);
            var conteudo = document.getElementById('modalPerfilConteudo');
            var titulo   = document.getElementById('modalPerfilNomeTitle');

            conteudo.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-success" role="status"></div></div>';
            titulo.textContent = 'Carregando...';
            modal.show();

            fetch('/Usuarios/PerfilPublicoJson?id=' + id)
                .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                .then(function (d) {
                    titulo.textContent = d.nome;

                    // Estrelas
                    var estrelas = '';
                    if (d.notaMedia) {
                        for (var i = 1; i <= 5; i++) {
                            if (i <= Math.floor(d.notaMedia))
                                estrelas += '<i class="bi bi-star-fill"></i>';
                            else if (i - d.notaMedia < 1)
                                estrelas += '<i class="bi bi-star-half"></i>';
                            else
                                estrelas += '<i class="bi bi-star"></i>';
                        }
                    }

                    var fotoHtml = d.temFoto
                        ? '<img src="' + d.fotoUrl + '" class="rounded-circle object-fit-cover flex-shrink-0" style="width:72px;height:72px;" alt="" />'
                        : '<div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-success fs-4" style="width:72px;height:72px;">' + d.iniciais + '</div>';

                    var verificadoHtml = d.verificado
                        ? '<span class="badge rounded-pill text-success bg-success bg-opacity-10"><i class="bi bi-patch-check-fill me-1"></i>Verificado</span>'
                        : '';

                    var bioHtml = (d.bio && d.bio.trim())
                        ? '<p class="mt-2 mb-0 text-secondary" style="font-size:14px;line-height:1.6;">' + d.bio + '</p>'
                        : '<p class="mt-2 mb-0 text-muted fst-italic" style="font-size:14px;">Sem bio cadastrada.</p>';

                    var avaliacaoHtml = (d.notaMedia && d.totalAvaliacoes > 0)
                        ? '<hr class="my-3"/><div class="row g-2 text-center"><div class="col"><div class="bg-light rounded-3 p-2"><div class="text-muted small">Nota média</div><div class="fw-bold fs-5">' + d.notaMedia.toFixed(1) + '</div><div class="text-warning small">' + estrelas + '</div></div></div><div class="col"><div class="bg-light rounded-3 p-2"><div class="text-muted small">Avaliações</div><div class="fw-bold fs-5">' + d.totalAvaliacoes + '</div><div class="text-muted small">recebidas</div></div></div></div>'
                        : '<hr class="my-3"/><div class="border rounded-3 p-3 text-center text-muted small"><i class="bi bi-star me-1"></i>Ainda sem avaliações.</div>';

                    conteudo.innerHTML =
                        '<div class="d-flex gap-3 align-items-start">' +
                            fotoHtml +
                            '<div class="flex-grow-1">' +
                                '<div class="d-flex flex-wrap align-items-center gap-2 mb-1">' +
                                    verificadoHtml +
                                    '<span class="badge rounded-pill text-secondary bg-secondary bg-opacity-10">' + d.tipoLabel + '</span>' +
                                '</div>' +
                                '<p class="text-muted small mb-0"><i class="bi bi-calendar3 me-1"></i>Membro desde ' + d.membroDesde + '</p>' +
                                bioHtml +
                            '</div>' +
                        '</div>' +
                        avaliacaoHtml;
                })
                .catch(function () {
                    conteudo.innerHTML = '<div class="text-center text-muted py-3"><i class="bi bi-exclamation-circle me-2"></i>Não foi possível carregar o perfil.</div>';
                });
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.qtd-input').forEach(function (input) {
                input.addEventListener('input', function () {
                    const max = parseInt(this.dataset.max);
                    const tipo = this.dataset.tipo;
                    const val = parseInt(this.value);
                    const form = this.closest('form');
                    const btn = form.querySelector('.btn-adicionar');
                    const aviso = form.querySelector('.aviso-limite');

                    if (isNaN(val) || val < 1) {
                        aviso.textContent = 'A quantidade mínima é 1.';
                        btn.disabled = true;
                    } else if (val > max) {
                        aviso.textContent = 'Limite para ' + tipo + ': máximo ' + max + ' unidade(s).';
                        btn.disabled = true;
                    } else {
                        aviso.textContent = '';
                        btn.disabled = false;
                    }
                });
            });
        });
    </script>
}
