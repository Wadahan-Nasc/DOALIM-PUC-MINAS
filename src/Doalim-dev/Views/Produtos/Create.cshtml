@model Doalim_dev.Models.Produto

<style>
    .btn-doalim {
        background-color: #4CAF50;
        color: white;
        border: none;
    }

        .btn-doalim:hover {
            background-color: #43A047;
            color: white;
        }

    .border-doalim {
        border-top: 5px solid #4CAF50 !important;
    }

    .card-doalim {
        border-radius: 12px;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success fw-bold">Cadastrar Novo Alimento</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill fw-bold">Voltar para o Painel de Produtos</a>
    </div>
    <hr />

    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div id="alertaProdutoInativo" class="alert alert-danger border-danger shadow d-none mb-4" role="alert">
            <h4 class="fw-bold mb-1 text-danger">⚠️ Produto Inativo!</h4>
            <span class="text-dark">Você está cadastrando o produto com o status de inativo. <strong>Ele não aparecerá na contagem do estoque e nem ficará visível para doação.</strong></span>
        </div>

        <div class="row g-4">

            <div class="col-lg-6 order-2 order-lg-1">
                <div class="card card-doalim shadow-sm border-0 border-doalim h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-success mb-4 border-bottom pb-2">Informações Básicas</h5>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="NomeProduto" class="form-label fw-semibold"></label>
                                <input asp-for="NomeProduto" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CodigoBarras" class="form-label fw-semibold"></label>
                                <input asp-for="CodigoBarras" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MarcaProduto" class="form-label fw-semibold"></label>
                                <input asp-for="MarcaProduto" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoriaProduto" class="form-label fw-semibold"></label>
                                <input asp-for="CategoriaProduto" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TipoArmazenamento" class="form-label fw-semibold"></label>
                                <input asp-for="TipoArmazenamento" class="form-control bg-light" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="QuantidadePessoaFisica" class="form-label fw-semibold"></label>
                                <input asp-for="QuantidadePessoaFisica" type="number" min="0" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="QuantidadePessoaJuridica" class="form-label fw-semibold"></label>
                                <input asp-for="QuantidadePessoaJuridica" type="number" min="0" class="form-control bg-light" />
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="UnidadeMedida" class="form-label fw-semibold"></label>
                                <input asp-for="UnidadeMedida" class="form-control bg-light" placeholder="Kg, Unid..." />
                            </div>

                            <div class="col-md-12 mt-2 p-3 bg-light rounded border border-2">
                                <div class="form-check form-switch fs-5">
                                    <input asp-for="StatusProduto" class="form-check-input border-success" id="switchStatusProduto" checked />
                                    <label asp-for="StatusProduto" class="form-check-label fs-6 mt-1 ms-2 fw-bold text-dark">Status Produto</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 order-1 order-lg-2">
                <div class="card card-doalim shadow-sm border-0 border-doalim h-100">
                    <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center">
                        <h5 class="fw-bold text-success mb-4 border-bottom pb-2 w-100 text-start">Imagem do Produto</h5>
                        <div class="w-100 text-center mb-4 p-3 bg-light rounded d-flex align-items-center justify-content-center" style="border: 2px dashed #4CAF50; min-height: 380px;">
                            <img id="imgPreview" src="~/images/sem-foto.png" class="img-fluid rounded shadow-sm" style="max-height: 400px; width: 100%; object-fit: contain;" />
                        </div>
                        <div class="w-100 d-grid mt-auto">
                            <label for="fotoInput" class="btn btn-doalim btn-lg fw-bold py-2 shadow-sm rounded-pill">
                                Selecionar Imagem
                            </label>
                            <input type="file" name="arquivoFoto" id="fotoInput" class="d-none" accept="image/*" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card card-doalim shadow-sm border-0">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center p-4">
                        <h5 class="mb-0 fw-bold text-success">Gestão de Lotes Iniciais</h5>
                        <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-pill px-3" id="btnAddLote">
                            + Adicionar Lote
                        </button>
                    </div>

                    <div class="card-body bg-light rounded-bottom p-4" id="lotesContainer">

                        <div class="row lote-item align-items-end mb-3 pb-3 border-bottom border-secondary-subtle">

                            <div class="col-md-3 mb-2 mb-md-0">
                                <label class="form-label fw-semibold small">Número do Lote</label>
                                <input type="text" name="NumeroLote" class="form-control border-success-subtle" required />
                            </div>
                            <div class="col-md-3 mb-2 mb-md-0">
                                <label class="form-label fw-semibold small">Validade</label>
                                <input type="date" name="DataValidadeLote" class="form-control border-success-subtle" required />
                            </div>
                            <div class="col-md-2 mb-2 mb-md-0">
                                <label class="form-label fw-semibold small">Quantidade</label>
                                <input type="number" name="QuantidadeLote" class="form-control border-success-subtle" required min="1" />
                            </div>

                            <div class="col-md-2 mb-2 mb-md-0">
                                <label class="form-label fw-semibold small">Status do Lote</label>
                                <select name="StatusLote" class="form-select border-success-subtle fw-bold text-success" onchange="mudarCorStatusLote(this)">
                                    <option value="true" selected>✅ Ativo</option>
                                    <option value="false">❌ Inativo</option>
                                </select>
                            </div>

                            <div class="col-md-2 text-md-end">
                                <button type="button" class="btn btn-outline-danger w-100 btn-remove-lote rounded-pill" onclick="removerLote(this)" disabled>
                                    Remover
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4 mb-5">
            <div class="col-12 text-end">
                <button type="submit" class="btn btn-doalim btn-lg px-5 fw-bold shadow rounded-pill">
                    Salvar Produto e Lotes
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('fotoInput').addEventListener('change', function(evt) {
            const [file] = evt.target.files;
            if (file) {
                document.getElementById('imgPreview').src = URL.createObjectURL(file);
            }
        });

        const switchProduto = document.getElementById('switchStatusProduto');
        const alertaProduto = document.getElementById('alertaProdutoInativo');

        switchProduto.addEventListener('change', function() {
            if (!this.checked) alertaProduto.classList.remove('d-none');
            else alertaProduto.classList.add('d-none');
        });

        function mudarCorStatusLote(selectElement) {
            if(selectElement.value === "true") {
                selectElement.classList.add('text-success');
                selectElement.classList.remove('text-danger');
            } else {
                selectElement.classList.add('text-danger');
                selectElement.classList.remove('text-success');
            }
        }

        // Criador de Lotes
        document.getElementById('btnAddLote').addEventListener('click', function() {
            const container = document.getElementById('lotesContainer');
            const loteHtml = `
                <div class="row lote-item align-items-end mb-3 pb-3 border-bottom border-secondary-subtle">
                    <div class="col-md-3 mb-2 mb-md-0">
                        <label class="form-label fw-semibold small">Número do Lote</label>
                        <input type="text" name="NumeroLote" class="form-control border-success-subtle" required />
                    </div>
                    <div class="col-md-3 mb-2 mb-md-0">
                        <label class="form-label fw-semibold small">Validade</label>
                        <input type="date" name="DataValidadeLote" class="form-control border-success-subtle" required />
                    </div>
                    <div class="col-md-2 mb-2 mb-md-0">
                        <label class="form-label fw-semibold small">Quantidade</label>
                        <input type="number" name="QuantidadeLote" class="form-control border-success-subtle" required min="1" />
                    </div>
                    <div class="col-md-2 mb-2 mb-md-0">
                        <label class="form-label fw-semibold small">Status Lote</label>
                        <select name="StatusLote" class="form-select border-success-subtle fw-bold text-success" onchange="mudarCorStatusLote(this)">
                            <option value="true" selected>✅ Ativo</option>
                            <option value="false">❌ Inativo</option>
                        </select>
                    </div>
                    <div class="col-md-2 text-md-end">
                        <button type="button" class="btn btn-outline-danger w-100 btn-remove-lote rounded-pill" onclick="removerLote(this)">
                            Remover
                        </button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', loteHtml);

            atualizarBotoesRemover();
        });

        function removerLote(botao) {
            botao.closest('.lote-item').remove();
            atualizarBotoesRemover();
        }

        function atualizarBotoesRemover() {
            const botoes = document.querySelectorAll('.btn-remove-lote');
            if (botoes.length === 1) {
                botoes[0].disabled = true;
            } else {
                botoes.forEach(btn => btn.disabled = false);
            }
        }
    </script>
}