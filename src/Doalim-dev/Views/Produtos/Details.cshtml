@model Doalim_dev.Models.Produto

<div class="container mt-4">
    <h1>@Model.NomeProduto</h1>
    <hr />
    <div class="row">
        <div class="col-md-5">
            @if (Model.FotoProduto != null)
            {
                <img src="data:image/jpeg;base64,@(Convert.ToBase64String(Model.FotoProduto))" class="img-fluid rounded shadow" />
            }
            else
            {
                <div class="p-5 bg-light text-center border">Imagem não disponível</div>
            }
        </div>
        <div class="col-md-7">
            <dl class="row">
                <dt class="col-sm-4">Marca</dt>
                <dd class="col-sm-8">@Model.MarcaProduto</dd>
                <dt class="col-sm-4">Categoria</dt>
                <dd class="col-sm-8">@Model.CategoriaProduto</dd>
                <dt class="col-sm-4">Código de Barras</dt>
                <dd class="col-sm-8">@Model.CodigoBarras</dd>
                <dt class="col-sm-4">Quantidade</dt>
                <dd class="col-sm-8">@Model.Quantidade @Model.UnidadeMedida</dd>
                <dt class="col-sm-4">Validade</dt>
                <dd class="col-sm-8">@Model.DataValidade.ToShortDateString()</dd>
                <dt class="col-sm-4">Armazenamento</dt>
                <dd class="col-sm-8">@Model.TipoArmazenamento</dd>
                <dt class="col-sm-4">Cadastrado em</dt>
                <dd class="col-sm-8">@Model.DataCadastro</dd>
            </dl>
            <a asp-action="Edit" asp-route-id="@Model.IdProduto" class="btn btn-warning">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </div>
</div>