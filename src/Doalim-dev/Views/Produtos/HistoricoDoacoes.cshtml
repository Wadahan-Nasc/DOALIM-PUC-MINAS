@model Doalim_dev.ViewModels.HistoricoDoadorPageViewModel

@{
    ViewData["Title"] = "Histórico de Doações";
    var filtros = Model.Filtros;

    // Agrupamento por pedido, mais recentes primeiro
    var grupos = Model.Itens
        .GroupBy(i => i.IdPedido)
        .OrderByDescending(g => g.First().DataReserva)
        .ToList();
}

<style>
    .hist-card {
        border-radius: 12px;
        border: 1px solid #e0e0e0;
        overflow: hidden;
        transition: box-shadow .2s, transform .2s;
    }
    .hist-card:hover {
        box-shadow: 0 6px 20px rgba(0,0,0,.10);
        transform: translateY(-1px);
    }
    .hist-top-strip { height: 4px; }
    .info-label {
        font-size: .70rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #888;
        font-weight: 700;
    }
    .info-value {
        font-size: .9rem;
        font-weight: 600;
        color: #333;
    }
    .hist-produto-row {
        border-bottom: 1px solid #f0f0f0;
    }
    .hist-produto-row:last-child { border-bottom: none; }
    .hist-stat-card {
        border-radius: 12px;
        transition: box-shadow .2s;
    }
    .hist-stat-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,.09); }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1 fw-bold">Histórico de Doações</h2>
        <p class="text-muted mb-0">Reservas concluídas e rejeitadas dos seus produtos, agrupadas por pedido.</p>
    </div>
    <a asp-controller="Produtos" asp-action="GerenciarReservas" class="btn btn-outline-secondary">
        <i class="bi bi-clipboard-check me-1"></i> Gerenciar reservas
    </a>
</div>

@* ── Totalizadores ─────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-success shadow-sm h-100 hist-stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 flex-shrink-0">
                    <i class="bi bi-check-circle-fill text-success fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Doações concluídas</div>
                    <div class="fs-2 fw-bold text-success lh-1">@Model.TotalConcluidas</div>
                    <div class="text-muted" style="font-size:.78rem;">reservas retiradas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-primary shadow-sm h-100 hist-stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 flex-shrink-0">
                    <i class="bi bi-box-seam-fill text-primary fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Unidades doadas</div>
                    <div class="fs-2 fw-bold text-primary lh-1">@Model.TotalUnidadesDoadas</div>
                    <div class="text-muted" style="font-size:.78rem;">itens entregues</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-danger shadow-sm h-100 hist-stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3 flex-shrink-0">
                    <i class="bi bi-x-circle-fill text-danger fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Doações rejeitadas</div>
                    <div class="fs-2 fw-bold text-danger lh-1">@Model.TotalRejeitadas</div>
                    <div class="text-muted" style="font-size:.78rem;">reservas recusadas</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Filtros ───────────────────────────────────────────────────────── *@
<form method="get" asp-controller="Produtos" asp-action="HistoricoDoacoes"
      class="card p-3 mb-4 shadow-sm" style="border-radius:12px; background:#f9fbf9; border:1px solid #e8f5e9;">
    <div class="row g-2">

        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value=""          selected="@(string.IsNullOrEmpty(filtros.Status))">Todos</option>
                <option value="Retirada"  selected="@(filtros.Status == "Retirada")">Concluída</option>
                <option value="Rejeitada" selected="@(filtros.Status == "Rejeitada")">Rejeitada</option>
            </select>
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Categoria</label>
            <select name="Categoria" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(filtros.Categoria))">Todas</option>
                @foreach (var cat in ViewBag.CategoriasDisponiveis as List<string> ?? new List<string>())
                {
                    <option value="@cat" selected="@(filtros.Categoria == cat)">@cat</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Nome do produto</label>
            <input type="text" name="NomeProduto" value="@filtros.NomeProduto"
                   class="form-control form-control-sm" placeholder="Ex: Arroz, Feijão..." />
        </div>

        <div class="col-6 col-md-4">
            <label class="form-label fw-semibold small mb-1">Beneficiário</label>
            <input type="text" name="NomeBeneficiario" value="@filtros.NomeBeneficiario"
                   class="form-control form-control-sm" placeholder="Ex: João" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Validade — de</label>
            <input type="date" name="ValidadeInicio"
                   value="@filtros.ValidadeInicio?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Validade — até</label>
            <input type="date" name="ValidadeFim"
                   value="@filtros.ValidadeFim?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Data de reserva — de</label>
            <input type="date" name="DataReservaInicio"
                   value="@filtros.DataReservaInicio?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Data de reserva — até</label>
            <input type="date" name="DataReservaFim"
                   value="@filtros.DataReservaFim?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-12 d-flex justify-content-end gap-2 pt-1 border-top">
            <a asp-controller="Produtos" asp-action="HistoricoDoacoes"
               class="btn btn-outline-secondary btn-sm px-4">Limpar</a>
            <button type="submit" class="btn btn-success btn-sm px-4">
                <i class="bi bi-search me-1"></i> Filtrar
            </button>
        </div>

    </div>
</form>

@* ── Resultados ────────────────────────────────────────────────────── *@
@if (filtros.TemFiltroAtivo && !Model.Itens.Any())
{
    <div class="alert alert-info rounded-3">
        <i class="bi bi-info-circle me-2"></i>Nenhum registro encontrado para os filtros aplicados.
    </div>
}
else if (!Model.Itens.Any())
{
    <div class="alert alert-info rounded-3">
        <i class="bi bi-info-circle me-2"></i>Nenhuma doação concluída ou rejeitada até o momento.
    </div>
}
else
{
    @if (filtros.TemFiltroAtivo)
    {
        <p class="text-muted small mb-3">
            <i class="bi bi-funnel me-1"></i>
            Exibindo <strong>@grupos.Count</strong> pedido(s) — <strong>@Model.Itens.Count</strong> reserva(s) — com filtros ativos.
            <a asp-controller="Produtos" asp-action="HistoricoDoacoes" class="ms-1">Limpar filtros</a>
        </p>
    }
    else
    {
        <p class="text-muted small mb-3">
            <i class="bi bi-archive me-1"></i>
            <strong>@grupos.Count</strong> pedido(s) no histórico &mdash; <strong>@Model.Itens.Count</strong> reserva(s) no total.
        </p>
    }

    <div class="d-flex flex-column gap-3">
        @foreach (var grupo in grupos)
        {
            var rep   = grupo.First();
            var itens = grupo.ToList();

            var statusDistintos = itens.Select(i => i.StatusReserva).Distinct().ToList();
            var statusMisto     = statusDistintos.Count > 1;

            // Status representativo do grupo
            var grpStatus = statusMisto ? "Misto"
                : statusDistintos.First();

            var corStrip   = grpStatus == "Retirada"  ? "#198754"
                           : grpStatus == "Rejeitada" ? "#dc3545"
                           : "#ffc107";   // misto = amarelo

            var badgeClass = grpStatus == "Retirada"  ? "bg-success"
                           : grpStatus == "Rejeitada" ? "bg-danger"
                           : "bg-warning text-dark";

            var badgeIcon  = grpStatus == "Retirada"  ? "bi-check-circle-fill"
                           : grpStatus == "Rejeitada" ? "bi-x-circle-fill"
                           : "bi-arrow-left-right";

            var badgeLabel = grpStatus == "Retirada"  ? "Concluída"
                           : grpStatus == "Rejeitada" ? "Rejeitada"
                           : "Misto";

            <div class="card hist-card shadow-sm">

                @* Faixa colorida topo *@
                <div class="hist-top-strip" style="background:@corStrip;"></div>

                @* Cabeçalho do pedido *@
                <div class="card-header py-2 px-3" style="background:#fafafa;">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-bold" style="font-size:1rem;">
                                    <i class="bi bi-receipt me-1 text-success" style="font-size:.85rem;"></i>
                                    Pedido #@rep.IdPedido
                                </span>
                                <span class="badge @badgeClass">
                                    <i class="bi @badgeIcon me-1"></i>@badgeLabel
                                </span>
                                @if (statusMisto)
                                {
                                    <span class="badge bg-light text-muted border" style="font-size:.7rem;">
                                        <i class="bi bi-info-circle me-1"></i>Itens com status variado
                                    </span>
                                }
                            </div>
                            <div class="text-muted" style="font-size:.78rem;">
                                <i class="bi bi-person me-1"></i>
                                <strong>@rep.NomeBeneficiario</strong>
                                @if (rep.EhOng)
                                {
                                    <span class="badge bg-info ms-1" style="font-size:.68rem;">ONG</span>
                                }
                                &nbsp;&bull;&nbsp;
                                <i class="bi bi-calendar3 me-1"></i>Reservado em @rep.DataReserva.ToString("dd/MM/yyyy") às @rep.DataReserva.ToString("HH:mm")
                            </div>
                        </div>
                        <div class="text-end" style="font-size:.78rem; color:#888; white-space:nowrap;">
                            <div><strong>@itens.Count</strong> item(ns)</div>
                            @if (rep.DataEncerramento.HasValue)
                            {
                                <div>Encerrado: <strong>@rep.DataEncerramento.Value.ToString("dd/MM/yyyy")</strong></div>
                            }
                        </div>
                    </div>
                </div>

                @* Lista de produtos do pedido *@
                <div class="list-group list-group-flush">
                    @foreach (var item in itens)
                    {
                        <div class="list-group-item px-3 py-3 hist-produto-row">
                            <div class="row gx-5 gy-2 align-items-center">

                                @* Foto *@
                                <div class="col-auto">
                                    @if (!string.IsNullOrEmpty(item.FotoProduto))
                                    {
                                        <img src="@item.FotoProduto" alt="@item.NomeProduto"
                                             class="rounded"
                                             style="width:48px;height:48px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                             style="width:48px;height:48px;font-size:1.4rem;">&#127857;</div>
                                    }
                                </div>

                                @* Nome + marca *@
                                <div class="col-md-3">
                                    <div class="fw-semibold" style="font-size:.95rem; color:#1a2e1a;">@item.NomeProduto</div>
                                    <div class="text-muted small">@item.MarcaProduto &bull; @item.CategoriaProduto</div>
                                </div>

                                @* Qtd. *@
                                <div class="col-auto">
                                    <div class="info-label">Qtd.</div>
                                    <div class="info-value">@item.QuantidadeReservada</div>
                                </div>

                                @* U.M. *@
                                <div class="col-auto">
                                    <div class="info-label">U.M.</div>
                                    <div class="info-value">@item.UnidadeMedidaProduto</div>
                                </div>

                                @* Lote *@
                                <div class="col-auto">
                                    <div class="info-label">Lote</div>
                                    <div class="info-value">@item.NumeroLote</div>
                                </div>

                                @* Validade *@
                                <div class="col-auto">
                                    <div class="info-label">Validade</div>
                                    <div class="info-value">@item.DataValidadeLote.ToString("dd/MM/yyyy")</div>
                                </div>

                                @* Reserva *@
                                <div class="col-auto">
                                    <div class="info-label">Reserva</div>
                                    <div class="info-value text-success">#@item.IdReserva</div>
                                </div>

                                @* Badge por item — somente quando status misto no grupo *@
                                @if (statusMisto)
                                {
                                    <div class="col-auto ms-auto">
                                        @if (item.StatusReserva == "Retirada")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i>Concluída
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill me-1"></i>Rejeitada
                                            </span>
                                        }
                                    </div>
                                }

                            </div>

                            @* Motivo de rejeição, se houver *@
                            @if (item.StatusReserva == "Rejeitada" && !string.IsNullOrEmpty(item.MotivoRejeicao))
                            {
                                <div class="alert alert-danger py-1 px-2 mt-2 mb-0 rounded-3" style="font-size:.82rem;">
                                    <i class="bi bi-x-circle me-1"></i>
                                    <strong>Motivo da rejeição:</strong> @item.MotivoRejeicao
                                </div>
                            }

                        </div>
                    }
                </div>

            </div>
        }
    </div>
}

@section Scripts {
<script>
    // Ativa tooltips do Bootstrap (se houver)
    (function () {
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    })();
</script>
}
