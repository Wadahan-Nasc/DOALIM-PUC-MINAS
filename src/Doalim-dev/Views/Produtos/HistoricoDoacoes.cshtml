@model Doalim_dev.ViewModels.HistoricoDoadorPageViewModel

@{
    ViewData["Title"] = "Histórico de Doações";
    var filtros = Model.Filtros;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Histórico de Doações</h2>
        <p class="text-muted mb-0">Reservas concluídas e rejeitadas dos seus produtos.</p>
    </div>
    <a asp-controller="Produtos" asp-action="GerenciarReservas" class="btn btn-outline-secondary">
        <i class="bi bi-clipboard-check me-1"></i> Gerenciar reservas
    </a>
</div>

@* Totalizadores *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-success shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-check-circle-fill text-success fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Doações concluídas</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalConcluidas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-primary shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-box-seam-fill text-primary fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Unidades doadas</div>
                    <div class="fs-3 fw-bold text-primary">@Model.TotalUnidadesDoadas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-danger shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                    <i class="bi bi-x-circle-fill text-danger fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Doações rejeitadas</div>
                    <div class="fs-3 fw-bold text-danger">@Model.TotalRejeitadas</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Formulário de filtros *@
<form method="get" asp-controller="Produtos" asp-action="HistoricoDoacoes" class="card p-3 mb-4 shadow-sm bg-light">
    <div class="row g-3">

        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value=""          selected="@(string.IsNullOrEmpty(filtros.Status))">Todos</option>
                <option value="Retirada"  selected="@(filtros.Status == "Retirada")">✅ Concluída</option>
                <option value="Rejeitada" selected="@(filtros.Status == "Rejeitada")">❌ Rejeitada</option>
            </select>
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Categoria</label>
            <select name="Categoria" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(filtros.Categoria))">Todas</option>
                @foreach (var cat in ViewBag.CategoriasDisponiveis as List<string> ?? new List<string>())
                {
                    <option value="@cat" selected="@(filtros.Categoria == cat)">@cat</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Nome do produto</label>
            <input type="text" name="NomeProduto" value="@filtros.NomeProduto"
                   class="form-control form-control-sm" placeholder="Ex: Arroz, Feijão..." />
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Beneficiário</label>
            <input type="text" name="NomeBeneficiario" value="@filtros.NomeBeneficiario"
                   class="form-control form-control-sm" placeholder="Ex: João" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Validade — de</label>
            <input type="date" name="ValidadeInicio"
                   value="@filtros.ValidadeInicio?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Validade — até</label>
            <input type="date" name="ValidadeFim"
                   value="@filtros.ValidadeFim?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Data de reserva — de</label>
            <input type="date" name="DataReservaInicio"
                   value="@filtros.DataReservaInicio?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label fw-semibold small mb-1">Data de reserva — até</label>
            <input type="date" name="DataReservaFim"
                   value="@filtros.DataReservaFim?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-12 d-flex justify-content-end gap-2 pt-1 border-top">
            <a asp-controller="Produtos" asp-action="HistoricoDoacoes" class="btn btn-outline-secondary btn-sm px-4">
                Limpar
            </a>
            <button type="submit" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-search me-1"></i> Filtrar
            </button>
        </div>

    </div>
</form>

@* Resultados *@
@if (filtros.TemFiltroAtivo && !Model.Itens.Any())
{
    <div class="alert alert-info">Nenhum registro encontrado para os filtros aplicados.</div>
}
else if (!Model.Itens.Any())
{
    <div class="alert alert-info">Nenhuma doação concluída ou rejeitada até o momento.</div>
}
else
{
    @if (filtros.TemFiltroAtivo)
    {
        <p class="text-muted small mb-3">
            <i class="bi bi-funnel me-1"></i>
            Exibindo <strong>@Model.Itens.Count</strong> registro(s) com filtros ativos.
            <a asp-controller="Produtos" asp-action="HistoricoDoacoes" class="ms-1">Limpar filtros</a>
        </p>
    }

    <div class="card shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3" style="width:60px;">Foto</th>
                        <th>Produto</th>
                        <th>Lote / Validade</th>
                        <th class="text-center">Qtd.</th>
                            <th class="text-center">U.M.</th>
                        <th>Beneficiário</th>
                        <th>Reservado em</th>
                        <th>Encerrado em</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Itens)
                    {
                        <tr>
                            <td class="ps-3">
                                @if (!string.IsNullOrEmpty(item.FotoProduto))
                                {
                                    <img src="@item.FotoProduto" alt="@item.NomeProduto"
                                         class="rounded" style="width:44px;height:44px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                         style="width:44px;height:44px;font-size:1.4rem;">🍱</div>
                                }
                            </td>

                            <td>
                                <div class="fw-semibold">@item.NomeProduto</div>
                                <div class="text-muted small">@item.MarcaProduto &bull; @item.CategoriaProduto</div>
                            </td>

                            <td>
                                <div class="small">@item.NumeroLote</div>
                                <div class="text-muted small">Val: @item.DataValidadeLote.ToString("dd/MM/yyyy")</div>
                            </td>

                            <td class="text-center fw-semibold">@item.QuantidadeReservada</td>
                            <td class="text-center small text-muted">@item.UnidadeMedidaProduto</td>

                            <td>
                                <div>@item.NomeBeneficiario</div>
                                @if (item.EhOng)
                                {
                                    <span class="badge bg-info small">ONG</span>
                                }
                            </td>

                            <td class="small text-muted">
                                @item.DataReserva.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td class="small text-muted">
                                @(item.DataEncerramento.HasValue
                                    ? item.DataEncerramento.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "—")
                            </td>

                            <td class="text-center">
                                @if (item.StatusReserva == "Retirada")
                                {
                                    <span class="badge bg-success">✅ Concluída</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">❌ Rejeitada</span>
                                    @if (!string.IsNullOrEmpty(item.MotivoRejeicao))
                                    {
                                        <button type="button"
                                                class="btn btn-link btn-sm p-0 ms-1 text-danger"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="left"
                                                title="@item.MotivoRejeicao">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
    // Ativa tooltips do Bootstrap para o motivo de rejeição
    (function () {
        var tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltips.forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    })();
</script>
}
