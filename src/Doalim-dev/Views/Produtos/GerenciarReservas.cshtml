@model IEnumerable<Doalim_dev.ViewModels.GerenciarReservaDoadorViewModel>

@{
    ViewData["Title"] = "Gerenciar Reservas";
    var pendentes  = Model.Where(r => r.StatusReserva == "Pendente").ToList();
    var confirmadas = Model.Where(r => r.StatusReserva == "Confirmada").ToList();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Gerenciar Reservas</h2>
        <p class="text-muted mb-0">Reservas pendentes e confirmadas dos seus produtos.</p>
    </div>
    <a asp-controller="Produtos" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-box-seam me-1"></i> Meus produtos
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhuma reserva pendente ou confirmada no momento.</div>
}
else
{
    @if (pendentes.Any())
    {
        <h5 class="mb-3">
            <span class="badge bg-warning text-dark me-2">@pendentes.Count</span>
            Aguardando sua aprovação
        </h5>
        <div class="row g-3 mb-5">
            @foreach (var r in pendentes)
            {
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm @(r.LoteProximoVencimento ? "border-warning" : "")">
                        <div class="card-body">

                            <div class="d-flex gap-3 mb-3">
                                @if (!string.IsNullOrEmpty(r.FotoProduto))
                                {
                                    <img src="@r.FotoProduto" alt="@r.NomeProduto"
                                         class="rounded flex-shrink-0"
                                         style="width:64px;height:64px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:64px;height:64px;font-size:2rem;">🍱</div>
                                }
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <h6 class="mb-0 text-truncate">@r.NomeProduto</h6>
                                        <span class="badge bg-warning text-dark flex-shrink-0">Pendente</span>
                                    </div>
                                    <div class="text-muted small">@r.MarcaProduto &bull; @r.CategoriaProduto</div>
                                    @if (r.LoteProximoVencimento)
                                    {
                                        <span class="badge bg-warning text-dark mt-1">
                                            <i class="bi bi-exclamation-triangle me-1"></i> Lote vence em breve
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="row small mb-3">
                                <div class="col-6">
                                    <div class="text-muted">Lote</div>
                                    <div class="fw-semibold">@r.NumeroLote</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted">Validade</div>
                                    <div class="fw-semibold">@r.DataValidadeLote.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6 mt-2">
                                    <div class="text-muted">Quantidade</div>
                                    <div class="fw-semibold">@r.QuantidadeReservada <small class="text-muted fw-normal">@r.UnidadeMedidaProduto</small></div>
                                </div>
                                <div class="col-6 mt-2">
                                    <div class="text-muted">Pedido</div>
                                    <div class="fw-semibold">#@r.IdPedido</div>
                                </div>
                                <div class="col-6 mt-2">
                                    <div class="text-muted">Reservado em</div>
                                    <div>@r.DataReserva.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="col-6 mt-2">
                                    <div class="text-muted">Beneficiário</div>
                                    <div class="fw-semibold">
                                        @r.NomeBeneficiario
                                        @if (r.EhOng)
                                        {
                                            <span class="badge bg-info ms-1">ONG</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.TelefoneBeneficiario))
                                    {
                                        <div class="text-muted">@r.TelefoneBeneficiario</div>
                                    }
                                </div>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                @if (r.PodeAprovar)
                                {
                                    <button class="btn btn-success btn-sm"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#aprovar-@r.IdReserva">
                                        <i class="bi bi-check-circle me-1"></i> Aprovar
                                    </button>
                                }
                                @if (r.PodeRejeitar)
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#rejeitar-@r.IdReserva">
                                        <i class="bi bi-x-circle me-1"></i> Rejeitar
                                    </button>
                                }
                            </div>

                            @if (r.PodeRejeitar)
                            {
                                <div class="collapse mt-3" id="rejeitar-@r.IdReserva">
                                    <div class="card card-body bg-light border-danger">
                                        <h6 class="mb-3 text-danger">
                                            <i class="bi bi-x-circle me-1"></i> Informe o motivo da rejeição
                                        </h6>
                                        <form asp-controller="Produtos" asp-action="RejeitarReserva" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idReserva" value="@r.IdReserva" />
                                            <div class="mb-2">
                                                <textarea name="motivoRejeicao"
                                                          class="form-control form-control-sm"
                                                          rows="3"
                                                          maxlength="500"
                                                          placeholder="Ex: Produto já foi destinado a outra instituição, quantidade insuficiente no momento, etc."
                                                          required></textarea>
                                                <div class="text-muted small mt-1">Máximo 500 caracteres. O beneficiário verá esta mensagem.</div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-x2 me-1"></i> Confirmar rejeição
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#rejeitar-@r.IdReserva">
                                                    Cancelar
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }

                            @if (r.PodeAprovar)
                            {
                                <div class="collapse mt-3" id="aprovar-@r.IdReserva">
                                    <div class="card card-body bg-light border-success">
                                        <h6 class="mb-3 text-success">
                                            <i class="bi bi-calendar-range me-1"></i> Informe o intervalo de retirada
                                        </h6>
                                        <form asp-controller="Produtos" asp-action="AprovarReserva" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="IdReserva" value="@r.IdReserva" />
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold">Data início</label>
                                                    <input type="date" name="DataRetiradaInicio" class="form-control form-control-sm"
                                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                           max="@r.DataValidadeLote.ToString("yyyy-MM-dd")"
                                                           required />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold">Data fim</label>
                                                    <input type="date" name="DataRetiradaFim" class="form-control form-control-sm"
                                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                           max="@r.DataValidadeLote.ToString("yyyy-MM-dd")"
                                                           required />
                                                </div>
                                                <div class="col-12 text-muted small">
                                                    Validade do lote: <strong>@r.DataValidadeLote.ToString("dd/MM/yyyy")</strong>
                                                    — o intervalo não pode ultrapassar essa data.
                                                </div>
                                                <div class="col-12 d-flex gap-2">
                                                    <button type="submit" class="btn btn-success btn-sm">
                                                        <i class="bi bi-check2 me-1"></i> Confirmar aprovação
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#aprovar-@r.IdReserva">
                                                        Cancelar
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (confirmadas.Any())
    {
        <h5 class="mb-3">
            <span class="badge bg-success me-2">@confirmadas.Count</span>
            Aprovadas — aguardando retirada
        </h5>
        <div class="row g-3">
            @foreach (var r in confirmadas)
            {
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm @(r.RetiradaProxima ? "border-warning" : "border-success")">
                        <div class="card-body">

                            <div class="d-flex gap-3 mb-3">
                                @if (!string.IsNullOrEmpty(r.FotoProduto))
                                {
                                    <img src="@r.FotoProduto" alt="@r.NomeProduto"
                                         class="rounded flex-shrink-0"
                                         style="width:64px;height:64px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:64px;height:64px;font-size:2rem;">🍱</div>
                                }
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <h6 class="mb-0 text-truncate">@r.NomeProduto</h6>
                                        <span class="badge bg-success flex-shrink-0">Confirmada</span>
                                    </div>
                                    <div class="text-muted small">@r.MarcaProduto &bull; @r.CategoriaProduto</div>
                                    @if (r.RetiradaProxima)
                                    {
                                        <span class="badge bg-warning text-dark mt-1">
                                            <i class="bi bi-clock me-1"></i> Retirada próxima!
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="row small mb-3">
                                <div class="col-6">
                                    <div class="text-muted">Beneficiário</div>
                                    <div class="fw-semibold">
                                        @r.NomeBeneficiario
                                        @if (r.EhOng)
                                        {
                                            <span class="badge bg-info ms-1">ONG</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.TelefoneBeneficiario))
                                    {
                                        <div class="text-muted">@r.TelefoneBeneficiario</div>
                                    }
                                </div>
                                <div class="col-6">
                                    <div class="text-muted">Quantidade</div>
                                    <div class="fw-semibold">@r.QuantidadeReservada <small class="text-muted fw-normal">@r.UnidadeMedidaProduto</small></div>
                                </div>
                                <div class="col-6 mt-2">
                                    <div class="text-muted">Retirada de</div>
                                    <div>@r.DataRetiradaInicio?.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6 mt-2">
                                    <div class="text-muted">Retirada até</div>
                                    <div>@r.DataRetiradaFim?.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>

                            @if (r.PodeConfirmarEntrega)
                            {
                                <button class="btn btn-primary btn-sm"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#entregar-@r.IdReserva">
                                    <i class="bi bi-box-arrow-in-down me-1"></i> Confirmar entrega
                                </button>

                                <div class="collapse mt-3" id="entregar-@r.IdReserva">
                                    <div class="card card-body bg-light border-primary">
                                        <h6 class="mb-3 text-primary">
                                            <i class="bi bi-shield-check me-1"></i> Insira o token informado pelo beneficiário
                                        </h6>
                                        <form asp-controller="Produtos" asp-action="ConfirmarEntrega" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idReserva" value="@r.IdReserva" />
                                            <div class="d-flex gap-2">
                                                <input type="text" name="tokenInformado"
                                                       class="form-control form-control-sm font-monospace text-uppercase"
                                                       placeholder="Ex: A1B2C3D4"
                                                       maxlength="8"
                                                       autocomplete="off"
                                                       required />
                                                <button type="submit" class="btn btn-primary btn-sm flex-shrink-0">
                                                    <i class="bi bi-check2-circle me-1"></i> Confirmar
                                                </button>
                                            </div>
                                            <div class="text-muted small mt-1">O token é informado presencialmente pelo beneficiário no momento da retirada.</div>
                                        </form>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
