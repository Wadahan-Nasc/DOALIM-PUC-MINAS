@model Doalim_dev.ViewModels.GerenciarReservasPageViewModel

@{
    ViewData["Title"] = "Gerenciar Reservas";
    var pendentes  = Model.Pendentes;
    var confirmadas = Model.Confirmadas;
    var retiradas   = Model.Retiradas;
}

<style>
    .reserva-card-doador {
        border-radius: 12px;
        border: 1px solid #e0e0e0;
        transition: box-shadow .2s;
    }
    .reserva-card-doador:hover { box-shadow: 0 4px 16px rgba(0,0,0,.09); }
    .reserva-card-doador .top-strip {
        height: 4px;
        border-radius: 12px 12px 0 0;
    }
    .info-label {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #888;
        font-weight: 600;
    }
    .info-value {
        font-size: .88rem;
        font-weight: 600;
        color: #333;
    }
    .section-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 8px;
        margin-bottom: .75rem;
        font-size: .82rem;
    }
    .produto-row {
        border-bottom: 1px solid #f0f0f0;
        padding-bottom: 8px;
        margin-bottom: 8px;
    }
    .produto-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
        margin-bottom: 0;
    }
    .btn-star {
        cursor: pointer;
        line-height: 1;
        transition: transform .1s;
    }
    .btn-star:hover { transform: scale(1.2); }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1 fw-bold">Gerenciar Reservas</h2>
        <p class="text-muted mb-0">Reservas pendentes e confirmadas dos seus produtos.</p>
    </div>
    <a asp-controller="Produtos" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-box-seam me-1"></i> Meus produtos
    </a>
</div>

@* ──────── FILTROS ──────── *@
<form method="get" asp-controller="Produtos" asp-action="GerenciarReservas"
      class="card p-3 mb-4 shadow-sm" style="border-radius:12px; background:#f9fbf9; border:1px solid #e8f5e9;">
    <div class="row g-2">
        <div class="col-12 col-md-4">
            <label class="form-label fw-semibold small mb-1">Beneficiário</label>
            <input type="text" name="nomeBeneficiario"
                   value="@Model.FiltroNomeBeneficiario"
                   class="form-control form-control-sm"
                   placeholder="Nome do beneficiário..." />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Reservado de</label>
            <input type="date" name="dataInicio"
                   value="@Model.FiltroDataInicio?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Reservado até</label>
            <input type="date" name="dataFim"
                   value="@Model.FiltroDataFim?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label fw-semibold small mb-1">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value=""           selected="@(string.IsNullOrEmpty(Model.FiltroStatus))">Todos</option>
                <option value="Pendente"   selected="@(Model.FiltroStatus == "Pendente")">Pendente</option>
                <option value="Confirmada" selected="@(Model.FiltroStatus == "Confirmada")">Confirmada</option>
                <option value="Retirada"   selected="@(Model.FiltroStatus == "Retirada")">Retirada</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-success btn-sm px-3 flex-grow-1">
                <i class="bi bi-search me-1"></i>Filtrar
            </button>
            <a asp-controller="Produtos" asp-action="GerenciarReservas"
               class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </div>
</form>

@if (!pendentes.Any() && !confirmadas.Any() && !retiradas.Any())
{
    <div class="alert alert-info rounded-3">
        <i class="bi bi-info-circle me-2"></i>
        @if (Model.TemFiltroAtivo)
        {
            <span>Nenhuma reserva encontrada para os filtros aplicados.</span>
        }
        else
        {
            <span>Nenhuma reserva pendente, confirmada ou aguardando avaliação no momento.</span>
        }
    </div>
}

@* ──────── PENDENTES ──────── *@
@if (pendentes.Any())
{
    <div class="section-header bg-warning bg-opacity-10 border border-warning mb-2">
        <span class="badge bg-warning text-dark">@pendentes.GroupBy(r => r.IdPedido).Count()</span>
        <span class="fw-semibold text-warning-emphasis">
            <i class="bi bi-hourglass-split me-1"></i>Aguardando sua aprovação
        </span>
    </div>

    <div class="row g-3 mb-5">
        @foreach (var grupo in pendentes.GroupBy(r => r.IdPedido))
        {
            var rep = grupo.First();
            var grupoId = $"g{rep.IdPedido}";

            <div class="col-12 col-md-6">
                <div class="card reserva-card-doador shadow-sm h-100">
                    <div class="top-strip bg-warning"></div>
                    <div class="card-body p-3">

                        @* Cabeçalho *@
                        <div class="row g-2 align-items-center mb-3">
                            <div class="col">
                                <div class="info-label">Beneficiário</div>
                                <div class="info-value">
                                    <a href="#" onclick="abrirPerfilModal(@rep.IdUsuarioBeneficiario); return false;"
                                       class="text-decoration-none text-dark fw-bold">
                                        @rep.NomeBeneficiario
                                        <i class="bi bi-person-circle ms-1 text-success" style="font-size:.75rem;"></i>
                                    </a>
                                    @if (rep.EhOng) { <span class="badge bg-info ms-1" style="font-size:.7rem;">ONG</span> }
                                </div>
                                @if (!string.IsNullOrEmpty(rep.TelefoneBeneficiario))
                                {
                                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@rep.TelefoneBeneficiario</div>
                                }
                            </div>
                            <div class="col-auto text-end">
                                <div class="info-label">Pedido</div>
                                <div class="info-value">#@rep.IdPedido</div>
                                <div class="text-muted" style="font-size:.75rem;">@rep.DataReserva.ToString("dd/MM/yy HH:mm")</div>
                            </div>
                        </div>

                        @* Produtos *@
                        <div class="mb-3">
                            @foreach (var r in grupo)
                            {
                                <div class="produto-row py-2">
                                    <div class="row gx-5 gy-2 align-items-center">

                                        @* Foto *@
                                        <div class="col-auto">
                                            @if (!string.IsNullOrEmpty(r.FotoProduto))
                                            {
                                                <img src="@r.FotoProduto" alt="@r.NomeProduto"
                                                     class="rounded" style="width:44px;height:44px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                                     style="width:44px;height:44px;font-size:1.2rem;">&#127857;</div>
                                            }
                                        </div>

                                        @* Nome *@
                                        <div class="col-md-3">
                                            <div class="fw-semibold text-dark" style="font-size:.88rem;">@r.NomeProduto</div>
                                            <div class="text-muted" style="font-size:.78rem;">@r.MarcaProduto &bull; @r.CategoriaProduto</div>
                                            @if (r.LoteProximoVencimento)
                                            {
                                                <span class="badge bg-warning text-dark mt-1" style="font-size:.68rem;">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>Vence em breve
                                                </span>
                                            }
                                        </div>

                                        @* Qtd. *@
                                        <div class="col-auto">
                                            <div class="info-label">Qtd.</div>
                                            <div class="info-value">@r.QuantidadeReservada</div>
                                        </div>

                                        @* U.M. *@
                                        <div class="col-auto">
                                            <div class="info-label">U.M.</div>
                                            <div class="info-value">@r.UnidadeMedidaProduto</div>
                                        </div>

                                        @* Lote *@
                                        <div class="col-auto">
                                            <div class="info-label">Lote</div>
                                            <div class="info-value">@r.NumeroLote</div>
                                        </div>

                                        @* Validade *@
                                        <div class="col-auto">
                                            <div class="info-label">Validade</div>
                                            <div class="info-value">@r.DataValidadeLote.ToString("dd/MM/yyyy")</div>
                                        </div>

                                        @* Reserva *@
                                        <div class="col-auto">
                                            <div class="info-label">Reserva</div>
                                            <div class="info-value text-success">#@r.IdReserva</div>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>

                        @* Ações *@
                        <div class="d-flex gap-2 flex-wrap mb-1">
                            @if (rep.PodeAprovar)
                            {
                                <button class="btn btn-success btn-sm rounded-pill px-3" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#aprovar-@grupoId">
                                    <i class="bi bi-check-circle me-1"></i>Aprovar
                                    @if (grupo.Count() > 1) { <span class="badge bg-white text-success ms-1">@grupo.Count() itens</span> }
                                </button>
                            }
                            @if (rep.PodeRejeitar)
                            {
                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#rejeitar-@grupoId">
                                    <i class="bi bi-x-circle me-1"></i>Rejeitar
                                </button>
                            }
                        </div>

                        @* Painel: Rejeitar com seleção por item *@
                        @if (rep.PodeRejeitar)
                        {
                            <div class="collapse mt-3" id="rejeitar-@grupoId">
                                <div class="card card-body rounded-3 bg-danger bg-opacity-10 border-danger">
                                    <h6 class="mb-1 text-danger"><i class="bi bi-x-circle me-1"></i>Rejeitar itens</h6>
                                    <p class="text-muted small mb-3">
                                        Todos marcados por padrão. Desmarque os que deseja <strong>manter</strong>.
                                    </p>
                                    <form asp-controller="Produtos" asp-action="RejeitarItens" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idPedido" value="@rep.IdPedido" />
                                        @if (grupo.Count() > 1)
                                        {
                                            <div class="mb-3">
                                                @foreach (var r in grupo)
                                                {
                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input chk-rejeitar-@grupoId"
                                                               type="checkbox" name="idsReservas"
                                                               value="@r.IdReserva" id="chk-@r.IdReserva" checked />
                                                        <label class="form-check-label" for="chk-@r.IdReserva">
                                                            <span class="fw-semibold">@r.NomeProduto</span>
                                                            <span class="text-muted small ms-1">@r.QuantidadeReservada @r.UnidadeMedidaProduto</span>
                                                        </label>
                                                    </div>
                                                }
                                                <div class="mt-1 mb-2">
                                                    <button type="button" class="btn btn-link btn-sm text-muted p-0"
                                                            onclick="toggleTodos('@grupoId', true)">
                                                        <i class="bi bi-check-all me-1"></i>Marcar todos
                                                    </button>
                                                    <span class="text-muted small mx-1">|</span>
                                                    <button type="button" class="btn btn-link btn-sm text-muted p-0"
                                                            onclick="toggleTodos('@grupoId', false)">
                                                        <i class="bi bi-x me-1"></i>Desmarcar todos
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="idsReservas" value="@rep.IdReserva" />
                                        }
                                        <div class="mb-2">
                                            <textarea name="motivoRejeicao" class="form-control form-control-sm"
                                                      rows="2" maxlength="500"
                                                      placeholder="Ex: Produto já foi destinado a outra instituição..."
                                                      required></textarea>
                                            <div class="text-muted small mt-1">Máx. 500 caracteres.</div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-danger btn-sm rounded-pill">
                                                <i class="bi bi-x-circle me-1"></i>Confirmar rejeição
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill"
                                                    data-bs-toggle="collapse" data-bs-target="#rejeitar-@grupoId">
                                                Cancelar
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }

                        @* Painel: Aprovar *@
                        @if (rep.PodeAprovar)
                        {
                            <div class="collapse mt-3" id="aprovar-@grupoId">
                                <div class="card card-body rounded-3 bg-success bg-opacity-10 border-success">
                                    <h6 class="mb-2 text-success">
                                        <i class="bi bi-calendar-range me-1"></i>Defina o intervalo de retirada
                                        @if (grupo.Count() > 1)
                                        {
                                            <small class="text-muted fw-normal d-block">Aplicado a todos os @grupo.Count() itens.</small>
                                        }
                                    </h6>
                                    <form asp-controller="Produtos" asp-action="AprovarReserva" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="IdReserva" value="@rep.IdReserva" />
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label small fw-semibold">Data início</label>
                                                <input type="date" name="DataRetiradaInicio" class="form-control form-control-sm"
                                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                       max="@grupo.Min(r => r.DataValidadeLote).ToString("yyyy-MM-dd")" required />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-semibold">Data fim</label>
                                                <input type="date" name="DataRetiradaFim" class="form-control form-control-sm"
                                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                       max="@grupo.Min(r => r.DataValidadeLote).ToString("yyyy-MM-dd")" required />
                                            </div>
                                            <div class="col-12 text-muted small">
                                                Validade mais próxima: <strong>@grupo.Min(r => r.DataValidadeLote).ToString("dd/MM/yyyy")</strong>
                                            </div>
                                            <div class="col-12 d-flex gap-2">
                                                <button type="submit" class="btn btn-success btn-sm rounded-pill">
                                                    <i class="bi bi-check2 me-1"></i>Confirmar aprovação
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill"
                                                        data-bs-toggle="collapse" data-bs-target="#aprovar-@grupoId">
                                                    Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
}

@* ──────── CONFIRMADAS ──────── *@
@if (confirmadas.Any())
{
    <div class="section-header bg-success bg-opacity-10 border border-success mb-2">
        <span class="badge bg-success">@confirmadas.GroupBy(r => r.IdPedido).Count()</span>
        <span class="fw-semibold text-success">
            <i class="bi bi-check-circle-fill me-1"></i>Aprovadas — aguardando retirada
        </span>
    </div>

    <div class="row g-3 mb-5">
        @foreach (var grupo in confirmadas.GroupBy(r => r.IdPedido))
        {
            var rep = grupo.First();
            var grupoId = $"c{rep.IdPedido}";
            var retiradaProxima = grupo.Any(r => r.RetiradaProxima);

            <div class="col-12 col-md-6">
                <div class="card reserva-card-doador shadow-sm h-100 @(retiradaProxima ? "border-warning" : "")">
                    <div class="top-strip @(retiradaProxima ? "bg-warning" : "bg-success")"></div>
                    <div class="card-body p-3">

                        @* Cabeçalho *@
                        <div class="row g-2 align-items-start mb-3">
                            <div class="col">
                                <div class="info-label">Beneficiário</div>
                                <div class="info-value">
                                    <a href="#" onclick="abrirPerfilModal(@rep.IdUsuarioBeneficiario); return false;"
                                       class="text-decoration-none text-dark fw-bold">
                                        @rep.NomeBeneficiario
                                        <i class="bi bi-person-circle ms-1 text-success" style="font-size:.75rem;"></i>
                                    </a>
                                    @if (rep.EhOng) { <span class="badge bg-info ms-1" style="font-size:.7rem;">ONG</span> }
                                </div>
                                @if (!string.IsNullOrEmpty(rep.TelefoneBeneficiario))
                                {
                                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@rep.TelefoneBeneficiario</div>
                                }
                            </div>
                            <div class="col-auto text-end">
                                <div class="d-flex gap-3 align-items-start justify-content-end">
                                    <div>
                                        <div class="info-label">Retirada de</div>
                                        <div class="info-value">@rep.DataRetiradaInicio?.ToString("dd/MM/yyyy")</div>
                                    </div>
                                    <div>
                                        <div class="info-label">Retirada até</div>
                                        <div class="info-value">@rep.DataRetiradaFim?.ToString("dd/MM/yyyy")</div>
                                    </div>
                                    <div>
                                        <div class="info-label">Pedido</div>
                                        <div class="info-value">#@rep.IdPedido</div>
                                    </div>
                                </div>
                                @if (retiradaProxima)
                                {
                                    <span class="badge bg-warning text-dark mt-1" style="font-size:.75rem;">
                                        <i class="bi bi-clock me-1"></i>Retirada próxima!
                                    </span>
                                }
                            </div>
                        </div>

                        @* Produtos *@
                        <div class="mb-3">
                            @foreach (var r in grupo)
                            {
                                <div class="produto-row py-2">
                                    <div class="row gx-5 gy-2 align-items-center">

                                        @* Foto *@
                                        <div class="col-auto">
                                            @if (!string.IsNullOrEmpty(r.FotoProduto))
                                            {
                                                <img src="@r.FotoProduto" alt="@r.NomeProduto"
                                                     class="rounded" style="width:44px;height:44px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                                     style="width:44px;height:44px;font-size:1.2rem;">&#127857;</div>
                                            }
                                        </div>

                                        @* Nome *@
                                        <div class="col-md-3">
                                            <div class="fw-semibold text-dark" style="font-size:.88rem;">@r.NomeProduto</div>
                                            <div class="text-muted" style="font-size:.78rem;">@r.MarcaProduto &bull; @r.CategoriaProduto</div>
                                        </div>

                                        @* Qtd. *@
                                        <div class="col-auto">
                                            <div class="info-label">Qtd.</div>
                                            <div class="info-value">@r.QuantidadeReservada</div>
                                        </div>

                                        @* U.M. *@
                                        <div class="col-auto">
                                            <div class="info-label">U.M.</div>
                                            <div class="info-value">@r.UnidadeMedidaProduto</div>
                                        </div>

                                        @* Lote *@
                                        <div class="col-auto">
                                            <div class="info-label">Lote</div>
                                            <div class="info-value">@r.NumeroLote</div>
                                        </div>

                                        @* Validade *@
                                        <div class="col-auto">
                                            <div class="info-label">Validade</div>
                                            <div class="info-value">@r.DataValidadeLote.ToString("dd/MM/yyyy")</div>
                                        </div>

                                        @* Reserva *@
                                        <div class="col-auto">
                                            <div class="info-label">Reserva</div>
                                            <div class="info-value text-success">#@r.IdReserva</div>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>

                        @* Confirmar entrega *@
                        @if (rep.PodeConfirmarEntrega)
                        {
                            <button class="btn btn-primary btn-sm rounded-pill px-3" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#entregar-@grupoId">
                                <i class="bi bi-box-arrow-in-down me-1"></i>Confirmar entrega
                            </button>
                            <div class="collapse mt-3" id="entregar-@grupoId">
                                <div class="card card-body rounded-3 bg-primary bg-opacity-10 border-primary">
                                    <h6 class="mb-2 text-primary">
                                        <i class="bi bi-shield-check me-1"></i>Token informado pelo beneficiário
                                    </h6>
                                    <form asp-controller="Produtos" asp-action="ConfirmarEntrega" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idReserva" value="@rep.IdReserva" />
                                        <div class="row g-2 align-items-end">
                                            <div class="col">
                                                <input type="text" name="tokenInformado"
                                                       class="form-control form-control-sm font-monospace text-uppercase"
                                                       placeholder="Ex: A1B2C3D4" maxlength="8"
                                                       autocomplete="off" required />
                                            </div>
                                            <div class="col-auto">
                                                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                                                    <i class="bi bi-check2-circle me-1"></i>Confirmar
                                                </button>
                                            </div>
                                        </div>
                                        <div class="text-muted small mt-1">Token informado presencialmente pelo beneficiário.</div>
                                    </form>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
}

@* ──────── RETIRADAS — avaliação pendente ──────── *@
@if (retiradas.Any())
{
    <div class="section-header bg-primary bg-opacity-10 border border-primary mb-2">
        <span class="badge bg-primary">@retiradas.GroupBy(r => r.IdPedido).Count()</span>
        <span class="fw-semibold text-primary">
            <i class="bi bi-bag-check-fill me-1"></i>Entregas concluídas — avalie os beneficiários
        </span>
    </div>

    <div class="row g-3 mb-5">
        @foreach (var grupo in retiradas.GroupBy(r => r.IdPedido))
        {
            var rep = grupo.First();

            <div class="col-12 col-md-6" id="avaliacao-card-pedido-@rep.IdPedido">
                <div class="card reserva-card-doador shadow-sm h-100">
                    <div class="top-strip bg-primary"></div>
                    <div class="card-body p-3">

                        @* Cabeçalho *@
                        <div class="row g-2 align-items-center mb-3">
                            <div class="col">
                                <div class="info-label">Beneficiário</div>
                                <div class="info-value">
                                    <a href="#" onclick="abrirPerfilModal(@rep.IdUsuarioBeneficiario); return false;"
                                       class="text-decoration-none text-dark fw-bold">
                                        @rep.NomeBeneficiario
                                        <i class="bi bi-person-circle ms-1 text-success" style="font-size:.75rem;"></i>
                                    </a>
                                    @if (rep.EhOng) { <span class="badge bg-info ms-1" style="font-size:.7rem;">ONG</span> }
                                </div>
                                @if (!string.IsNullOrEmpty(rep.TelefoneBeneficiario))
                                {
                                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@rep.TelefoneBeneficiario</div>
                                }
                            </div>
                            <div class="col-auto text-end">
                                <div class="info-label">Pedido</div>
                                <div class="info-value">#@rep.IdPedido</div>
                                <div class="text-muted" style="font-size:.75rem;">
                                    @rep.DataRetiradaInicio?.ToString("dd/MM") – @rep.DataRetiradaFim?.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                        </div>

                        @* Produtos entregues *@
                        <div class="mb-3">
                            @foreach (var r in grupo)
                            {
                                <div class="produto-row py-2">
                                    <div class="row gx-5 gy-2 align-items-center">

                                        @* Foto *@
                                        <div class="col-auto">
                                            @if (!string.IsNullOrEmpty(r.FotoProduto))
                                            {
                                                <img src="@r.FotoProduto" alt="@r.NomeProduto"
                                                     class="rounded" style="width:44px;height:44px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                                     style="width:44px;height:44px;font-size:1.2rem;">&#127857;</div>
                                            }
                                        </div>

                                        @* Nome *@
                                        <div class="col-md-3">
                                            <div class="fw-semibold text-dark" style="font-size:.88rem;">@r.NomeProduto</div>
                                            <div class="text-muted" style="font-size:.78rem;">@r.MarcaProduto &bull; @r.CategoriaProduto</div>
                                        </div>

                                        @* Qtd. *@
                                        <div class="col-auto">
                                            <div class="info-label">Qtd.</div>
                                            <div class="info-value">@r.QuantidadeReservada</div>
                                        </div>

                                        @* U.M. *@
                                        <div class="col-auto">
                                            <div class="info-label">U.M.</div>
                                            <div class="info-value">@r.UnidadeMedidaProduto</div>
                                        </div>

                                        @* Lote *@
                                        <div class="col-auto">
                                            <div class="info-label">Lote</div>
                                            <div class="info-value">@r.NumeroLote</div>
                                        </div>

                                        @* Reserva *@
                                        <div class="col-auto">
                                            <div class="info-label">Reserva</div>
                                            <div class="info-value text-success">#@r.IdReserva</div>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>

                        @* Avaliação inline — uma por pedido, usando o rep *@
                        <div class="border-top pt-3">
                            <div class="info-label mb-2"><i class="bi bi-star me-1"></i>Avaliar beneficiário</div>
                            <form method="post" asp-controller="Usuarios" asp-action="AvaliarUsuario"
                                  class="avaliacao-form d-flex align-items-center gap-2 mb-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idReserva" value="@rep.IdReserva" />
                                <div class="star-group d-flex gap-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <button type="button"
                                                class="btn-star p-0 border-0 bg-transparent text-secondary"
                                                data-nota="@i" title="@i estrela(s)">
                                            <i class="bi bi-star" style="font-size:1.4rem;"></i>
                                        </button>
                                    }
                                </div>
                                <input type="hidden" name="nota" class="nota-input" value="0" />
                                <button type="button"
                                        class="btn btn-warning btn-sm rounded-pill px-3 submit-btn"
                                        disabled title="Selecione uma nota"
                                        data-bs-toggle="modal" data-bs-target="#modalConfirmarAvaliacao">
                                    <i class="bi bi-check2 me-1"></i>Avaliar
                                </button>
                            </form>
                            <button type="button"
                                    class="btn btn-link btn-sm text-muted p-0 btn-pular-avaliacao"
                                    style="font-size:.78rem;"
                                    data-pedido="@rep.IdPedido"
                                    data-alvo="avaliacao-card-pedido-@rep.IdPedido">
                                <i class="bi bi-x me-1"></i>Não quero avaliar
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── Modal de perfil público ─────────────────────────────────────────── *@
<div class="modal fade" id="modalPerfilPublico" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="modalPerfilNomeTitle">Perfil</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2" id="modalPerfilConteudo">
                <div class="text-center py-4">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Modal de confirmação de avaliação *@
<div class="modal fade" id="modalConfirmarAvaliacao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body text-center p-4">
                <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center
                            justify-content-center mb-3" style="width:56px;height:56px;">
                    <i class="bi bi-star-fill text-warning" style="font-size:1.6rem;"></i>
                </div>
                <h6 class="fw-bold mb-1">Confirmar avaliação?</h6>
                <p class="text-muted small mb-4">
                    Você selecionou <strong id="textoNotaModal"></strong> estrela(s).<br>
                    <span class="text-danger fw-semibold">Esta avaliação não poderá ser alterada.</span>
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4"
                            data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-warning rounded-pill px-4 fw-semibold"
                            id="btnConfirmarAvaliacao">
                        <i class="bi bi-check2-circle me-1"></i>Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Modal de perfil público ───────────────────────────────────────────
    function abrirPerfilModal(id) {
        var modalEl  = document.getElementById('modalPerfilPublico');
        var modal    = bootstrap.Modal.getOrCreateInstance(modalEl);
        var conteudo = document.getElementById('modalPerfilConteudo');
        var titulo   = document.getElementById('modalPerfilNomeTitle');

        conteudo.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-success" role="status"></div></div>';
        titulo.textContent = 'Carregando...';
        modal.show();

        fetch('/Usuarios/PerfilPublicoJson?id=' + id)
            .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
            .then(function (d) {
                titulo.textContent = d.nome;
                var estrelas = '';
                if (d.notaMedia) {
                    for (var i = 1; i <= 5; i++) {
                        if (i <= Math.floor(d.notaMedia))       estrelas += '<i class="bi bi-star-fill"></i>';
                        else if (i - d.notaMedia < 1)           estrelas += '<i class="bi bi-star-half"></i>';
                        else                                     estrelas += '<i class="bi bi-star"></i>';
                    }
                }
                var fotoHtml = d.temFoto
                    ? '<img src="' + d.fotoUrl + '" class="rounded-circle object-fit-cover flex-shrink-0" style="width:72px;height:72px;" alt="" />'
                    : '<div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-success fs-4" style="width:72px;height:72px;">' + d.iniciais + '</div>';
                var verificadoHtml = d.verificado
                    ? '<span class="badge rounded-pill text-success bg-success bg-opacity-10"><i class="bi bi-patch-check-fill me-1"></i>Verificado</span>' : '';
                var bioHtml = (d.bio && d.bio.trim())
                    ? '<p class="mt-2 mb-0 text-secondary" style="font-size:14px;line-height:1.6;">' + d.bio + '</p>'
                    : '<p class="mt-2 mb-0 text-muted fst-italic" style="font-size:14px;">Sem bio cadastrada.</p>';
                var avaliacaoHtml = (d.notaMedia && d.totalAvaliacoes > 0)
                    ? '<hr class="my-3"/><div class="row g-2 text-center"><div class="col"><div class="bg-light rounded-3 p-2"><div class="text-muted small">Nota média</div><div class="fw-bold fs-5">' + d.notaMedia.toFixed(1) + '</div><div class="text-warning small">' + estrelas + '</div></div></div><div class="col"><div class="bg-light rounded-3 p-2"><div class="text-muted small">Avaliações</div><div class="fw-bold fs-5">' + d.totalAvaliacoes + '</div><div class="text-muted small">recebidas</div></div></div></div>'
                    : '<hr class="my-3"/><div class="border rounded-3 p-3 text-center text-muted small"><i class="bi bi-star me-1"></i>Ainda sem avaliações.</div>';
                conteudo.innerHTML =
                    '<div class="d-flex gap-3 align-items-start">' + fotoHtml +
                    '<div class="flex-grow-1"><div class="d-flex flex-wrap align-items-center gap-2 mb-1">' + verificadoHtml +
                    '<span class="badge rounded-pill text-secondary bg-secondary bg-opacity-10">' + d.tipoLabel + '</span></div>' +
                    '<p class="text-muted small mb-0"><i class="bi bi-calendar3 me-1"></i>Membro desde ' + d.membroDesde + '</p>' +
                    bioHtml + '</div></div>' + avaliacaoHtml;
            })
            .catch(function () {
                conteudo.innerHTML = '<div class="text-center text-muted py-3"><i class="bi bi-exclamation-circle me-2"></i>Não foi possível carregar o perfil.</div>';
            });
    }

    // ── Aprovar / Rejeitar mutuamente exclusivos ──────────────────────
    document.querySelectorAll('[id^="aprovar-"]').forEach(function (el) {
        el.addEventListener('show.bs.collapse', function () {
            var sufixo = this.id.replace('aprovar-', '');
            var outro = document.getElementById('rejeitar-' + sufixo);
            if (outro && outro.classList.contains('show')) {
                bootstrap.Collapse.getOrCreateInstance(outro).hide();
            }
        });
    });
    document.querySelectorAll('[id^="rejeitar-"]').forEach(function (el) {
        el.addEventListener('show.bs.collapse', function () {
            var sufixo = this.id.replace('rejeitar-', '');
            var outro = document.getElementById('aprovar-' + sufixo);
            if (outro && outro.classList.contains('show')) {
                bootstrap.Collapse.getOrCreateInstance(outro).hide();
            }
        });
    });

    // ── Marcar / desmarcar checkboxes de rejeição ─────────────────────
    function toggleTodos(grupoId, marcar) {
        document.querySelectorAll('.chk-rejeitar-' + grupoId).forEach(function (chk) {
            chk.checked = marcar;
        });
    }

    // ── Pular avaliação (localStorage por pedido) ─────────────────────
    var SKIP_PREFIX = 'doalim_skip_aval_doador_pedido_';

    document.querySelectorAll('.btn-pular-avaliacao').forEach(function (btn) {
        var idPedido = btn.dataset.pedido;
        if (localStorage.getItem(SKIP_PREFIX + idPedido) === '1') {
            var card = document.getElementById(btn.dataset.alvo);
            if (card) card.style.display = 'none';
        }
    });

    document.querySelectorAll('.btn-pular-avaliacao').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var idPedido = btn.dataset.pedido;
            localStorage.setItem(SKIP_PREFIX + idPedido, '1');
            var card = document.getElementById(btn.dataset.alvo);
            if (card) card.style.display = 'none';
        });
    });

    // ── Interatividade das estrelas ───────────────────────────────────
    var formAvaliacaoPendente = null;

    document.querySelectorAll('.star-group').forEach(function (group) {
        var form      = group.closest('form');
        var notaInput = form.querySelector('.nota-input');
        var submitBtn = form.querySelector('.submit-btn');
        var stars     = Array.from(group.querySelectorAll('.btn-star'));

        function pintarEstrelas(ate) {
            stars.forEach(function (s, i) {
                var icon = s.querySelector('i');
                if (i < ate) {
                    icon.className = 'bi bi-star-fill';
                    s.classList.add('text-warning');
                    s.classList.remove('text-secondary');
                } else {
                    icon.className = 'bi bi-star';
                    s.classList.remove('text-warning');
                    s.classList.add('text-secondary');
                }
            });
        }

        stars.forEach(function (star) {
            star.addEventListener('mouseenter', function () { pintarEstrelas(parseInt(star.dataset.nota)); });
            star.addEventListener('mouseleave', function () { pintarEstrelas(parseInt(notaInput.value) || 0); });
            star.addEventListener('click', function () {
                var nota = parseInt(star.dataset.nota);
                notaInput.value = nota;
                submitBtn.disabled = false;
                pintarEstrelas(nota);
            });
        });

        submitBtn.addEventListener('click', function () {
            formAvaliacaoPendente = form;
            document.getElementById('textoNotaModal').textContent = notaInput.value;
        });
    });

    var btnConfirmar = document.getElementById('btnConfirmarAvaliacao');
    if (btnConfirmar) {
        btnConfirmar.addEventListener('click', function () {
            var modal = bootstrap.Modal.getInstance(document.getElementById('modalConfirmarAvaliacao'));
            if (modal) modal.hide();
            if (formAvaliacaoPendente) formAvaliacaoPendente.submit();
        });
    }
</script>
}
